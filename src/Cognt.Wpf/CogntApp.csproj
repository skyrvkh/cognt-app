<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>CogntApp</AssemblyName>
    <RootNamespace>CogntApp</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <BaseOutputPath>..\..\bin\</BaseOutputPath>
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="EditorHost\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="ViewModels\MainViewModel.Documents.cs" />
    <Page Remove="EditorHost\**\*.xaml" />
    <Page Remove="bin\**\*.xaml" />
    <Page Remove="obj\**\*.xaml" />
    <ApplicationDefinition Remove="EditorHost\**\*.xaml" />
    <ApplicationDefinition Remove="bin\**\*.xaml" />
    <ApplicationDefinition Remove="obj\**\*.xaml" />
    <Resource Remove="EditorHost\**\*" />
    <Resource Remove="bin\**\*" />
    <Resource Remove="obj\**\*" />
    <Content Remove="EditorHost\**\*" />
    <Content Remove="bin\**\*" />
    <Content Remove="obj\**\*" />
    <None Remove="EditorHost\**\*" />
    <None Remove="bin\**\*" />
    <None Remove="obj\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="149.0.60" />
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.0-preview.86" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.Arc" Version="5.0.0-preview.86" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="PdfPig.Rendering.Skia" Version="0.1.15.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\icon.ico" />
    <None Remove="Assets\icon.png" />
    <Page Remove="App.xaml" />
    <ApplicationDefinition Include="App.xaml" />
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="EditorHost\EditorWeb\src\fonts\*.ttf">
      <Link>Assets\Fonts\%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cognt.Composition\Cognt.Composition.csproj" />
    <ProjectReference Include="EditorHost\Cognt.Wpf.EditorHost.csproj" />
    <ProjectReference Include="..\Modules\PersonalKnowledgeManagement\Cognt.Modules.PersonalKnowledgeManagement.Application\Cognt.Modules.PersonalKnowledgeManagement.Application.csproj" />
    <ProjectReference Include="..\Modules\ProgressTrackingAndAnalytics\Cognt.Modules.ProgressTrackingAndAnalytics.Application\Cognt.Modules.ProgressTrackingAndAnalytics.Application.csproj" />
    <ProjectReference Include="..\Modules\SpacedRepetitionSystem\Cognt.Modules.SpacedRepetitionSystem.Application\Cognt.Modules.SpacedRepetitionSystem.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EditorHostWebBuildInput Include="$(MSBuildProjectDirectory)\EditorHost\Cognt.Wpf.EditorHost.csproj" />
    <EditorHostWebBuildInput Include="$(MSBuildProjectDirectory)\EditorHost\EditorWeb\package.json" />
    <EditorHostWebBuildInput Include="$(MSBuildProjectDirectory)\EditorHost\EditorWeb\tsconfig.json" />
    <EditorHostWebBuildInput Include="$(MSBuildProjectDirectory)\EditorHost\EditorWeb\vite.config.js" />
    <EditorHostWebBuildInput Include="$(MSBuildProjectDirectory)\EditorHost\EditorWeb\build.mjs" />
    <EditorHostWebBuildInput Include="$(MSBuildProjectDirectory)\EditorHost\EditorWeb\src\**\*" />
  </ItemGroup>

  <Target Name="EnsureEditorHostWebDist"
          BeforeTargets="CopyEditorHostWebOutput;CopyEditorHostWebOutputToPublish"
          Inputs="@(EditorHostWebBuildInput)"
          Outputs="$(MSBuildProjectDirectory)\EditorHost\obj\EditorWebBuild\dist\assets\blazor-blocksuite.js">
    <MSBuild Projects="$(MSBuildProjectDirectory)\EditorHost\Cognt.Wpf.EditorHost.csproj"
             Targets="BuildEditorWeb"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=net10.0-windows10.0.17763.0" />
  </Target>

  <Target Name="CopyEditorHostWebOutput"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\EditorHost\obj\EditorWebBuild\dist\assets\blazor-blocksuite.js')">
    <ItemGroup>
      <EditorHostStaticOutput Include="$(MSBuildProjectDirectory)\EditorHost\wwwroot\**\*" />
      <EditorHostWebOutput Include="$(MSBuildProjectDirectory)\EditorHost\obj\EditorWebBuild\dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)wwwroot\editorweb"
               Condition="Exists('$(TargetDir)wwwroot\editorweb')" />
    <Copy SourceFiles="@(EditorHostStaticOutput)"
          DestinationFiles="@(EditorHostStaticOutput->'$(TargetDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EditorHostWebOutput)"
          DestinationFiles="@(EditorHostWebOutput->'$(TargetDir)wwwroot\editorweb\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyEditorHostWebOutputToPublish"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' And Exists('$(MSBuildProjectDirectory)\EditorHost\obj\EditorWebBuild\dist\assets\blazor-blocksuite.js')">
    <ItemGroup>
      <EditorHostStaticPublishOutput Include="$(MSBuildProjectDirectory)\EditorHost\wwwroot\**\*" />
      <EditorHostWebPublishOutput Include="$(MSBuildProjectDirectory)\EditorHost\obj\EditorWebBuild\dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)wwwroot\editorweb"
               Condition="Exists('$(PublishDir)wwwroot\editorweb')" />
    <Copy SourceFiles="@(EditorHostStaticPublishOutput)"
          DestinationFiles="@(EditorHostStaticPublishOutput->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EditorHostWebPublishOutput)"
          DestinationFiles="@(EditorHostWebPublishOutput->'$(PublishDir)wwwroot\editorweb\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemoveStaticWebAssetsRuntimeManifests"
          AfterTargets="Build;Publish">
    <ItemGroup>
      <StaticWebAssetsRuntimeManifest Include="$(TargetDir)*.staticwebassets.runtime.json" />
      <StaticWebAssetsRuntimeManifest Include="$(PublishDir)*.staticwebassets.runtime.json"
                                      Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(StaticWebAssetsRuntimeManifest)" />
  </Target>

  <Target Name="RemoveNonRuntimeBuildOutput"
          AfterTargets="Build">
    <ItemGroup>
      <NonRuntimeBuildOutputFile Include="$(TargetDir)*.pdb" />
      <NonRuntimeBuildOutputFile Include="$(TargetDir)*.xml" />
      <NonRuntimeBuildOutputFile Include="$(TargetDir)NuGet.Config" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)EditorWeb" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)ca-ES" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)cs-CZ" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)de" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)es" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)fr" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)hu" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)it" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)ja" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)ko" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)nl-BE" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)pl" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)pt" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)ro" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)ru" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)sv" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)zh-Hans" />
      <NonRuntimeBuildOutputDirectory Include="$(TargetDir)zh-Hant" />
    </ItemGroup>
    <Delete Files="@(NonRuntimeBuildOutputFile)" />
    <RemoveDir Directories="@(NonRuntimeBuildOutputDirectory)"
               Condition="Exists('%(NonRuntimeBuildOutputDirectory.Identity)')" />
  </Target>

</Project>
