<Window x:Class="CogntApp.Shell.DocumentImport.DocumentImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:documentImport="clr-namespace:CogntApp.Shell.DocumentImport"
        Title="Import Documents"
        Width="720"
        Height="460"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DocumentImportButtonStyle" TargetType="Button">
            <Style.Resources>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ButtonTemplateTextForegroundStyle}" />
                        <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource ButtonTemplateAccessTextForegroundStyle}" />
            </Style.Resources>
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Border.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ButtonTemplateTextForegroundStyle}" />
                                <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource ButtonTemplateAccessTextForegroundStyle}" />
                            </Border.Resources>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NoteFillBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryDocumentImportButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DocumentImportButtonStyle}">
            <Style.Resources>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource VibrantButtonTemplateTextForegroundStyle}" />
                        <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource VibrantButtonTemplateAccessTextForegroundStyle}" />
            </Style.Resources>
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VibrantButtonForegroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource VibrantButtonForegroundBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource VibrantButtonForegroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource VibrantButtonForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource VibrantButtonForegroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource VibrantButtonForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource DisabledLineBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledLineBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RemoveFileButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DocumentImportButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PdfFillBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerLineBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormatChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource NoteFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource NoteFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Importing}">
                    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessLineBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Failed}">
                    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerLineBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Importing}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Failed}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="DropZone"
                Padding="18"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="13"
                AllowDrop="True"
                Focusable="True"
                AutomationProperties.Name="Document import drop zone"
                KeyDown="DropZone_KeyDown"
                MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
            <Grid>
                <StackPanel MaxWidth="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoFiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Import documents DOCX, PDF, and MD"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="Import DOCX, PDF, or MD files only. DOCX and MD become editable notes; PDFs stay readable in the PDF viewer."
                               Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               Foreground="{DynamicResource MutedBrush}" />

                    <Button Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Import files"
                            Click="AddFilesButton_Click"
                            Style="{StaticResource PrimaryDocumentImportButtonStyle}">
                        <TextBlock Text="Import files"
                                    />
                    </Button>
                </StackPanel>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="13"
                            Background="{DynamicResource PanelAltBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding QueueSummary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Ready files will be converted or imported into the current collection."
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Import files"
                                    AutomationProperties.Name="Import files"
                                    Click="AddFilesButton_Click"
                                    Style="{StaticResource DocumentImportButtonStyle}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Message}"
                               Margin="2,10,2,8"
                               TextWrapping="Wrap"
                               FontSize="12"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMessageError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Row="2"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <ListBox Margin="10"
                                 ItemsSource="{Binding Files}"
                                 Style="{StaticResource AppVirtualizedListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource LineSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="38"
                                                        Height="38"
                                                        CornerRadius="10"
                                                        Background="{DynamicResource NoteFillBrush}"
                                                        BorderBrush="{DynamicResource ControlBorderHoverBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding TypeLabel}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentStrongBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,12,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{DynamicResource InkBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ImportModeLabel}"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="12" />
                                                    <TextBlock Text="{Binding ErrorMessage}"
                                                               Margin="0,5,0,0"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileSizeLabel}"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="12" />
                                                    <Border Style="{StaticResource StatusBadgeStyle}">
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   Style="{StaticResource StatusTextStyle}" />
                                                    </Border>
                                                </StackPanel>

                                                <Button Grid.Column="3"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Remove file from import queue"
                                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource RemoveFileButtonStyle}">
                                                    <Path Data="M5,5 L13,13 M13,5 L5,13"
                                                          Width="12"
                                                          Height="12"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource DocumentImportButtonStyle}" />
                <Button Grid.Column="3"
                        Command="{Binding ImportCommand}"
                        IsDefault="True"
                        AutomationProperties.Name="Import"
                        Style="{StaticResource PrimaryDocumentImportButtonStyle}">
                    <TextBlock Text="{Binding ImportButtonText}"
                                />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
