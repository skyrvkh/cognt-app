<Window x:Class="CogntApp.Shell.DocumentImport.DocumentImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:documentImport="clr-namespace:CogntApp.Shell.DocumentImport"
        Title="Import Documents"
        Width="920"
        Height="620"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FormatChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="BorderBrush" Value="#C7D7FE" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DocumentImportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D9E1EE" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#22304A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFF" />
                    <Setter Property="BorderBrush" Value="#AFC0F8" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EEF4FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F0F3F8" />
                    <Setter Property="Foreground" Value="#98A2B3" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryDocumentImportButtonStyle" TargetType="Button" BasedOn="{StaticResource DocumentImportButtonStyle}">
            <Setter Property="Background" Value="#4254E8" />
            <Setter Property="BorderBrush" Value="#4254E8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3442C9" />
                    <Setter Property="BorderBrush" Value="#3442C9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2F3AB0" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9E1EE" />
                    <Setter Property="BorderBrush" Value="#D9E1EE" />
                    <Setter Property="Foreground" Value="#667085" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="BorderBrush" Value="#C7D7FE" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Importing}">
                    <Setter Property="Background" Value="#FFF7ED" />
                    <Setter Property="BorderBrush" Value="#FED7AA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Success}">
                    <Setter Property="Background" Value="#ECFDF3" />
                    <Setter Property="BorderBrush" Value="#ABEFC6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Failed}">
                    <Setter Property="Background" Value="#FEF3F2" />
                    <Setter Property="BorderBrush" Value="#FECDCA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3156D4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Importing}">
                    <Setter Property="Foreground" Value="#B54708" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Success}">
                    <Setter Property="Foreground" Value="#067647" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static documentImport:DocumentImportStatus.Failed}">
                    <Setter Property="Foreground" Value="#B42318" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Import Documents"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#1F2433" />
                <TextBlock Text="Bring Markdown files into this workspace."
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="#667085" />
            </StackPanel>

            <Button Grid.Column="1"
                    Width="34"
                    Height="34"
                    Content="x"
                    AutomationProperties.Name="Close import documents"
                    Click="CloseButton_Click"
                    Style="{StaticResource DocumentImportButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,22,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="DropZone"
                        Padding="24"
                        MinHeight="188"
                        Background="#FFFFFF"
                        BorderBrush="#C7D7FE"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        AllowDrop="True"
                        Focusable="True"
                        AutomationProperties.Name="Document import drop zone"
                        KeyDown="DropZone_KeyDown"
                        MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="470">
                            <TextBlock Text="Import documents"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2433" />
                            <TextBlock Text="Drop Markdown files here"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="15"
                                       Foreground="#22304A" />
                            <TextBlock Text="Markdown files will be converted into editable native documents."
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       FontSize="13"
                                       Foreground="#667085" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,18">
                                <Border Style="{StaticResource FormatChipStyle}">
                                    <TextBlock Text="MD" Foreground="#3156D4" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                            </StackPanel>
                            <Button Content="Add files"
                                    AutomationProperties.Name="Add files"
                                    Click="AddFilesButton_Click"
                                    Style="{StaticResource DocumentImportButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="#FFFFFF"
                        BorderBrush="#E4E9F2"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding QueueSummary}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2433" />
                            <Button Grid.Column="1"
                                    Content="Add files"
                                    AutomationProperties.Name="Add more files"
                                    Click="AddFilesButton_Click"
                                    Style="{StaticResource DocumentImportButtonStyle}" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Message}"
                                   Margin="0,10,0,10"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#475467" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMessageError}" Value="True">
                                            <Setter Property="Foreground" Value="#B42318" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Grid.Row="2">
                            <TextBlock Text="Added files will appear here before import."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#98A2B3"
                                       FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoFiles}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                    Padding="12"
                                                    Background="#FBFCFF"
                                                    BorderBrush="#E4E9F2"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="42"
                                                            Height="42"
                                                            CornerRadius="8"
                                                            Background="#EEF4FF"
                                                            BorderBrush="#C7D7FE"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding TypeLabel}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#3156D4"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="12,0,14,0">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   Foreground="#1F2433"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ImportModeLabel}"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="#667085"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding ErrorMessage}"
                                                                   Margin="0,5,0,0"
                                                                   Foreground="#B42318"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileSizeLabel}"
                                                                   Margin="0,0,12,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#667085"
                                                                   FontSize="12" />
                                                        <Border Style="{StaticResource StatusBadgeStyle}">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       Style="{StaticResource StatusTextStyle}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <Button Grid.Column="3"
                                                            Content="Remove"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="Remove file from import queue"
                                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DocumentImportButtonStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="#FFFFFF"
                    BorderBrush="#E4E9F2"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Import settings"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#1F2433" />

                    <TextBlock Text="Destination"
                               Margin="0,22,0,8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#667085" />
                    <Border Padding="12"
                            CornerRadius="8"
                            Background="#F8FAFC"
                            BorderBrush="#E4E9F2"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding DestinationLabel}"
                                       Foreground="#1F2433"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Documents are imported into the workspace."
                                       Margin="0,5,0,0"
                                       Foreground="#667085"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Naming"
                               Margin="0,22,0,8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#667085" />
                    <TextBlock Text="Creates one document per file. Document titles come from file names, and duplicate stored names follow existing workspace conventions."
                               Foreground="#475467"
                               FontSize="13"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Conversion"
                               Margin="0,22,0,8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#667085" />
                    <TextBlock Text="Markdown files become native BlockSuite documents."
                               Foreground="#475467"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,12,0,0">
                        <CheckBox Content="Open imported document after import"
                                  IsChecked="{Binding OpenImportedDocumentAfterImport, Mode=TwoWay}"
                                  Foreground="#22304A"
                                  FontSize="13" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Supported formats: MD, Markdown"
                       VerticalAlignment="Center"
                       Foreground="#667085"
                       FontSize="12" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource DocumentImportButtonStyle}" />
            <Button Grid.Column="3"
                    Content="{Binding ImportButtonText}"
                    Command="{Binding ImportCommand}"
                    IsDefault="True"
                    AutomationProperties.Name="Import"
                    Style="{StaticResource PrimaryDocumentImportButtonStyle}" />
        </Grid>
    </Grid>
</Window>
