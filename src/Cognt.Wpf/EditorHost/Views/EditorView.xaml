<UserControl x:Class="Cognt.Wpf.EditorHost.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="650">
    <Grid>
        <Border x:Name="EditorWebViewFrame"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                Background="#FFFFFF">
            <blazor:BlazorWebView x:Name="BlockSuiteHostView"
                                  Focusable="True"
                                  HostPage="wwwroot\index.html" />
        </Border>

        <Border x:Name="EditorStateOverlay"
                Background="#FFFFFF"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <StackPanel MaxWidth="420"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="EditorStateTitleText"
                               Text="No note selected"
                               TextAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#142033" />
                    <TextBlock x:Name="EditorStateMessageText"
                               Text="Select a note to view it here."
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#667085" />
                    <Button x:Name="EditorRetryButton"
                            Content="Retry"
                            Width="88"
                            Height="34"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="EditorRetryButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
