<UserControl x:Class="CogntApp.Views.PdfReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#F8FAFF">
    <Grid>
        <wv2:WebView2 x:Name="PdfWebView"
                      Visibility="Collapsed"
                      NavigationCompleted="PdfWebView_NavigationCompleted" />

        <Border x:Name="StatePanel"
                MaxWidth="520"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#DDE3F0"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock x:Name="StateTitleText"
                           Text="No PDF selected"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#15192C"
                           TextAlignment="Center" />
                <TextBlock x:Name="StateMessageText"
                           Margin="0,10,0,0"
                           Text="Import or select a PDF source from the sidebar."
                           FontSize="11"
                           Foreground="#707895"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
