<UserControl x:Class="CogntApp.Views.PdfReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CogntApp.Views"
             Background="{DynamicResource PanelAltBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:PdfReaderToolbar x:Name="StudyToolbar" Grid.Row="0" />

        <ScrollViewer x:Name="PageScrollViewer"
                      Grid.Row="1"
                      Padding="18"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <Grid x:Name="PageHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top" />
        </ScrollViewer>

        <Border x:Name="StatePanel"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                MaxWidth="520"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="StateTitleText"
                           Text="No PDF selected"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"
                           TextAlignment="Center" />
                <TextBlock x:Name="StateMessageText"
                           Margin="0,10,0,0"
                           Text="Import or select a PDF source from the sidebar."
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
