<UserControl x:Class="CogntApp.Views.PdfReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelAltBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8,6"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="PdfTitleText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"
                               Text="PDF Reader"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PdfStatusText"
                               Margin="0,2,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource DimBrush}"
                               Text="No PDF selected"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton"
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Content="-"
                            FontSize="15"
                            ToolTip="Zoom out"
                            AutomationProperties.Name="Zoom out"
                            Click="ZoomOutButton_Click" />
                    <TextBlock x:Name="ZoomText"
                               MinWidth="42"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="100%"
                               TextAlignment="Center" />
                    <Button x:Name="ZoomInButton"
                            Width="28"
                            Height="28"
                            Margin="4,0,0,0"
                            Content="+"
                            FontSize="15"
                            ToolTip="Zoom in"
                            AutomationProperties.Name="Zoom in"
                            Click="ZoomInButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="PageScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <StackPanel x:Name="PageHost"
                        Margin="16"
                        HorizontalAlignment="Center" />
        </ScrollViewer>

        <Border x:Name="StatePanel"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                MaxWidth="520"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="StateTitleText"
                           Text="No PDF selected"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"
                           TextAlignment="Center" />
                <TextBlock x:Name="StateMessageText"
                           Margin="0,10,0,0"
                           Text="Import or select a PDF source from the sidebar."
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
