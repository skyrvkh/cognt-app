<UserControl x:Class="CogntApp.Views.BrowserPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#F8FAFF">
    <UserControl.Resources>
        <Style x:Key="BrowserAddressTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderBrush" Value="#D9E1F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2433" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock Margin="10,0"
                                           VerticalAlignment="Center"
                                           Foreground="#8B93A8"
                                           IsHitTestVisible="False"
                                           Text="{TemplateBinding Tag}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10"
                Background="#FFFFFF"
                BorderBrush="#E1E6F0"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="AddressTextBox"
                         Style="{StaticResource BrowserAddressTextBoxStyle}"
                         Tag="Search or enter address"
                         ToolTip="Search or enter address"
                         KeyDown="AddressTextBox_KeyDown" />
                <Button Grid.Column="2"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Background="#FFFFFF"
                        BorderBrush="#D9E1F0"
                        BorderThickness="1"
                        ToolTip="Open"
                        AutomationProperties.Name="Open address"
                        Click="GoButton_Click">
                    <Path Width="14"
                          Height="14"
                          Data="M4,3 L11,9 L4,15"
                          Stretch="Uniform"
                          Stroke="#3156D4"
                          StrokeThickness="1.9"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="BrowserWebView"
                          Visibility="Collapsed"
                          NavigationCompleted="BrowserWebView_NavigationCompleted" />

            <Border x:Name="StatePanel"
                    MaxWidth="360"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#DDE3F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock x:Name="StateTitleText"
                               Text="Browser"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#15192C"
                               TextAlignment="Center" />
                    <TextBlock x:Name="StateMessageText"
                               Margin="0,9,0,0"
                               Text="Enter a web address or search term."
                               FontSize="11"
                               Foreground="#707895"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
