<UserControl x:Class="CogntApp.Views.BrowserPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelAltBrush}">
    <UserControl.Resources>
        <Style x:Key="BrowserIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowserAddressTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}" />
                                <TextBlock Margin="10,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource DimBrush}"
                                           IsHitTestVisible="False"
                                           Text="Search or enter address">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="7,5,7,6"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabsPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                    <Button x:Name="NewTabButton"
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            Style="{StaticResource BrowserIconButtonStyle}"
                            ToolTip="New tab"
                            AutomationProperties.Name="New tab"
                            Click="NewTabButton_Click">
                        <Path Width="12" Height="12"
                              Data="M10,3 L10,17 M3,10 L17,10"
                              Stretch="Uniform"
                              Stroke="{DynamicResource AccentStrongBrush}"
                              StrokeThickness="1.9"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BackButton"
                                Style="{StaticResource BrowserIconButtonStyle}"
                                ToolTip="Back"
                                Click="BackButton_Click">
                            <Path Width="12" Height="12" Data="M12,3 L5,10 L12,17"
                                  Stretch="Uniform" Stroke="{DynamicResource InkBrush}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="ForwardButton"
                                Style="{StaticResource BrowserIconButtonStyle}"
                                ToolTip="Forward"
                                Click="ForwardButton_Click">
                            <Path Width="12" Height="12" Data="M6,3 L13,10 L6,17"
                                  Stretch="Uniform" Stroke="{DynamicResource InkBrush}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="ReloadButton"
                                Style="{StaticResource BrowserIconButtonStyle}"
                                ToolTip="Reload"
                                Click="ReloadButton_Click">
                            <Path Width="14" Height="14"
                                  Data="M14,5 L14,9 L18,9 M14,9 C12.8,6.4 9.8,5.2 7.1,6.3 C3.9,7.7 2.5,11.3 3.9,14.4 C5.2,17.5 8.8,18.9 11.9,17.6 C14,16.8 15.4,15.1 16,13"
                                  Stretch="Uniform" Stroke="{DynamicResource InkBrush}"
                                  StrokeThickness="1.7" StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="StopButton"
                                Style="{StaticResource BrowserIconButtonStyle}"
                                ToolTip="Stop loading"
                                Visibility="Collapsed"
                                Click="StopButton_Click">
                            <Path Width="11" Height="11" Data="M4,4 L16,16 M16,4 L4,16"
                                  Stretch="Uniform" Stroke="{DynamicResource InkBrush}"
                                  StrokeThickness="1.9" StrokeStartLineCap="Round" />
                        </Button>
                    </StackPanel>

                    <TextBox x:Name="AddressTextBox"
                             Grid.Column="1"
                             Margin="4,0"
                             Style="{StaticResource BrowserAddressTextBoxStyle}"
                             ToolTip="Search or enter address"
                             KeyDown="AddressTextBox_KeyDown" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BookmarkButton"
                                Style="{StaticResource BrowserIconButtonStyle}"
                                ToolTip="Bookmark current page"
                                Click="BookmarkButton_Click">
                            <Path x:Name="BookmarkGlyph" Width="14" Height="14"
                                  Data="M10,2.8 L12.2,7.2 L17.1,7.9 L13.5,11.3 L14.4,16.1 L10,13.8 L5.6,16.1 L6.5,11.3 L2.9,7.9 L7.8,7.2 Z"
                                  Stretch="Uniform" Fill="Transparent"
                                  Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" />
                        </Button>
                        <Button x:Name="BrowserMenuButton"
                                Style="{StaticResource BrowserIconButtonStyle}"
                                ToolTip="Browser menu"
                                Click="BrowserMenuButton_Click">
                            <Path Width="15" Height="15"
                                  Data="M5,10 A1,1 0,1 1 5.1,10 M10,10 A1,1 0,1 1 10.1,10 M15,10 A1,1 0,1 1 15.1,10"
                                  Stretch="Uniform" Fill="{DynamicResource InkBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="BrowserStatusText"
                           Grid.Row="2"
                           Margin="4,4,4,0"
                           FontSize="10"
                           Foreground="{DynamicResource DimBrush}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid x:Name="BrowserHostGrid" Grid.Row="1">
            <Border x:Name="StatePanel"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent">
                <StackPanel MaxWidth="360">
                    <TextBlock x:Name="StateTitleText"
                               Text="Browser"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"
                               TextAlignment="Center" />
                    <TextBlock x:Name="StateMessageText"
                               Margin="0,8,0,0"
                               Text="Enter a web address or search term."
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorBanner"
                    Margin="10"
                    Padding="10,7"
                    VerticalAlignment="Top"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ErrorBannerText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource BrowserIconButtonStyle}"
                            ToolTip="Dismiss"
                            Click="DismissErrorButton_Click">
                        <Path Width="10" Height="10" Data="M4,4 L16,16 M16,4 L4,16"
                              Stretch="Uniform" Stroke="{DynamicResource InkBrush}"
                              StrokeThickness="1.8" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
