<UserControl x:Class="CogntApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1120"
             Background="{DynamicResource PanelAltBrush}">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <Style x:Key="MetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DashboardActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1080"
              Margin="24,32,24,28"
              HorizontalAlignment="Center">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Dashboard"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="Current collection activity."
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Command="{Binding ShowAllNotesCommand}"
                                AutomationProperties.Name="All Notes"
                                Style="{StaticResource DashboardActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14"
                                      Height="14"
                                      Data="M6,5.5 L18,5.5 M6,10.5 L18,10.5 M6,15.5 L14,15.5"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="All Notes"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowGraphCommand}"
                                AutomationProperties.Name="Graph"
                                Style="{StaticResource DashboardActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14"
                                      Height="14"
                                      Data="M4,12 L12,5 L18,17 L4,12 M12,5 L18,17 M4,10 L4,14 M2,12 L6,12 M12,3 L12,7 M10,5 L14,5 M18,15 L18,19 M16,17 L20,17"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <TextBlock Text="Graph"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Study Overview"
                           Margin="0,26,0,10"
                           Style="{StaticResource PanelTitleStyle}" />

                <ItemsControl ItemsSource="{Binding DashboardMetrics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel MinHeight="92">
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="{Binding Value}" Margin="0,10,0,0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MetaTextStyle}" Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding AccentDetail}" Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding DashboardEmptyStates}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,8"
                                    Background="{DynamicResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource PanelTitleStyle}" />
                                    <TextBlock Text="{Binding Message}"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Study Activity" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="Reviews per day from the current collection"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DashboardStudyHeatmapCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="52" Rows="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="10"
                                            Height="10"
                                            Margin="1.5"
                                            CornerRadius="3"
                                            ToolTip="{Binding Tooltip}">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="1">
                                                        <Setter Property="Background" Value="{DynamicResource HeatmapLowBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                                        <Setter Property="Background" Value="{DynamicResource HeatmapMediumBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="3">
                                                        <Setter Property="Background" Value="{DynamicResource HeatmapHighBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="4">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="24,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Less" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                                <Border Width="12" Height="12" Margin="8,0,0,0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,0,0" Background="{DynamicResource HeatmapLowBrush}" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,0,0" Background="{DynamicResource HeatmapMediumBrush}" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,0,0" Background="{DynamicResource HeatmapHighBrush}" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,8,0" Background="{DynamicResource AccentBrush}" CornerRadius="3" />
                                <TextBlock Text="More" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="12"
                        Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Continue Learning" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="Review due cards from the current collection" Margin="0,5,0,0" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recent Notes" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding RecentNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding NotePath}"
                                                HorizontalContentAlignment="Left"
                                                Margin="0,0,0,6"
                                                Style="{StaticResource SmallButtonStyle}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
