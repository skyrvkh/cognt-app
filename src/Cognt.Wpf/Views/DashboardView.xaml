<UserControl x:Class="CogntApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1120"
             Background="#F8FAFF">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#15192C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#707895" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE3F0" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="MetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE2EF" />
            <Setter Property="Foreground" Value="#5967FF" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1080"
              Margin="32,52,32,40"
              HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="Dashboard"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Current collection activity."
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <TextBlock Text="Study Overview"
                           Margin="0,38,0,12"
                           Style="{StaticResource PanelTitleStyle}" />

                <ItemsControl ItemsSource="{Binding DashboardMetrics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                                <StackPanel MinHeight="108">
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#26304D" />
                                    <TextBlock Text="{Binding Value}" Margin="0,14,0,0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MetaTextStyle}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding AccentDetail}" Foreground="#5967FF" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding DashboardEmptyStates}" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,10"
                                    Background="#F8FAFC">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource PanelTitleStyle}" />
                                    <TextBlock Text="{Binding Message}"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,22,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Study Activity" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="Reviews per day from the current collection"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DashboardStudyHeatmapCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="52" Rows="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="10"
                                            Height="10"
                                            Margin="1.5"
                                            CornerRadius="3"
                                            Background="{Binding FillColor}"
                                            ToolTip="{Binding Tooltip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="32,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Less" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                                <Border Width="12" Height="12" Margin="8,0,0,0" Background="#EEF2FF" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,0,0" Background="#DDE5FF" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,0,0" Background="#AEBEFF" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,0,0" Background="#7E92FF" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,8,0" Background="#5967FF" CornerRadius="3" />
                                <TextBlock Text="More" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,22,0,0"
                        Padding="16"
                        Background="#F3F4FF"
                        BorderBrush="#DDE0FF"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Continue Learning" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="Review due cards from the current collection" Margin="0,7,0,0" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,22,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recent Notes" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,18" />
                            <ItemsControl ItemsSource="{Binding RecentNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding NotePath}"
                                                HorizontalContentAlignment="Left"
                                                Margin="0,0,0,8"
                                                Style="{StaticResource SmallButtonStyle}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
