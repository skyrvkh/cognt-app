<UserControl x:Class="CogntApp.Views.AllNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CogntApp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1120"
             Background="{DynamicResource PageBrush}">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Padding" Value="10,0,28,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="13"
                                   Foreground="{DynamicResource InkBrush}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <TextBlock Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Width="12"
                                                      Height="12"
                                                      Margin="0,0,10,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Stroke="{DynamicResource DimBrush}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M3,4.5 L6,7.5 L9,4.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SidebarSurfaceBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PanelAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TreeGridExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ExpanderBorder"
                                Width="10"
                                Height="24"
                                Background="Transparent"
                                CornerRadius="4">
                            <Path x:Name="ExpanderGlyph"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M3,8 L6.5,12 L3,16"
                                  Stroke="{DynamicResource DimBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpanderGlyph" Property="Data" Value="M1.5,10 L5,14 L8.5,10" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllNotesTreeNodeIconStyle" TargetType="Path">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource FolderStrokeBrush}" />
            <Setter Property="Fill" Value="{DynamicResource FolderFillBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Data" Value="M2.5,6.8 L8,6.8 L9.8,8.7 L21.5,8.7 L21.5,18.5 L2.5,18.5 Z" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Prefix}" Value="[N]">
                    <Setter Property="Stroke" Value="{DynamicResource AccentStrongBrush}" />
                    <Setter Property="Fill" Value="{DynamicResource NoteFillBrush}" />
                    <Setter Property="Data" Value="M6,3.5 L14,3.5 L18,7.5 L18,20.5 L6,20.5 Z M14,3.5 L14,8 L18,8 M8.8,12 L15.2,12 M8.8,15 L15.2,15" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Prefix}" Value="[PDF]">
                    <Setter Property="Stroke" Value="{DynamicResource PdfStrokeBrush}" />
                    <Setter Property="Fill" Value="{DynamicResource PdfFillBrush}" />
                    <Setter Property="Data" Value="M6,3.5 L14,3.5 L18,7.5 L18,20.5 L6,20.5 Z M14,3.5 L14,8 L18,8 M8.5,12.2 L15.5,12.2 M8.5,15.2 L14,15.2 M8.5,18.2 L12.8,18.2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AllNotesTreeButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AllNotesTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Margin="0,12,0,0"
                                          VerticalAlignment="Top"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Style="{StaticResource TreeGridExpanderStyle}" />

                            <Border x:Name="ItemBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  ContentSource="Header"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,22,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="All Notes"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="{Binding PageSubtitle}"
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Margin="0,0,8,0"
                        Command="{Binding ImportDocumentsCommand}"
                        AutomationProperties.Name="Import"
                        Style="{StaticResource SecondaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16"
                              Height="16"
                              Data="M12,4 L12,15 M7.5,10.5 L12,15 L16.5,10.5 M5,18.5 L19,18.5"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <TextBlock Text="Import"
                                   Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CreateNoteCommand}"
                        AutomationProperties.Name="New note"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16"
                              Height="16"
                              Data="M6,3.5 L14,3.5 L18,7.5 L18,20.5 L6,20.5 Z M14,3.5 L14,8 L18,8 M9,13 L15,13 M12,10 L12,16"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="New note"
                                   Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,12"
                Padding="12"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid MinWidth="260"
                      Margin="0,0,10,0">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search notes"
                             MinHeight="34"
                             Padding="36,6,68,6"
                             BorderBrush="{DynamicResource LineBrush}"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource InkBrush}"
                             FontSize="13"
                             VerticalContentAlignment="Center" />
                    <Path Width="16"
                          Height="16"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{DynamicResource DimBrush}"
                          StrokeThickness="1.8"
                          Data="M10.5,10.5 L15,15 M12,6.5 A5.5,5.5 0 1 1 1,6.5 A5.5,5.5 0 1 1 12,6.5 Z" />
                    <TextBlock Text="Search notes"
                               Margin="36,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleBrush}"
                               FontSize="13"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Padding="6,2"
                            Background="{DynamicResource PanelAltBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="Ctrl K"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1"
                            MaxWidth="680"
                            VerticalAlignment="Center">
                    <WrapPanel>
                        <TextBlock Text="Types"
                                   Margin="0,2,8,0"
                                   Style="{StaticResource TableHeaderTextStyle}" />
                        <ItemsControl ItemsSource="{Binding TypeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="{Binding Label}"
                                              Style="{StaticResource FilterCheckBoxStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock Text="Tags"
                                   Margin="0,2,8,0"
                                   Style="{StaticResource TableHeaderTextStyle}" />
                        <ScrollViewer MaxWidth="380"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TagOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="{Binding Label}"
                                                  Style="{StaticResource FilterCheckBoxStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <ComboBox Width="176"
                                  AutomationProperties.Name="Sort notes"
                                  Style="{StaticResource FilterComboStyle}"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
                        <Button MinWidth="112"
                                Command="{Binding ClearFiltersCommand}"
                                AutomationProperties.Name="Clear filters"
                                Style="{StaticResource FilterActionButtonStyle}">
                            <TextBlock Text="Clear filters" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                    <Grid Margin="14,12,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Documents"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="{Binding ResultsSummary}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12"
                                   Text="{Binding VisibleNotes.Count, Mode=OneWay, StringFormat={}{0} shown}" />
                        <TextBlock Margin="10,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DimBrush}"
                                   FontSize="12"
                                   Text="{Binding ViewModeLabel}" />
                        <Button MinWidth="86"
                                Margin="0,0,6,0"
                                Command="{Binding ShowDataGridViewCommand}"
                                AutomationProperties.Name="Show data grid"
                                Style="{StaticResource FilterActionButtonStyle}">
                            <TextBlock Text="Data grid" />
                        </Button>
                        <Button MinWidth="64"
                                Command="{Binding ShowTreeViewCommand}"
                                AutomationProperties.Name="Show tree"
                                Style="{StaticResource FilterActionButtonStyle}">
                            <TextBlock Text="Tree" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock Text="Loading notes..."
                               FontSize="13"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Margin="14,0,14,14"
                            Padding="12"
                            Background="{DynamicResource DangerSurfaceBrush}"
                            BorderBrush="{DynamicResource DangerLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Margin="14,0,14,14"
                            Padding="18"
                            Background="{DynamicResource SoftSurfaceBrush}"
                            BorderBrush="{DynamicResource SoftLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShouldShowEmptyState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel MaxWidth="420"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding EmptyStateTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyStateMessage}"
                                       Margin="0,6,0,14"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding CreateNoteCommand}"
                                        AutomationProperties.Name="New note"
                                        Style="{StaticResource PrimaryActionButtonStyle}">
                                    <TextBlock Text="New note" />
                                </Button>
                                <Button Command="{Binding ImportDocumentsCommand}"
                                        AutomationProperties.Name="Import"
                                        Style="{StaticResource SecondaryActionButtonStyle}">
                                    <TextBlock Text="Import" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="14,0,14,0"
                          Grid.IsSharedSizeScope="True">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisibleNotes}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="10,0"
                                Height="34"
                                Background="{DynamicResource SidebarSurfaceBrush}"
                                BorderBrush="{DynamicResource SoftLineBrush}"
                                BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" SharedSizeGroup="NameColumn" />
                                    <ColumnDefinition Width="130" SharedSizeGroup="TypeColumn" />
                                    <ColumnDefinition Width="180" SharedSizeGroup="TagsColumn" />
                                    <ColumnDefinition Width="82" SharedSizeGroup="CardsColumn" />
                                    <ColumnDefinition Width="154" SharedSizeGroup="ModifiedColumn" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name / Title"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="Type"
                                           Margin="10,0,0,0"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                                <TextBlock Grid.Column="2"
                                           Text="Tags"
                                           Margin="10,0,0,0"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                                <TextBlock Grid.Column="3"
                                           Text="Cards"
                                           Margin="10,0,0,0"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                                <TextBlock Grid.Column="4"
                                           Text="Modified"
                                           Margin="10,0,0,0"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                            </Grid>
                        </Border>

                        <TreeView Grid.Row="1"
                                  BorderThickness="0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  FontSize="13"
                                  Foreground="{DynamicResource InkBrush}"
                                  ItemsSource="{Binding VisibleTreeNodes}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ItemContainerStyle="{StaticResource AllNotesTreeViewItemStyle}">
                            <TreeView.Style>
                                <Style TargetType="{x:Type TreeView}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTreeViewMode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.Style>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type viewModels:AllNotesTreeItemViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <Grid MinHeight="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" SharedSizeGroup="NameColumn" />
                                            <ColumnDefinition Width="130" SharedSizeGroup="TypeColumn" />
                                            <ColumnDefinition Width="180" SharedSizeGroup="TagsColumn" />
                                            <ColumnDefinition Width="82" SharedSizeGroup="CardsColumn" />
                                            <ColumnDefinition Width="154" SharedSizeGroup="ModifiedColumn" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanOpen}"
                                                AutomationProperties.Name="{Binding Title}"
                                                Style="{StaticResource AllNotesTreeButtonStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Style="{StaticResource AllNotesTreeNodeIconStyle}" />
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{DynamicResource InkBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Title}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   Text="{Binding TypeLabel}"
                                                   Style="{StaticResource TableCellTextStyle}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="10,0,0,0"
                                                   Text="{Binding TagsLabel}"
                                                   ToolTip="{Binding TagsLabel}"
                                                   Style="{StaticResource TableCellTextStyle}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="10,0,0,0"
                                                   Text="{Binding CardCountLabel}"
                                                   Style="{StaticResource TableCellTextStyle}" />
                                        <TextBlock Grid.Column="4"
                                                   Margin="10,0,0,0"
                                                   Text="{Binding ModifiedAtLabel}"
                                                   Style="{StaticResource TableCellTextStyle}" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <DataGrid x:Name="AllNotesDataGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="None"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding VisibleNotes}"
                                  RowHeight="46"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Style>
                                <Style TargetType="{x:Type DataGrid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListViewMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    Style="{StaticResource AllNotesTreeButtonStyle}">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{DynamicResource InkBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="130"
                                                    Binding="{Binding TypeLabel}" />
                                <DataGridTextColumn Width="180"
                                                    Binding="{Binding TagsLabel}" />
                                <DataGridTextColumn Width="82"
                                                    Binding="{Binding CardCountLabel}" />
                                <DataGridTextColumn Width="154"
                                                    Binding="{Binding ModifiedAtLabel}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        Height="1"
                        Background="{DynamicResource SoftLineBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
