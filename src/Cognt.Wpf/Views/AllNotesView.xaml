<UserControl x:Class="CogntApp.Views.AllNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CogntApp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1120"
             Background="#F6F8FC">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#15192C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#8A94A8" />
        <SolidColorBrush x:Key="LineBrush" Color="#DCE3F0" />
        <SolidColorBrush x:Key="SoftLineBrush" Color="#E8EDF6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3156D4" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2446B8" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#F8FAFF" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#93A5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F5FF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD6FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#93A5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="Padding" Value="12,0,34,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="13"
                                   Foreground="{StaticResource InkBrush}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <TextBlock Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Width="12"
                                                      Height="12"
                                                      Margin="0,0,12,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Stroke="#6F7890"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M3,4.5 L6,7.5 L9,4.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#B8C5E6" />
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FBFCFF" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#9FB0FF" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#93A5FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,6,0,0"
                                        Padding="4"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B8C5E6" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#93A5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#596275" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TreeGridExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ExpanderBorder"
                                Width="10"
                                Height="24"
                                Background="Transparent"
                                CornerRadius="4">
                            <Path x:Name="ExpanderGlyph"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M3,8 L6.5,12 L3,16"
                                  Stroke="#6F7890"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpanderGlyph" Property="Data" Value="M1.5,10 L5,14 L8.5,10" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderBorder" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllNotesTreeNodeIconStyle" TargetType="Path">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#B7791F" />
            <Setter Property="Fill" Value="#FFF2B8" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Data" Value="M2.5,6.8 L8,6.8 L9.8,8.7 L21.5,8.7 L21.5,18.5 L2.5,18.5 Z" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Prefix}" Value="[N]">
                    <Setter Property="Stroke" Value="#3156D4" />
                    <Setter Property="Fill" Value="#EEF4FF" />
                    <Setter Property="Data" Value="M6,3.5 L14,3.5 L18,7.5 L18,20.5 L6,20.5 Z M14,3.5 L14,8 L18,8 M8.8,12 L15.2,12 M8.8,15 L15.2,15" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Prefix}" Value="[PDF]">
                    <Setter Property="Stroke" Value="#EF4444" />
                    <Setter Property="Fill" Value="#FFF1F2" />
                    <Setter Property="Data" Value="M6,3.5 L14,3.5 L18,7.5 L18,20.5 L6,20.5 Z M14,3.5 L14,8 L18,8 M8.5,12.2 L15.5,12.2 M8.5,15.2 L14,15.2 M8.5,18.2 L12.8,18.2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AllNotesTreeButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AllNotesTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Margin="0,12,0,0"
                                          VerticalAlignment="Top"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Style="{StaticResource TreeGridExpanderStyle}" />

                            <Border x:Name="ItemBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  ContentSource="Header"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F5F7FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CBD6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="All Notes"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding PageSubtitle}"
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Margin="0,0,10,0"
                        Command="{Binding ImportDocumentsCommand}"
                        AutomationProperties.Name="Import"
                        Style="{StaticResource SecondaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16"
                              Height="16"
                              Data="M12,4 L12,15 M7.5,10.5 L12,15 L16.5,10.5 M5,18.5 L19,18.5"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <TextBlock Text="Import"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CreateNoteCommand}"
                        AutomationProperties.Name="New note"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16"
                              Height="16"
                              Data="M6,3.5 L14,3.5 L18,7.5 L18,20.5 L6,20.5 Z M14,3.5 L14,8 L18,8 M9,13 L15,13 M12,10 L12,16"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="New note"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,24,0,16"
                Padding="16"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid MinWidth="260"
                      Margin="0,0,14,0">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search notes"
                             MinHeight="38"
                             Padding="40,8,74,8"
                             BorderBrush="{StaticResource LineBrush}"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource InkBrush}"
                             FontSize="13"
                             VerticalContentAlignment="Center" />
                    <Path Width="16"
                          Height="16"
                          Margin="14,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="#6F7890"
                          StrokeThickness="1.8"
                          Data="M10.5,10.5 L15,15 M12,6.5 A5.5,5.5 0 1 1 1,6.5 A5.5,5.5 0 1 1 12,6.5 Z" />
                    <TextBlock Text="Search notes"
                               Margin="40,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleBrush}"
                               FontSize="13"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Padding="7,3"
                            Background="#F4F6FA"
                            BorderBrush="#E1E7F2"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="Ctrl K"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Border>
                </Grid>

                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Center">
                    <ComboBox Width="150"
                              AutomationProperties.Name="Type filter"
                              Style="{StaticResource FilterComboStyle}"
                              ItemsSource="{Binding TypeOptions}"
                              SelectedItem="{Binding SelectedTypeOption, Mode=TwoWay}" />
                    <ComboBox Width="150"
                              AutomationProperties.Name="Tag filter"
                              Style="{StaticResource FilterComboStyle}"
                              ItemsSource="{Binding TagOptions}"
                              SelectedItem="{Binding SelectedTagOption, Mode=TwoWay}" />
                    <ComboBox Width="176"
                              AutomationProperties.Name="Sort notes"
                              Style="{StaticResource FilterComboStyle}"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
                    <Button MinWidth="112"
                            Command="{Binding ClearFiltersCommand}"
                            AutomationProperties.Name="Clear filters"
                            Style="{StaticResource FilterActionButtonStyle}">
                        <TextBlock Text="Clear filters" />
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="18,16,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Documents"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding ResultsSummary}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Text="{Binding VisibleNotes.Count, Mode=OneWay, StringFormat={}{0} shown}" />
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock Text="Loading notes..."
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Margin="18,0,18,18"
                            Padding="16"
                            Background="#FFF7F7"
                            BorderBrush="#F1C9C9"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#9C2F2F"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Margin="18,0,18,18"
                            Padding="24"
                            Background="{StaticResource SoftSurfaceBrush}"
                            BorderBrush="{StaticResource SoftLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShouldShowEmptyState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel MaxWidth="420"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding EmptyStateTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyStateMessage}"
                                       Margin="0,8,0,18"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Margin="0,0,10,0"
                                        Command="{Binding CreateNoteCommand}"
                                        AutomationProperties.Name="New note"
                                        Style="{StaticResource PrimaryActionButtonStyle}">
                                    <TextBlock Text="New note" />
                                </Button>
                                <Button Command="{Binding ImportDocumentsCommand}"
                                        AutomationProperties.Name="Import"
                                        Style="{StaticResource SecondaryActionButtonStyle}">
                                    <TextBlock Text="Import" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="18,0,18,0"
                          Grid.IsSharedSizeScope="True">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisibleNotes}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="12,0"
                                Height="38"
                                Background="#FBFCFF"
                                BorderBrush="{StaticResource SoftLineBrush}"
                                BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" SharedSizeGroup="NameColumn" />
                                    <ColumnDefinition Width="130" SharedSizeGroup="TypeColumn" />
                                    <ColumnDefinition Width="180" SharedSizeGroup="LocationColumn" />
                                    <ColumnDefinition Width="154" SharedSizeGroup="ModifiedColumn" />
                                    <ColumnDefinition Width="154" SharedSizeGroup="CreatedColumn" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="Type"
                                           Margin="14,0,0,0"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                                <TextBlock Grid.Column="2"
                                           Text="Location"
                                           Margin="14,0,0,0"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                                <TextBlock Grid.Column="3"
                                           Text="Last modified"
                                           Margin="14,0,0,0"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                                <TextBlock Grid.Column="4"
                                           Text="Created"
                                           Margin="14,0,0,0"
                                           Style="{StaticResource TableHeaderTextStyle}" />
                            </Grid>
                        </Border>

                        <TreeView Grid.Row="1"
                                  BorderThickness="0"
                                  Background="{StaticResource SurfaceBrush}"
                                  FontSize="13"
                                  Foreground="{StaticResource InkBrush}"
                                  ItemsSource="{Binding VisibleTreeNodes}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ItemContainerStyle="{StaticResource AllNotesTreeViewItemStyle}">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type viewModels:AllNotesTreeItemViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <Grid MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" SharedSizeGroup="NameColumn" />
                                            <ColumnDefinition Width="130" SharedSizeGroup="TypeColumn" />
                                            <ColumnDefinition Width="180" SharedSizeGroup="LocationColumn" />
                                            <ColumnDefinition Width="154" SharedSizeGroup="ModifiedColumn" />
                                            <ColumnDefinition Width="154" SharedSizeGroup="CreatedColumn" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanOpen}"
                                                AutomationProperties.Name="{Binding Title}"
                                                Style="{StaticResource AllNotesTreeButtonStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Style="{StaticResource AllNotesTreeNodeIconStyle}" />
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{StaticResource InkBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Title}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Margin="14,0,0,0"
                                                   Text="{Binding TypeLabel}"
                                                   Style="{StaticResource TableCellTextStyle}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="14,0,0,0"
                                                   Text="{Binding LocationLabel}"
                                                   ToolTip="{Binding LocationLabel}"
                                                   Style="{StaticResource TableCellTextStyle}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="14,0,0,0"
                                                   Text="{Binding ModifiedAtLabel}"
                                                   Style="{StaticResource TableCellTextStyle}" />
                                        <TextBlock Grid.Column="4"
                                                   Margin="14,0,0,0"
                                                   Text="{Binding CreatedAtLabel}"
                                                   Style="{StaticResource TableCellTextStyle}" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        Height="1"
                        Background="{StaticResource SoftLineBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
