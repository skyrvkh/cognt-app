<UserControl x:Class="CogntApp.Views.DecksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:deckViewModels="clr-namespace:CogntApp.ViewModels.Decks"
             xmlns:subviews="clr-namespace:CogntApp.Views.Decks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1220"
             Background="#F7F9FC"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type deckViewModels:DecksSubviewViewModel}">
            <subviews:DecksSubview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type deckViewModels:StatisticsSubviewViewModel}">
            <subviews:StatisticsSubview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type deckViewModels:CreateCardReviewSubviewViewModel}">
            <subviews:CreateCardReviewSubview CardEditorHostRequested="CreateCardReviewSubview_CardEditorHostRequested"
                                              CardEditorReleased="CreateCardReviewSubview_CardEditorReleased"
                                              CreateCardsRequested="CreateCardReviewSubview_CreateCardsRequested" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type deckViewModels:EditCardViewModel}">
            <subviews:EditCardView CardEditorHostRequested="EditCardView_CardEditorHostRequested"
                                   CardEditorReleased="EditCardView_CardEditorReleased"
                                   SaveCardRequested="EditCardView_SaveCardRequested" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                Background="#FFFFFF">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Decks / Cards"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkBrush}"
                           FontSize="18"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Click="PracticeButton_Click"
                            Style="{StaticResource PracticeButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Practice"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Border Style="{StaticResource PracticeCountBadgeStyle}">
                                <TextBlock Text="{Binding PracticeDueCount}"
                                           Style="{StaticResource PracticeCountTextStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="FlashcardsBodyScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ScrollableSubview}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid MinWidth="{Binding ViewportWidth, ElementName=FlashcardsBodyScrollViewer}">
                    <ContentControl Content="{Binding ScrollableSubview}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" />
                </Grid>
            </ScrollViewer>

            <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DirectSubview}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ContentControl Content="{Binding DirectSubview}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
