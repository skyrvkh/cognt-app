<Window x:Class="CogntApp.Views.TagEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Tags"
        Width="460"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock x:Name="SubtitleText"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,12">
            <TextBlock Text="Add or select tags"
                       Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Text="Use commas for multiple tags. Spaces are removed from new tags."
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource SubtleBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right"
                        Width="72"
                        Margin="8,0,0,0"
                        Content="Add"
                        Click="AddPendingTag_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <TextBox x:Name="PendingTagTextBox"
                         MinHeight="34"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource InputTextBoxStyle}"
                         PreviewKeyDown="PendingTagTextBox_PreviewKeyDown" />
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource PanelBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TagItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="12,8"
                                      Foreground="{DynamicResource InkBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0">
            <TextBlock Text="Scope"
                       Foreground="{DynamicResource MutedBrush}" />
            <RadioButton x:Name="ItemOnlyRadioButton"
                         Margin="0,8,0,0"
                         Content="This item only"
                         IsChecked="True"
                         Foreground="{DynamicResource InkBrush}" />
            <RadioButton x:Name="DescendantsRadioButton"
                         Margin="0,6,0,0"
                         Content="This item and all descendants"
                         Foreground="{DynamicResource InkBrush}" />
            <TextBlock x:Name="ValidationText"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="88"
                    IsCancel="True"
                    Style="{StaticResource OutlineButtonStyle}" />
            <Button Content="Apply"
                    Width="88"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    Click="Apply_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
