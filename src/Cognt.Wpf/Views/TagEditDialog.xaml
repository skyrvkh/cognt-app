<Window x:Class="CogntApp.Views.TagEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Tags"
        Width="520"
        Height="560"
        MinWidth="460"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource PageBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Edit tags"
                       Foreground="{DynamicResource InkBrush}"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="TargetTitleText"
                       Grid.Row="1"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,0,0,12">
            <Border BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               Text="#"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="TagSearchTextBox"
                             Grid.Column="1"
                             MinHeight="42"
                             Margin="6,0,10,0"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource InkBrush}"
                             TextChanged="TagSearchTextBox_TextChanged"
                             GotKeyboardFocus="TagSearchTextBox_GotKeyboardFocus"
                             PreviewKeyDown="TagSearchTextBox_PreviewKeyDown" />
                </Grid>
            </Border>

            <Popup x:Name="TagSuggestionsPopup"
                   PlacementTarget="{Binding ElementName=TagSearchTextBox}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Width="{Binding ActualWidth, ElementName=TagSearchTextBox}"
                        MaxHeight="230"
                        Margin="0,6,0,0"
                        Padding="6"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="4"
                                          Opacity="0.18"
                                          Color="#000000" />
                    </Border.Effect>
                    <ListBox x:Name="TagSuggestionsListBox"
                             MaxHeight="210"
                             Background="Transparent"
                             BorderThickness="0"
                             KeyboardNavigation.TabNavigation="Cycle"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}"
                                        Click="Suggestion_Click"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Padding="10,8"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="#"
                                                   Margin="0,0,7,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>

        <Border Grid.Row="2"
                Padding="12"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Background="{DynamicResource PanelBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SelectedTagsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,8"
                                    Padding="10,5"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="#"
                                               Margin="0,0,3,0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource InkBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <Button Content="x"
                                            Tag="{Binding}"
                                            Click="RemoveSelectedTag_Click"
                                            Margin="8,-3,-5,-3"
                                            Padding="4,0"
                                            MinWidth="20"
                                            MinHeight="20"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Foreground="{DynamicResource MutedBrush}"
                                            Cursor="Hand" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border x:Name="ScopePanel"
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}">
            <StackPanel>
                <TextBlock Text="Apply to"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <RadioButton x:Name="ItemOnlyRadioButton"
                             Margin="0,9,0,0"
                             Content="This item only"
                             IsChecked="True"
                             Foreground="{DynamicResource InkBrush}" />
                <RadioButton x:Name="DescendantsRadioButton"
                             Margin="0,6,0,0"
                             Content="This item and all descendants"
                             Foreground="{DynamicResource InkBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Width="96"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource OutlineButtonStyle}" />
            <Button Grid.Column="2"
                    Width="96"
                    Height="36"
                    Content="Apply"
                    IsDefault="True"
                    Click="Apply_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
