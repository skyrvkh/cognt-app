<Window x:Class="CogntApp.Views.TagEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Tags"
        Width="460"
        Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">
            <Grid>
                <TextBox x:Name="TagSearchTextBox"
                         MinHeight="36"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource InputTextBoxStyle}"
                         TextChanged="TagSearchTextBox_TextChanged"
                         GotKeyboardFocus="TagSearchTextBox_GotKeyboardFocus"
                         PreviewKeyDown="TagSearchTextBox_PreviewKeyDown" />
                <Popup x:Name="TagSuggestionsPopup"
                       PlacementTarget="{Binding ElementName=TagSearchTextBox}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Fade">
                    <Border Width="{Binding ActualWidth, ElementName=TagSearchTextBox}"
                            Margin="0,4,0,0"
                            Padding="4"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ListBox x:Name="TagSuggestionsListBox"
                                 MaxHeight="190"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 KeyboardNavigation.TabNavigation="Cycle">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}"
                                            Click="Suggestion_Click"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Padding="9,7"
                                            Cursor="Hand">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <ItemsControl x:Name="SelectedTagsItemsControl"
                          Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8"
                                Padding="9,4"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource InkBrush}"
                                           FontSize="12" />
                                <Button Content="x"
                                        Tag="{Binding}"
                                        Click="RemoveSelectedTag_Click"
                                        Margin="7,-2,-4,-2"
                                        Padding="4,0"
                                        MinWidth="18"
                                        MinHeight="18"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="{DynamicResource MutedBrush}"
                                        Cursor="Hand" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="ScopePanel"
                    Grid.Row="1"
                    Margin="0,8,0,0">
            <TextBlock Text="Scope"
                       Foreground="{DynamicResource MutedBrush}" />
            <RadioButton x:Name="ItemOnlyRadioButton"
                         Margin="0,8,0,0"
                         Content="This item only"
                         IsChecked="True"
                         Foreground="{DynamicResource InkBrush}" />
            <RadioButton x:Name="DescendantsRadioButton"
                         Margin="0,6,0,0"
                         Content="This item and all descendants"
                         Foreground="{DynamicResource InkBrush}" />
            <TextBlock x:Name="ValidationText"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="88"
                    IsCancel="True"
                    Style="{StaticResource OutlineButtonStyle}" />
            <Button Content="Apply"
                    Width="88"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    Click="Apply_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
