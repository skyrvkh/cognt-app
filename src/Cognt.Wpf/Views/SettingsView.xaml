<UserControl x:Class="CogntApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1120"
             Background="#F8FAFF">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#15192C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#707895" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE3F0" />

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="MetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="ValueInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DCEE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2433" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="920"
              Margin="32,52,32,40"
              HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="Settings"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="These settings are saved inside the current collection only."
                               Margin="0,10,0,0"
                               FontSize="14"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <Border Margin="0,28,0,0"
                        Padding="18"
                        Background="#F8FAFF"
                        BorderBrush="#E1E6F0"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShouldShowSettingsEmptyState}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Select a collection to edit its settings."
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Collection settings are saved per `.cognt` collection and are loaded when you switch collections."
                                   Margin="0,8,0,0"
                                   Style="{StaticResource MetaTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,28,0,0">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}"
                               BasedOn="{StaticResource PanelCardStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShouldShowSettingsEmptyState}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Interface"
                                   Style="{StaticResource PanelTitleStyle}" />
                        <Grid Margin="0,18,0,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Global text size"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2433" />
                                <TextBlock Text="Applies to shared navigation text such as breadcrumbs, note titles, and attachment titles."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                                <Slider Minimum="9"
                                        Maximum="18"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,14,0,0"
                                        Value="{Binding GlobalTextFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GlobalTextFontSize, StringFormat={}{0:0}px}"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Top"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#3156D4" />
                        </Grid>

                        <TextBlock Text="Graph"
                                   Style="{StaticResource PanelTitleStyle}" />
                        <TextBlock Text="{Binding CurrentCollectionName}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource MetaTextStyle}" />

                        <TextBlock Text="Loading graph settings..."
                                   Margin="0,14,0,0"
                                   FontSize="12"
                                   Foreground="#586078">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGraphSettingsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanEditGraphSettings}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Neighbor depth"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2433" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GraphSettingsNeighborDepthDisplay}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#3156D4" />
                                </Grid>
                                <TextBlock Text="Number of inbound/outgoing link hops to include from the current note."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBox Style="{StaticResource ValueInputStyle}"
                                         Text="{Binding GraphSettingsNeighborDepthText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Maximum nodes"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2433" />
                                <TextBlock Text="Caps dense neighborhoods so the graph stays readable."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBox Style="{StaticResource ValueInputStyle}"
                                         Text="{Binding GraphSettingsMaxNodesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,18,0,0"
                                Padding="14"
                                Background="#FFF4F4"
                                BorderBrush="#F1C9C9"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGraphSettingsValidationMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding GraphSettingsValidationMessage}"
                                       FontSize="12"
                                       Foreground="#A23B3B"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="#FFF7E8"
                                BorderBrush="#F0D599"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGraphSettingsErrorMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding GraphSettingsErrorMessage}"
                                       FontSize="12"
                                       Foreground="#8A5A0A"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,24,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding GraphSettingsStatusMessage}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#2F6F4F"
                                       TextWrapping="Wrap" />

                            <Button Grid.Column="1"
                                    Height="38"
                                    Padding="18,0"
                                    Margin="16,0,0,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#D5DCEE"
                                    Foreground="#3156D4"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Command="{Binding ResetGraphSettingsCommand}"
                                    IsEnabled="{Binding CanEditGraphSettings}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EEF2FF" />
                                                <Setter Property="BorderBrush" Value="#CBD6FF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Reset" />
                            </Button>

                            <Button Grid.Column="2"
                                    Height="38"
                                    Padding="18,0"
                                    Margin="16,0,0,0"
                                    Background="#3156D4"
                                    BorderBrush="#3156D4"
                                    Foreground="#FFFFFF"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Command="{Binding SaveGraphSettingsCommand}"
                                    IsEnabled="{Binding CanSaveGraphSettings}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#274BC2" />
                                                <Setter Property="BorderBrush" Value="#274BC2" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#AEB7D1" />
                                                <Setter Property="BorderBrush" Value="#AEB7D1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Save graph settings" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Review Limits"
                                   Style="{StaticResource PanelTitleStyle}" />
                        <TextBlock Text="{Binding CurrentCollectionName}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource MetaTextStyle}" />

                        <TextBlock Text="Loading collection settings..."
                                   Margin="0,14,0,0"
                                   FontSize="12"
                                   Foreground="#586078">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReviewSettingsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanEditReviewSettings}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Daily review limit"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2433" />
                                <TextBlock Text="Maximum due review cards to schedule per day."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}" />
                                <TextBox Style="{StaticResource ValueInputStyle}"
                                         Text="{Binding ReviewSettingsDailyLimitText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="New card limit"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2433" />
                                <TextBlock Text="Maximum new cards to introduce per day."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}" />
                                <TextBox Style="{StaticResource ValueInputStyle}"
                                         Text="{Binding ReviewSettingsNewCardsLimitText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,24,0,0"
                                Padding="16"
                                Background="#F8FAFF"
                                BorderBrush="#E1E6F0"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanEditReviewSettings}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Desired retention"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2433" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ReviewSettingsDesiredRetentionDisplay}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#3156D4" />
                                </Grid>
                                <TextBlock Text="Used by the FSRS scheduler when calculating the next review interval."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}" />
                                <Slider Minimum="0.70"
                                        Maximum="0.99"
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,14,0,0"
                                        Value="{Binding ReviewSettingsDesiredRetention, Mode=TwoWay}" />
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="70%"
                                               Style="{StaticResource MetaTextStyle}"
                                               DockPanel.Dock="Left" />
                                    <TextBlock Text="99%"
                                               Style="{StaticResource MetaTextStyle}"
                                               DockPanel.Dock="Right" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="14"
                                Background="#FFF4F4"
                                BorderBrush="#F1C9C9"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReviewSettingsValidationMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ReviewSettingsValidationMessage}"
                                       FontSize="12"
                                       Foreground="#A23B3B"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="#FFF7E8"
                                BorderBrush="#F0D599"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReviewSettingsErrorMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ReviewSettingsErrorMessage}"
                                       FontSize="12"
                                       Foreground="#8A5A0A"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding ReviewSettingsStatusMessage}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#2F6F4F"
                                       TextWrapping="Wrap" />

                            <Button Grid.Column="1"
                                    Height="38"
                                    Padding="18,0"
                                    Margin="16,0,0,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#D5DCEE"
                                    Foreground="#3156D4"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Command="{Binding ResetReviewSettingsCommand}"
                                    IsEnabled="{Binding CanEditReviewSettings}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EEF2FF" />
                                                <Setter Property="BorderBrush" Value="#CBD6FF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Reset" />
                            </Button>

                            <Button Grid.Column="2"
                                    Height="38"
                                    Padding="18,0"
                                    Margin="16,0,0,0"
                                    Background="#3156D4"
                                    BorderBrush="#3156D4"
                                    Foreground="#FFFFFF"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Command="{Binding SaveReviewSettingsCommand}"
                                    IsEnabled="{Binding CanSaveReviewSettings}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#274BC2" />
                                                <Setter Property="BorderBrush" Value="#274BC2" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#AEB7D1" />
                                                <Setter Property="BorderBrush" Value="#AEB7D1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Save collection settings" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="16"
                        Background="#FFF9E8"
                        BorderBrush="#F0DE9A"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="These values affect the active collection only. Switching collections loads that collection's saved review settings."
                               FontSize="12"
                               Foreground="#7B5A12"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
