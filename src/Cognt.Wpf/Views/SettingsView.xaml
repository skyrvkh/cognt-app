<UserControl x:Class="CogntApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1120"
             Background="{DynamicResource PageBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="920"
              Margin="32,52,32,40"
              HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="Settings"
                               Style="{StaticResource AppPageTitleTextStyle}" />
                    <TextBlock Text="Appearance, editor, graph, and review preferences are saved with the current collection."
                               Margin="0,10,0,0"
                               Style="{StaticResource MetaTextStyle}" />
                </StackPanel>

                <Border Margin="0,28,0,0"
                        Padding="18"
                        Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShouldShowSettingsEmptyState}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Select a collection to edit its settings."
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="Collection settings are saved per .cognt collection and are loaded when you switch collections."
                                   Margin="0,8,0,0"
                                   Style="{StaticResource MetaTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,28,0,0">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}"
                               BasedOn="{StaticResource PanelCardStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShouldShowSettingsEmptyState}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Appearance"
                                           Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="{Binding CurrentThemeDescription}"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Margin="28,0,0,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsGraphiteTheme, Mode=TwoWay}"
                                          Style="{StaticResource ThemeModeToggleStyle}" />
                        </Grid>

                        <Border Height="1"
                                Margin="0,24,0,0"
                                Background="{DynamicResource LineBrush}" />

                        <TextBlock Text="Interface"
                                   Margin="0,24,0,0"
                                   Style="{StaticResource PanelTitleStyle}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Global text size"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Applies to shared navigation text, breadcrumbs, note titles, and attachment titles."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                     Text="{Binding GlobalTextFontSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Typography"
                                   Margin="0,24,0,0"
                                   Style="{StaticResource PanelTitleStyle}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="UI font family"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Applied to the application shell, navigation, controls, and shared text."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      ItemsSource="{Binding FontFamilyOptions}"
                                      SelectedItem="{Binding InterfaceFontFamilyText, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Heading font family"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Applied to page titles, editor headings, and display text."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      ItemsSource="{Binding FontFamilyOptions}"
                                      SelectedItem="{Binding DisplayFontFamilyText, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Editor font family"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Applied to note body content inside EditorWeb."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      ItemsSource="{Binding FontFamilyOptions}"
                                      SelectedItem="{Binding ReadingFontFamilyText, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Code font family"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Applied to code blocks and code editor surfaces."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      ItemsSource="{Binding FontFamilyOptions}"
                                      SelectedItem="{Binding CodeFontFamilyText, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Editor text size"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Base body text size for EditorWeb."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                     Text="{Binding EditorTextFontSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Heading size"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Top heading size used to derive smaller heading levels."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                     Text="{Binding EditorHeadingFontSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Code size"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Font size for code blocks and inline code."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                     Text="{Binding EditorCodeFontSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="EditorWeb zoom"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Percentage zoom for the web editor. Default is 100."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                     Text="{Binding EditorZoomPercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auto-save"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Collection-local editor save behavior."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource SettingsToggleButtonStyle}"
                                          IsChecked="{Binding IsAutoSaveEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auto-save interval"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Minutes after the latest edit before timed auto-save runs."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                     IsEnabled="{Binding IsAutoSaveEnabled}"
                                     Text="{Binding AutoSaveIntervalMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Save on close"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Save pending note changes when a tab, detached note, or the app closes."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource SettingsToggleButtonStyle}"
                                          IsChecked="{Binding IsSaveOnCloseEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Border Margin="0,16,0,0"
                                Padding="14"
                                Background="{DynamicResource DangerSurfaceBrush}"
                                BorderBrush="{DynamicResource DangerLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAutoSaveSettingsValidationMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding AutoSaveSettingsValidationMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Height="1"
                                Margin="0,24,0,0"
                                Background="{DynamicResource LineBrush}" />

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Graph"
                                           Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="{Binding CurrentCollectionName}"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="Loading graph settings..."
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGraphSettingsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanEditGraphSettings}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Neighbor depth"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Number of inbound and outgoing link hops to include from the current note."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SettingsNumberTextBoxStyle}"
                                         Text="{Binding GraphSettingsNeighborDepthText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Maximum nodes"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Caps dense neighborhoods so the graph stays readable."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SettingsNumberTextBoxStyle}"
                                         Text="{Binding GraphSettingsMaxNodesText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>

                        <Border Margin="0,16,0,0"
                                Padding="14"
                                Background="{DynamicResource DangerSurfaceBrush}"
                                BorderBrush="{DynamicResource DangerLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGraphSettingsValidationMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding GraphSettingsValidationMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="{DynamicResource WarningSurfaceBrush}"
                                BorderBrush="{DynamicResource WarningLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGraphSettingsErrorMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding GraphSettingsErrorMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Height="1"
                                Margin="0,24,0,0"
                                Background="{DynamicResource LineBrush}" />

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Review Limits"
                                           Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="{Binding CurrentCollectionName}"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="Loading collection settings..."
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReviewSettingsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanEditReviewSettings}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Daily review limit"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Maximum due review cards to schedule per day."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SettingsNumberTextBoxStyle}"
                                         Text="{Binding ReviewSettingsDailyLimitText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="New card limit"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Maximum new cards to introduce per day."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SettingsNumberTextBoxStyle}"
                                         Text="{Binding ReviewSettingsNewCardsLimitText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Desired retention"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Used by FSRS when calculating the next review interval. Enter 70-99."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SettingsNumberTextBoxStyle}"
                                         Text="{Binding ReviewSettingsDesiredRetentionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Learning steps"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Intervals before a new card graduates, for example 1m, 10m."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SettingsWideTextBoxStyle}"
                                         Text="{Binding ReviewSettingsLearningStepsText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Relearning steps"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Intervals used after a review card is forgotten, for example 10m."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SettingsWideTextBoxStyle}"
                                         Text="{Binding ReviewSettingsRelearningStepsText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="FSRS optimization"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Disabled by default. Uses review history to tune scheduler settings when enabled."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource SettingsToggleButtonStyle}"
                                              IsChecked="{Binding IsFsrsOptimizationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Cram mode"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Shows the hidden Cram action in Review when enabled for this collection."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource SettingsToggleButtonStyle}"
                                              IsChecked="{Binding IsCramEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show flashcards in navigation"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Shows cards generated from a note below that note in the navigation tree."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource SettingsToggleButtonStyle}"
                                              IsChecked="{Binding ShowFlashcardsInNavigationTree, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Expander Margin="0,16,0,0"
                                      Header="Advanced (optional)"
                                      Foreground="{DynamicResource InkBrush}">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="FSRS parameters"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Optional custom scheduler values. Leave every field empty to use built-in defaults, or optimizer output when optimization is enabled."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               TextWrapping="Wrap" />
                                    <Border Margin="0,12,0,0"
                                            Padding="12"
                                            Background="{DynamicResource PanelAltBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ItemsControl ItemsSource="{Binding ReviewSettingsFsrsParameters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="128" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource InkBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding RangeDisplay}"
                                                                       Margin="0,3,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1"
                                                                 Style="{StaticResource SettingsNumberTextBoxStyle}"
                                                                 Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <Border Margin="0,16,0,0"
                                Padding="14"
                                Background="{DynamicResource DangerSurfaceBrush}"
                                BorderBrush="{DynamicResource DangerLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReviewSettingsValidationMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ReviewSettingsValidationMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="{DynamicResource WarningSurfaceBrush}"
                                BorderBrush="{DynamicResource WarningLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReviewSettingsErrorMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ReviewSettingsErrorMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Height="1"
                                Margin="0,24,0,0"
                                Background="{DynamicResource LineBrush}" />

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AutoSaveSettingsStatusMessage}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GraphSettingsStatusMessage}"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReviewSettingsStatusMessage}"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Settings are saved with the active collection. Switching collections loads that collection's saved appearance, editor, graph, and review preferences."
                                           Margin="0,8,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Margin="24,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveSettingsCommand}"
                                    IsEnabled="{Binding CanSaveSettings}">
                                <TextBlock Text="Save settings"
                                            Foreground="{DynamicResource VibrantButtonForegroundBrush}"
                                            />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
