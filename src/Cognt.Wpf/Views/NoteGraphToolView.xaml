<UserControl x:Class="CogntApp.Views.NoteGraphToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:CogntApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="420"
             Background="{DynamicResource SidebarSurfaceBrush}">
    <UserControl.Resources>
        <Style x:Key="GraphToolHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource GraphToolInkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GraphToolMetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource GraphToolMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="GraphToolButtonStyle" TargetType="Button">
            <Style.Resources>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ButtonTemplateTextForegroundStyle}" />
                        <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource ButtonTemplateAccessTextForegroundStyle}" />
            </Style.Resources>
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GraphToolLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource GraphToolInkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ButtonTemplateTextForegroundStyle}" />
                                <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource ButtonTemplateAccessTextForegroundStyle}" />
                            </Border.Resources>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GraphToolInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GraphToolLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource GraphToolInkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SidebarSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Graph"
                               Style="{StaticResource GraphToolHeaderTextStyle}" />
                    <TextBlock Text="{Binding GraphSummary}"
                               Margin="0,3,0,0"
                               Style="{StaticResource GraphToolMetaTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,6,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource GraphToolButtonStyle}"
                            ToolTip="Refresh graph">
                        <Path Width="12"
                              Height="12"
                              Data="M13,5 A5,5 0 1 0 14,10 M14,5 L14,1 L18,1"
                              Stretch="Uniform"
                              Stroke="{DynamicResource AccentStrongBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Button>
                    <Button Click="GraphFitButton_Click"
                            Style="{StaticResource GraphToolButtonStyle}"
                            ToolTip="Fit graph">
                        <Path Width="12"
                              Height="12"
                              Data="M3,7 L3,3 L7,3 M13,3 L17,3 L17,7 M17,13 L17,17 L13,17 M7,17 L3,17 L3,13"
                              Stretch="Uniform"
                              Stroke="{DynamicResource AccentStrongBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Button>
                    <Button x:Name="GraphSettingsButton"
                            Margin="6,0,0,0"
                            Click="GraphSettingsButton_Click"
                            Style="{StaticResource GraphToolButtonStyle}"
                            ToolTip="Graph settings">
                        <Path Width="12"
                              Height="12"
                              Data="M9,3.5 L11,3.5 L11.6,5.3 L13.4,5.9 L15,4.9 L16.4,6.3 L15.4,7.9 L16.1,9.6 L18,10.2 L18,12.2 L16.1,12.8 L15.4,14.5 L16.4,16.1 L15,17.5 L13.4,16.5 L11.6,17.1 L11,19 L9,19 L8.4,17.1 L6.6,16.5 L5,17.5 L3.6,16.1 L4.6,14.5 L3.9,12.8 L2,12.2 L2,10.2 L3.9,9.6 L4.6,7.9 L3.6,6.3 L5,4.9 L6.6,5.9 L8.4,5.3 Z M10,8.3 A2.9,2.9 0 1 0 10,14.1 A2.9,2.9 0 0 0 10,8.3"
                              Stretch="Uniform"
                              Stroke="{DynamicResource AccentStrongBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Button>

                    <Popup x:Name="GraphSettingsPopup"
                           PlacementTarget="{Binding ElementName=GraphSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Closed="GraphSettingsPopup_Closed">
                        <Border Width="218"
                                Margin="0,5,0,0"
                                Padding="10"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                                  Opacity="0.14"
                                                  BlurRadius="18"
                                                  ShadowDepth="6" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="66" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Depth (1-4)"
                                           Style="{StaticResource GraphToolMetaTextStyle}" />
                                <TextBox Grid.Column="1"
                                         HorizontalAlignment="Right"
                                         Style="{StaticResource GraphToolInputStyle}"
                                         Text="{Binding NeighborDepthText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="GraphSettingsTextBox_KeyDown" />

                                <TextBlock Grid.Row="2"
                                           Text="Max nodes"
                                           Style="{StaticResource GraphToolMetaTextStyle}" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         HorizontalAlignment="Right"
                                         Style="{StaticResource GraphToolInputStyle}"
                                         Text="{Binding MaxNodesText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="GraphSettingsTextBox_KeyDown" />
                            </Grid>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <views:GraphCanvas x:Name="GraphSurface"
                               Graph="{Binding Graph}"
                               FocusedDocumentId="{Binding FocusedDocumentId}"
                               IsMiniView="True"
                               OpenNodeCommand="{Binding OpenNodeCommand}"
                               SurfaceBrush="{DynamicResource GraphCanvasBrush}" />

            <Border Background="{DynamicResource StateOverlayBrush}"
                    Opacity="0.88">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldShowState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <StackPanel MaxWidth="300"
                        Margin="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldShowState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding StateTitle}"
                           TextAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GraphToolInkBrush}" />
                <TextBlock Text="{Binding StateMessage}"
                           Margin="0,6,0,12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource GraphToolMutedBrush}" />
                <Button Width="82"
                        HorizontalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GraphToolButtonStyle}">
                    <TextBlock Text="Refresh" />
                </Button>
            </StackPanel>

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="10"
                    Padding="9,5"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource SuccessBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>

