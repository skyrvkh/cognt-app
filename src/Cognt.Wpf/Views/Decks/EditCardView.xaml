<UserControl x:Class="CogntApp.Views.Decks.EditCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1292"
             HorizontalAlignment="Stretch"
             Loaded="EditCardView_Loaded"
             Unloaded="EditCardView_Unloaded"
             SizeChanged="EditCardView_SizeChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <Grid Margin="18,20,18,24">
        <Border MaxWidth="920"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="18"
                MinHeight="650"
                Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="HeaderActionsSpacerRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding BackToCardsCommand}"
                                Style="{StaticResource HeaderTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14"
                                      Height="14"
                                      Margin="0,0,8,0"
                                      Stroke="{DynamicResource InkBrush}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 9 2 L 3 7 L 9 12 M 3 7 L 14 7" />
                                <TextBlock Text="Back to Cards"
                                           Foreground="{DynamicResource InkBrush}"
                                           FontSize="13" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="/"
                                   Margin="12,0"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="Edit Card"
                                   Foreground="{DynamicResource InkBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <WrapPanel x:Name="ActionButtonsPanel"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               ItemHeight="36">
                        <Button Content="Cancel"
                                Width="86"
                                Command="{Binding BackToCardsCommand}"
                                Style="{StaticResource OutlineButtonStyle}" />
                        <Button Content="Save Changes"
                                Width="122"
                                Margin="12,0,0,0"
                                IsEnabled="{Binding CanSaveChanges}"
                                Click="SaveChanges_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Text"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="BlockSuite"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource SmallMutedTextStyle}" />
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource PanelBrush}"
                            MinHeight="520">
                        <ContentControl x:Name="CardTextEditorHost"
                                        Focusable="True"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
