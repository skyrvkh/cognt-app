<Window x:Class="CogntApp.Views.Decks.EditCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Card"
        Width="1120"
        Height="780"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="14"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Background="{DynamicResource PanelBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Deck"
                           VerticalAlignment="Center"
                           Style="{StaticResource SmallMutedTextStyle}" />
                <ComboBox x:Name="DeckComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          MinHeight="36"
                          IsEditable="True" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Tags"
                           VerticalAlignment="Center"
                           Style="{StaticResource SmallMutedTextStyle}" />
                <TextBox x:Name="TagsTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         MinHeight="36"
                         VerticalContentAlignment="Center"
                         ToolTip="Separate tags with commas. Spaces inside tags are removed on save."
                         Style="{StaticResource InputTextBoxStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Background="{DynamicResource EditorSurfaceBrush}">
                <Grid>
                    <Border x:Name="UnsupportedPanel"
                            Visibility="Collapsed"
                            Padding="22"
                            BorderBrush="{DynamicResource WarningLineBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Background="{DynamicResource WarningSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="This card type is not editable here yet."
                                       Foreground="{DynamicResource InkBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UnsupportedText"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TabControl x:Name="EditorTabs"
                                BorderThickness="0"
                                Background="Transparent">
                        <TabItem x:Name="FrontTab"
                                 Header="Front / source">
                            <ContentControl x:Name="FrontEditorHost" />
                        </TabItem>
                        <TabItem x:Name="BackTab"
                                 Header="Back / answer">
                            <ContentControl x:Name="BackEditorHost" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12" />
            <Button Grid.Column="1"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Style="{StaticResource OutlineButtonStyle}" />
            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Width="100"
                    Height="36"
                    Content="Save"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
