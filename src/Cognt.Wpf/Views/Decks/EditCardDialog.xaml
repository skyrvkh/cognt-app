<Window x:Class="CogntApp.Views.Decks.EditCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Card"
        Width="1040"
        Height="760"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Background="{DynamicResource PanelBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Edit Card"
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="CardSummaryText"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Card type"
                               Style="{StaticResource SmallMutedTextStyle}" />
                    <TextBlock x:Name="CardTypeText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource InkBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Deck"
                                   Style="{StaticResource SmallMutedTextStyle}" />
                        <ComboBox x:Name="DeckComboBox"
                                  Margin="0,6,0,0"
                                  MinHeight="34"
                                  IsEditable="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">
                        <TextBlock Text="Source"
                                   Style="{StaticResource SmallMutedTextStyle}" />
                        <TextBlock x:Name="SourceText"
                                   Margin="0,9,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Scheduling"
                                   Style="{StaticResource SmallMutedTextStyle}" />
                        <TextBlock x:Name="SchedulingText"
                                   Margin="0,9,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Tags"
                               Style="{StaticResource SmallMutedTextStyle}" />
                    <TextBox x:Name="TagsTextBox"
                             Margin="0,6,0,0"
                             MinHeight="34"
                             VerticalContentAlignment="Center"
                             ToolTip="Separate tags with commas. Spaces inside tags are removed on save."
                             Style="{StaticResource InputTextBoxStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,12,0,0">
                <Border x:Name="UnsupportedPanel"
                        Visibility="Collapsed"
                        Padding="18"
                        BorderBrush="{DynamicResource WarningLineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Background="{DynamicResource WarningSurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="This card type is not editable here yet."
                                   Foreground="{DynamicResource InkBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="UnsupportedText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TabControl x:Name="EditorTabs">
                    <TabItem x:Name="FrontTab"
                             Header="Front / source">
                        <Border BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="{DynamicResource EditorSurfaceBrush}">
                            <ContentControl x:Name="FrontEditorHost" />
                        </Border>
                    </TabItem>
                    <TabItem x:Name="BackTab"
                             Header="Back / answer">
                        <Border BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="{DynamicResource EditorSurfaceBrush}">
                            <ContentControl x:Name="BackEditorHost" />
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12" />
            <Button Grid.Column="1"
                    Width="96"
                    Height="34"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Style="{StaticResource OutlineButtonStyle}" />
            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Width="96"
                    Height="34"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}">
                <TextBlock Text="Save"
                            />
            </Button>
        </Grid>
    </Grid>
</Window>
