<UserControl x:Class="CogntApp.Views.Decks.CreateCardReviewSubview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1292"
             HorizontalAlignment="Stretch"
             Loaded="CreateCardReviewSubview_Loaded"
             Unloaded="CreateCardReviewSubview_Unloaded"
             SizeChanged="CreateCardReviewSubview_SizeChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <Grid MaxWidth="1260"
          HorizontalAlignment="Stretch"
          Margin="18,20,18,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="HeaderActionsSpacerRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding BackToCardsCommand}"
                        Style="{StaticResource HeaderTabButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14"
                              Height="14"
                              Margin="0,0,8,0"
                              Stroke="{StaticResource InkBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 9 2 L 3 7 L 9 12 M 3 7 L 14 7" />
                        <TextBlock Text="Back to Cards"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="13" />
                    </StackPanel>
                </Button>
                <TextBlock Text="/"
                           Margin="12,0"
                           Style="{StaticResource MutedTextStyle}" />
                <TextBlock Text="Add Cards"
                           Foreground="{StaticResource InkBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <WrapPanel x:Name="ActionButtonsPanel"
                       Grid.Column="1"
                       HorizontalAlignment="Right"
                       ItemHeight="36">
                <Button Content="Create Cards"
                        Width="130"
                        Click="CreateCards_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="18"
                MinHeight="742"
                Style="{StaticResource PanelStyle}">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="DetailsWrapSpacerRow" Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="DeckField">
                        <TextBlock Text="Deck" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox Margin="0,8,0,0"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  ItemsSource="{Binding DeckNames}"
                                  SelectedItem="{Binding SelectedDeckName, Mode=TwoWay}"
                                  Text="{Binding SelectedDeckName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FilterComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="TagsField" Grid.Column="2">
                        <TextBlock Text="Tags" Style="{StaticResource MutedTextStyle}" />
                        <Border Margin="0,8,0,0"
                                MinHeight="36"
                                CornerRadius="6"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                Background="#FFFFFF">
                            <WrapPanel Margin="8,5"
                                       VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,3"
                                                    CornerRadius="6"
                                                    Background="#EEF2FF"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox MinWidth="120"
                                         Margin="0,0,0,4"
                                         Padding="4,1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{StaticResource InkBrush}"
                                         Text="{Binding PendingTagText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TagInputTextBox_TextChanged"
                                         PreviewKeyDown="TagInputTextBox_PreviewKeyDown" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SourceField" Grid.Column="4">
                        <TextBlock Text="Source" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Margin="0,8,0,0"
                                 Text="{Binding SourceLabel, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,20,0,8">
                    <TextBlock Text="Text"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="Use cloze syntax in the editor"
                               HorizontalAlignment="Right"
                               Style="{StaticResource SmallMutedTextStyle}" />
                </Grid>

                <Border BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#FFFFFF"
                        MinHeight="472">
                    <ContentControl x:Name="CardTextEditorHost"
                                    Focusable="True"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
