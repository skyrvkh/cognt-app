<UserControl x:Class="CogntApp.Views.Decks.CardsSubview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1292"
             HorizontalAlignment="Stretch"
             Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, FallbackValue=1292}"
             MaxWidth="1292"
             Loaded="CardsSubview_Loaded"
             SizeChanged="CardsSubview_SizeChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ContextMenu x:Key="CardRowContextMenu">
            <MenuItem Header="Edit"
                      Command="{Binding DataContext.EditCardCommand, Source={x:Reference CardsDataGrid}}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding CanEdit}" />
            <MenuItem Header="Preview"
                      Click="PreviewCardMenuItem_Click" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot"
          MaxWidth="1292"
          Margin="16,16,16,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Cards"
                           VerticalAlignment="Center"
                           Style="{StaticResource PanelTitleStyle}" />

                <WrapPanel x:Name="HeaderActionsPanel"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           ItemHeight="36">
                    <Button Content="Filter"
                            Width="92"
                            Command="{Binding OpenFiltersCommand}"
                            Style="{StaticResource OutlineButtonStyle}" />
                </WrapPanel>
            </Grid>

            <UniformGrid x:Name="SummaryMetricsGrid"
                         Columns="4"
                         Margin="-6,18,-6,14">
                <Border Margin="6,0"
                        Padding="14"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Cards" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding TotalCards}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0"
                        Padding="14"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Learning" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding LearningCards}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0"
                        Padding="14"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Relearning" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding RelearningCards}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0"
                        Padding="14"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Due Today" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding DueCards}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,14,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ShowingSummary}"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="FilteredSummaryText"
                                   Text="{Binding ActiveFilterSummary}"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding CardEmptyStates}"
                                      Margin="14,2,14,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18"
                                            CornerRadius="8"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            Background="#F8FAFC">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource PanelTitleStyle}" />
                                            <TextBlock Text="{Binding Message}"
                                                       Margin="0,8,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DataGrid x:Name="CardsDataGrid"
                                  MinWidth="0"
                                  ItemsSource="{Binding CardLibraryRows}"
                                  SelectedIndex="0"
                                  MinRowHeight="58"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource FlashcardsDataGridStyle}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="PreviewMouseRightButtonDown"
                                                 Handler="CardsDataGridRow_PreviewMouseRightButtonDown" />
                                    <Setter Property="ContextMenu" Value="{StaticResource CardRowContextMenu}" />
                                    <Setter Property="Background" Value="{Binding RowBackgroundColor, FallbackValue=#FFFFFF}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EEF2FF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Question}" Header="Front Preview" Width="*" MinWidth="260" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding Deck}" Header="Deck" Width="150" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTemplateColumn Header="Status" Width="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Padding="7,3"
                                                    CornerRadius="4"
                                                    BorderBrush="{Binding StatusBorderColor}"
                                                    BorderThickness="1"
                                                    Background="{Binding StatusBackgroundColor}">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForegroundColor}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding Due}" Header="Due" Width="108" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding LastReviewed}" Header="Last Reviewed" Width="132" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTemplateColumn Header="Recall" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Padding="7,3"
                                                    CornerRadius="4"
                                                    BorderBrush="{Binding RecallBorderColor}"
                                                    BorderThickness="1"
                                                    Background="{Binding RecallBackgroundColor}">
                                                <TextBlock Text="{Binding Recall}" Foreground="{Binding RecallForegroundColor}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <Grid Grid.Row="2"
                          Margin="14,12,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ShowingSummary}"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>

        <Grid x:Name="FiltersModalOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="1"
              Panel.ZIndex="20"
              Background="#660F172A"
              Visibility="{Binding FiltersModalVisibility}">
            <Border MaxWidth="430"
                    MaxHeight="700"
                    Margin="16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Padding="18"
                    Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Filters"
                                   Style="{StaticResource PanelTitleStyle}"
                                   FontSize="18" />
                        <Button Content="x"
                                Width="34"
                                Height="32"
                                HorizontalAlignment="Right"
                                Command="{Binding CloseFiltersCommand}"
                                Style="{StaticResource IconButtonStyle}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,16"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="CARD FILTER"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding CardFilterStatusRows}"
                                     SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                     Margin="0,8,0,0"
                                     MaxHeight="210"
                                     Style="{StaticResource FilterListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource MutedTextStyle}" />
                                            <Border Grid.Column="1"
                                                    Padding="7,1"
                                                    CornerRadius="8"
                                                    Background="#E0E7FF">
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource InkBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,16" />

                            <TextBlock Text="SOURCE"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding CardFilterSourceRows}"
                                     SelectedItem="{Binding SelectedSourceFilter, Mode=TwoWay}"
                                     Margin="0,8,0,0"
                                     MaxHeight="150"
                                     Style="{StaticResource FilterListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Padding="7,1"
                                                    CornerRadius="8"
                                                    Background="#E0E7FF">
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource InkBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,16" />

                            <TextBlock Text="TAGS"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding CardFilterTagRows}"
                                     SelectedItem="{Binding SelectedTagFilter, Mode=TwoWay}"
                                     Margin="0,8,0,0"
                                     MaxHeight="170"
                                     Style="{StaticResource FilterListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Padding="7,1"
                                                    CornerRadius="8"
                                                    Background="#E0E7FF">
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource InkBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Button Content="Reset"
                                Width="88"
                                HorizontalAlignment="Left"
                                Command="{Binding ResetFiltersCommand}"
                                Style="{StaticResource OutlineButtonStyle}" />
                        <WrapPanel HorizontalAlignment="Right"
                                   ItemHeight="36">
                            <Button Content="Cancel"
                                    Width="88"
                                    Command="{Binding CloseFiltersCommand}"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            <Button Content="Apply Filters"
                                    Width="118"
                                    Margin="10,0,0,0"
                                    Command="{Binding ApplyFiltersCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
