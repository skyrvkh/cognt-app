<UserControl x:Class="CogntApp.Views.Decks.CardsSubview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1292"
             HorizontalAlignment="Stretch"
             Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, FallbackValue=1292}"
             MaxWidth="1292"
             Loaded="CardsSubview_Loaded"
             SizeChanged="CardsSubview_SizeChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ContextMenu x:Key="CardRowContextMenu">
            <MenuItem Header="Edit Tags..."
                      Click="AddTagsMenuItem_Click" />
            <MenuItem Header="Delete Card(s)..."
                      Click="DeleteCardsMenuItem_Click" />
            <Separator />
            <MenuItem Header="{Binding SuspensionAction}"
                      Command="{Binding DataContext.ToggleSuspensionCommand, Source={x:Reference CardsDataGrid}}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding CanSchedule}" />
            <MenuItem Header="Postpone 1 day"
                      Tag="1"
                      Click="PostponePresetMenuItem_Click"
                      IsEnabled="{Binding CanSchedule}" />
            <MenuItem Header="Postpone 3 days"
                      Tag="3"
                      Click="PostponePresetMenuItem_Click"
                      IsEnabled="{Binding CanSchedule}" />
            <MenuItem Header="Postpone 7 days"
                      Tag="7"
                      Click="PostponePresetMenuItem_Click"
                      IsEnabled="{Binding CanSchedule}" />
            <MenuItem Header="Postpone 14 days"
                      Tag="14"
                      Click="PostponePresetMenuItem_Click"
                      IsEnabled="{Binding CanSchedule}" />
            <MenuItem Header="Postpone 30 days"
                      Tag="30"
                      Click="PostponePresetMenuItem_Click"
                      IsEnabled="{Binding CanSchedule}" />
            <MenuItem Header="Custom..."
                      Click="CustomPostponeMenuItem_Click"
                      IsEnabled="{Binding CanSchedule}" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot"
          MaxWidth="1292"
          Margin="16,16,16,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Cards"
                           VerticalAlignment="Center"
                           Style="{StaticResource PanelTitleStyle}" />

                <WrapPanel x:Name="HeaderActionsPanel"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           ItemHeight="36">
                    <TextBox Width="230"
                             MinHeight="36"
                             Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search cards by front, back, deck, source, or tag"
                             Style="{StaticResource InputTextBoxStyle}" />
                    <Button Content="Edit Tags"
                            Width="96"
                            Margin="0,0,10,0"
                            Click="AddTagsButton_Click"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Content="Delete"
                            Width="84"
                            Margin="0,0,10,0"
                            Click="DeleteCardsButton_Click"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Content="Filter"
                            Width="92"
                            Command="{Binding OpenFiltersCommand}"
                            Style="{StaticResource OutlineButtonStyle}" />
                </WrapPanel>
            </Grid>

            <UniformGrid x:Name="SummaryMetricsGrid"
                         Columns="4"
                         Margin="-6,18,-6,14">
                <Border Margin="6,0"
                        Padding="14"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Cards" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding TotalCards}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0"
                        Padding="14"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Learning" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding LearningCards}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0"
                        Padding="14"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Relearning" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding RelearningCards}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0"
                        Padding="14"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Due Today" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding DueCards}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,14,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ShowingSummary}"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="FilteredSummaryText"
                                   Text="{Binding ActiveFilterSummary}"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding CardEmptyStates}"
                                      Margin="14,2,14,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18"
                                            CornerRadius="8"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource PanelAltBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource PanelTitleStyle}" />
                                            <TextBlock Text="{Binding Message}"
                                                       Margin="0,8,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DataGrid x:Name="CardsDataGrid"
                                  MinWidth="0"
                                  ItemsSource="{Binding CardLibraryRows}"
                                  SelectedIndex="0"
                                  MinRowHeight="58"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource FlashcardsDataGridStyle}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="PreviewMouseRightButtonDown"
                                                 Handler="CardsDataGridRow_PreviewMouseRightButtonDown" />
                                    <Setter Property="ContextMenu" Value="{StaticResource CardRowContextMenu}" />
                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Question}" Header="Front Preview" Width="*" MinWidth="260" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding Deck}" Header="Deck" Width="150" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding TagsLabel}" Header="Tags" Width="160" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTemplateColumn Header="Status" Width="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Padding="7,3"
                                                    CornerRadius="4"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="{DynamicResource NoteFillBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Relearning">
                                                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Review">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessLineBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Suspended">
                                                                <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{DynamicResource BlueBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Relearning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Review">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Suspended">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding Due}" Header="Due" Width="108" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding LastReviewed}" Header="Last Reviewed" Width="132" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTemplateColumn Header="Recall" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Padding="7,3"
                                                    CornerRadius="4"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Recall}" Value="Easy">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessLineBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Recall}" Value="Good">
                                                                <Setter Property="Background" Value="{DynamicResource ReviewGoodSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ReviewGoodLineBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Recall}" Value="Hard">
                                                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Recall}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Recall}" Value="Easy">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Recall}" Value="Good">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BlueBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Recall}" Value="Hard">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <Grid Grid.Row="2"
                          Margin="14,12,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ShowingSummary}"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>

        <Border x:Name="FiltersPanel"
                Grid.Row="1"
                Margin="0,14,0,0"
                Padding="18"
                Visibility="{Binding FiltersPanelVisibility}"
                Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Card filters"
                                   Style="{StaticResource PanelTitleStyle}"
                                   FontSize="18" />
                        <Button Content="x"
                                Width="34"
                                Height="32"
                                HorizontalAlignment="Right"
                                Command="{Binding CloseFiltersCommand}"
                                Style="{StaticResource IconButtonStyle}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,16"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="CARD FILTER"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding CardFilterStatusRows}"
                                     SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                     Margin="0,8,0,0"
                                     MaxHeight="210"
                                     Style="{StaticResource FilterListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource MutedTextStyle}" />
                                            <Border Grid.Column="1"
                                                    Padding="7,1"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource BadgeSurfaceBrush}">
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource InkBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20,0,16" />

                            <TextBlock Text="SOURCE"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding CardFilterSourceRows}"
                                     SelectedItem="{Binding SelectedSourceFilter, Mode=TwoWay}"
                                     Margin="0,8,0,0"
                                     MaxHeight="150"
                                     Style="{StaticResource FilterListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Padding="7,1"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource BadgeSurfaceBrush}">
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource InkBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20,0,16" />

                            <TextBlock Text="TAGS"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       FontWeight="SemiBold" />
                            <ScrollViewer Margin="0,8,0,0"
                                          MaxHeight="170"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CardFilterTagRows}">
                                    <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,6"
                                                  Foreground="{DynamicResource InkBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1"
                                                        Padding="7,1"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource BadgeSurfaceBrush}">
                                                    <TextBlock Text="{Binding Count}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource InkBrush}" />
                                                </Border>
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Button Content="Reset"
                                Width="88"
                                HorizontalAlignment="Left"
                                Command="{Binding ResetFiltersCommand}"
                                Style="{StaticResource OutlineButtonStyle}" />
                        <WrapPanel HorizontalAlignment="Right"
                                   ItemHeight="36">
                            <Button Content="Cancel"
                                    Width="88"
                                    Command="{Binding CloseFiltersCommand}"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            <Button Content="Apply Filters"
                                    Width="118"
                                    Margin="10,0,0,0"
                                    Command="{Binding ApplyFiltersCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
        </Border>
    </Grid>
</UserControl>
