<UserControl x:Class="CogntApp.Views.Decks.StatisticsSubview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1292"
             HorizontalAlignment="Stretch"
             Loaded="StatisticsSubview_Loaded"
             SizeChanged="StatisticsSubview_SizeChanged">
    <Grid x:Name="StatisticsLayoutRoot"
          Margin="16,16,16,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Command="{Binding BackToDecksCommand}"
                    Style="{StaticResource HeaderTabButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14"
                          Height="14"
                          Margin="0,0,8,0"
                          Stroke="{DynamicResource InkBrush}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M 9 2 L 3 7 L 9 12 M 3 7 L 14 7" />
                    <TextBlock Text="Back to Review"
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="13" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Statistics"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource PanelTitleStyle}"
                       FontSize="22" />
            <TextBlock Grid.Column="2"
                       Text="{Binding ScopeLabel}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="13"
                       FontWeight="SemiBold" />
        </Grid>

        <UniformGrid x:Name="StatisticsSummaryGrid"
                     Grid.Row="1"
                     Columns="4"
                     Margin="-6,18,-6,8">
            <Border Margin="6" Padding="16" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Cards Reviewed" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding CardsReviewedValue}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="22" />
                    <TextBlock Text="{Binding CardsReviewedDetail}" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="6" Padding="16" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Study Streak" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding StudyStreakValue}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="22" />
                    <TextBlock Text="{Binding StudyStreakDetail}" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="6" Padding="16" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Average Recall" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding AverageRecallValue}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="22" />
                    <TextBlock Text="{Binding AverageRecallDetail}" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="6" Padding="16" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Due Tomorrow" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding DueTomorrowValue}" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="22" />
                    <TextBlock Text="{Binding DueTomorrowDetail}" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TopStatisticsGapRow" Height="0" />
                <RowDefinition x:Name="TopStatisticsSecondaryRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TopStatisticsPrimaryColumn" Width="1.55*" />
                <ColumnDefinition x:Name="TopStatisticsGapColumn" Width="14" />
                <ColumnDefinition x:Name="TopStatisticsSecondaryColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Cards Reviewed"
                               Margin="16,16,16,0"
                               Style="{StaticResource PanelTitleStyle}"
                               TextWrapping="Wrap" />

                    <lvc:CartesianChart x:Name="DailyStatisticsChart"
                                        Grid.Row="1"
                                        Height="360"
                                        Margin="12,12,12,12"
                                        AnimationsSpeed="0:0:0.25"
                                        LegendPosition="Top"
                                        Series="{Binding DailyStatisticsSeries}"
                                        TooltipPosition="Top"
                                        XAxes="{Binding DailyStatisticsXAxes}"
                                        YAxes="{Binding DailyStatisticsYAxes}" />
                </Grid>
            </Border>

            <StackPanel x:Name="TopStatisticsSidePanel"
                        Grid.Row="0"
                        Grid.Column="2">
                <Border Padding="16" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Recall Distribution"
                                       Margin="0,0,12,0"
                                       Style="{StaticResource PanelTitleStyle}"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <lvc:PieChart x:Name="RecallDistributionChart"
                                      Height="220"
                                      Margin="0,10,0,0"
                                      AnimationsSpeed="0:0:0.25"
                                      LegendPosition="Bottom"
                                      Series="{Binding RecallDistributionSeries}"
                                      TooltipPosition="Hidden" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="16" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Study Heatmap - Previous 52 Weeks"
                                   Style="{StaticResource PanelTitleStyle}"
                                   TextWrapping="Wrap" />
                        <lvc:CartesianChart x:Name="StudyHeatmapChart"
                                            Height="220"
                                            Margin="0,10,0,0"
                                            AnimationsSpeed="0:0:0.25"
                                            LegendPosition="Hidden"
                                            Series="{Binding StudyStreakSeries}"
                                            TooltipPosition="Top"
                                            XAxes="{Binding StudyStreakXAxes}"
                                            YAxes="{Binding StudyStreakYAxes}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <UniformGrid x:Name="LearningDiagnosticsGrid"
                     Grid.Row="3"
                     Columns="2"
                     Margin="-6,14,-6,0">
            <Border Margin="6"
                    Padding="16"
                    Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Scheduled Workload"
                               Style="{StaticResource PanelTitleStyle}" />
                    <UniformGrid Grid.Row="1"
                                 Columns="3"
                                 Margin="-4,12,-4,0">
                        <StackPanel Margin="4">
                            <TextBlock Text="Next 7 days" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding Forecast7Value}" Margin="0,5,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                            <TextBlock Text="{Binding Forecast7Detail}" Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="Next 30 days" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding Forecast30Value}" Margin="0,5,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                            <TextBlock Text="{Binding Forecast30Detail}" Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="Next 90 days" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding Forecast90Value}" Margin="0,5,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                            <TextBlock Text="{Binding Forecast90Detail}" Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </UniformGrid>
                    <lvc:CartesianChart x:Name="WorkloadForecastChart"
                                        Grid.Row="2"
                                        Height="230"
                                        Margin="0,12,0,0"
                                        AnimationsSpeed="0:0:0.25"
                                        LegendPosition="Top"
                                        Series="{Binding WorkloadForecastSeries}"
                                        TooltipPosition="Top"
                                        XAxes="{Binding WorkloadForecastXAxes}"
                                        YAxes="{Binding WorkloadForecastYAxes}" />
                </Grid>
            </Border>

            <Border Margin="6"
                    Padding="16"
                    Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Learning Diagnostics"
                               Style="{StaticResource PanelTitleStyle}" />
                    <UniformGrid Columns="2"
                                 Margin="-4,12,-4,0">
                        <StackPanel Margin="4">
                            <TextBlock Text="Actual retention" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding RetentionCalibrationValue}" Margin="0,5,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                            <TextBlock Text="{Binding RetentionCalibrationDetail}" Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="Review latency" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding ReviewLatencyValue}" Margin="0,5,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                            <TextBlock Text="{Binding ReviewLatencyDetail}" Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="4,12,4,4">
                            <TextBlock Text="Lapses / leeches" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding LapseReportValue}" Margin="0,5,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                            <TextBlock Text="{Binding LapseReportDetail}" Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="4,12,4,4">
                            <TextBlock Text="Workload smoothing" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding SmoothingValue}" Margin="0,5,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="20" />
                            <TextBlock Text="{Binding SmoothingDetail}" Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding TomorrowWorkloadDetail}"
                               Margin="4,10,4,0"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Stability distribution"
                               Margin="4,14,4,0"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding StabilityDistributionLabel}"
                               Margin="4,4,4,0"
                               Style="{StaticResource TableTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Difficulty distribution"
                               Margin="4,10,4,0"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding DifficultyDistributionLabel}"
                               Margin="4,4,4,0"
                               Style="{StaticResource TableTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4"
              Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="BottomStatisticsGapRow" Height="0" />
                <RowDefinition x:Name="BottomStatisticsSecondaryRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BottomStatisticsPrimaryColumn" Width="1.55*" />
                <ColumnDefinition x:Name="BottomStatisticsGapColumn" Width="14" />
                <ColumnDefinition x:Name="BottomStatisticsSecondaryColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Deck Performance"
                               Margin="16,16,16,0"
                               Style="{StaticResource PanelTitleStyle}" />

                    <DataGrid Grid.Row="1"
                              MinWidth="0"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding DeckPerformanceRows}"
                              Style="{StaticResource FlashcardsDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Deck}" Header="Deck" Width="*" MinWidth="220" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding CardsReviewed}" Header="Cards Reviewed" Width="126" ElementStyle="{StaticResource GridCenterTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding RetentionLabel}" Header="Retention" Width="104" ElementStyle="{StaticResource GridCenterTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding Due}" Header="Due" Width="68" ElementStyle="{StaticResource GridCenterTextBlockStyle}" />
                                <DataGridTemplateColumn Header="Progress" Width="158">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar Width="92" Height="5" BorderThickness="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrackBrush}" />
                                                <TextBlock Text="{Binding ProgressLabel}" Margin="10,0,0,0" Style="{StaticResource TableTextStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="WeeklyOutcomePanel"
                    Grid.Row="0"
                    Grid.Column="2"
                    Padding="16"
                    Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Review Outcomes by Week"
                                   Margin="0,0,12,0"
                                   Style="{StaticResource PanelTitleStyle}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <lvc:CartesianChart x:Name="WeeklyOutcomeChart"
                                        Height="245"
                                        Margin="0,10,0,0"
                                        AnimationsSpeed="0:0:0.25"
                                        LegendPosition="Top"
                                        Series="{Binding WeeklyOutcomeSeries}"
                                        TooltipPosition="Top"
                                        XAxes="{Binding WeeklyOutcomeXAxes}"
                                        YAxes="{Binding WeeklyOutcomeYAxes}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
