<UserControl x:Class="CogntApp.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:CogntApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1120"
             Background="#F8FAFF">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#15192C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="LineBrush" Color="#DCE3F0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3156D4" />

        <Style x:Key="GraphToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F5FF" />
                    <Setter Property="BorderBrush" Value="#CBD6FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GraphPrimaryButtonStyle"
               BasedOn="{StaticResource GraphToolbarButtonStyle}"
               TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#274BC2" />
                    <Setter Property="BorderBrush" Value="#274BC2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GraphInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="70" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="GraphSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="GraphSearchResultButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F6FA" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E1E6F0"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding CurrentNodeTitle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GraphSummary}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Grid x:Name="GraphSearchHost"
                          Width="280"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center">
                        <Border x:Name="GraphSearchBox"
                                Height="34"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Path Width="15"
                                      Height="15"
                                      Margin="12,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="#6F7890"
                                      StrokeThickness="1.8"
                                      Data="M10.5,10.5 L15,15 M12,6.5 A5.5,5.5 0 1 1 1,6.5 A5.5,5.5 0 1 1 12,6.5 Z" />
                                <TextBox x:Name="GraphSearchTextBox"
                                         Margin="36,0,58,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Search graph"
                                         ToolTip="Search graph nodes"
                                         Style="{StaticResource GraphSearchTextBoxStyle}"
                                         KeyDown="GraphSearchTextBox_KeyDown" />
                                <TextBlock Text="Search graph"
                                           Margin="36,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#8B93A8"
                                           FontSize="13"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Padding="6,2"
                                        Background="#F4F6FA"
                                        BorderBrush="#E1E7F2"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <TextBlock Text="Enter"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Popup x:Name="GraphSearchPopup"
                               PlacementTarget="{Binding ElementName=GraphSearchBox}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               IsOpen="{Binding ShouldShowSearchResults, Mode=OneWay}">
                            <Border Width="{Binding ActualWidth, ElementName=GraphSearchBox}"
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Background="#FFFFFF"
                                    BorderBrush="#DCE3F0"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#24304A"
                                                      Opacity="0.14"
                                                      BlurRadius="18"
                                                      ShadowDepth="6" />
                                </Border.Effect>
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="GraphSearchResultButton_Click"
                                                    Style="{StaticResource GraphSearchResultButtonStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource InkBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding RelativePath}"
                                                               Margin="0,2,0,0"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource GraphToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13"
                                  Height="13"
                                  Data="M13,5 A5,5 0 1 0 14,10 M14,5 L14,1 L18,1"
                                  Stretch="Uniform"
                                  Stroke="#3156D4"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <TextBlock Text="Refresh"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,8,0"
                            Click="FitButton_Click"
                            Style="{StaticResource GraphToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13"
                                  Height="13"
                                  Data="M3,7 L3,3 L7,3 M13,3 L17,3 L17,7 M17,13 L17,17 L13,17 M7,17 L3,17 L3,13"
                                  Stretch="Uniform"
                                  Stroke="#3156D4"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <TextBlock Text="Fit"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="GraphSettingsButton"
                            Click="GraphSettingsButton_Click"
                            Style="{StaticResource GraphPrimaryButtonStyle}">
                        <TextBlock Text="Settings" />
                    </Button>

                    <Popup x:Name="GraphSettingsPopup"
                           PlacementTarget="{Binding ElementName=GraphSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Closed="GraphSettingsPopup_Closed">
                        <Border Width="250"
                                Margin="0,5,0,0"
                                Padding="12"
                                Background="#FFFFFF"
                                BorderBrush="#DCE3F0"
                                BorderThickness="1"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#24304A"
                                                  Opacity="0.14"
                                                  BlurRadius="18"
                                                  ShadowDepth="6" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Depth (1-4)"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBox Grid.Column="1"
                                         HorizontalAlignment="Right"
                                         Style="{StaticResource GraphInputStyle}"
                                         Text="{Binding NeighborDepthText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="GraphSettingsTextBox_KeyDown" />

                                <TextBlock Grid.Row="2"
                                           Text="Max nodes"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         HorizontalAlignment="Right"
                                         Style="{StaticResource GraphInputStyle}"
                                         Text="{Binding MaxNodesText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="GraphSettingsTextBox_KeyDown" />
                            </Grid>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <views:GraphCanvas x:Name="GraphSurface"
                               Graph="{Binding Graph}"
                               FocusedDocumentId="{Binding FocusedDocumentId}"
                               OpenNodeCommand="{Binding OpenNodeCommand}" />

            <Border Margin="0"
                    Background="#EAF0FF"
                    Opacity="0.88">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldShowState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <StackPanel MaxWidth="460"
                        Margin="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldShowState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding StateTitle}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StateMessage}"
                           Margin="0,8,0,18"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}" />
                <Button Width="118"
                        HorizontalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GraphToolbarButtonStyle}">
                    <TextBlock Text="Refresh" />
                </Button>
            </StackPanel>

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="18"
                    Padding="12,7"
                    Background="#FFFFFF"
                    BorderBrush="#DCE3F0"
                    BorderThickness="1"
                    CornerRadius="7">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#2F6F4F" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
