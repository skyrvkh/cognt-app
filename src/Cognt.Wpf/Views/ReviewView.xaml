<UserControl x:Class="CogntApp.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="980"
             d:DesignWidth="1680"
             Background="{DynamicResource PageBrush}"
             Loaded="ReviewView_Loaded"
             SizeChanged="ReviewView_SizeChanged"
             PreviewKeyDown="ReviewView_PreviewKeyDown"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="ReviewRatingButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="108" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ButtonTemplateTextForegroundStyle}" />
                                <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource ButtonTemplateAccessTextForegroundStyle}" />
                            </Border.Resources>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PanelAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShortcutKeyStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelBrush}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HeaderTitle"
                           Text="Flashcards"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource InkBrush}"
                           FontSize="22"
                           FontWeight="SemiBold" />

                <StackPanel x:Name="HeaderTabs"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Review"
                            Click="ExitReview_Click"
                            Margin="0,0,28,0"
                            Style="{StaticResource HeaderTabButtonStyle}" />
                    <Button Content="Cards"
                            Click="ExitReview_Click"
                            Margin="0,0,28,0"
                            Style="{StaticResource HeaderTabButtonStyle}" />
                    <Button Content="Statistics"
                            Click="ExitReview_Click"
                            Style="{StaticResource HeaderTabButtonStyle}" />
                </StackPanel>

                <Button x:Name="ExitReviewButton"
                        Grid.Column="4"
                        Width="128"
                        Height="38"
                        Click="ExitReview_Click"
                        VerticalAlignment="Center"
                        Style="{StaticResource OutlineButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ExitReviewGlyph"
                                   Text="x"
                                   Margin="0,0,8,0"
                                   FontSize="15" />
                        <TextBlock x:Name="ExitReviewLabel"
                                   Text="Exit Review" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False">
            <Grid x:Name="StageContainer"
                  Margin="36,26,36,30">
                <Grid x:Name="StageRoot"
                      MaxWidth="1520"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="StageGapAfterSummaryRow" Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="StageGapBeforeShortcutsRow" Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="StageGapBeforeRatingsRow" Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="QueueSummaryStrip"
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            Padding="14,10"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource PanelBrush}">
                        <WrapPanel HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock x:Name="QueueLearningText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <TextBlock x:Name="QueueRelearningText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <TextBlock x:Name="QueueOverdueText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <TextBlock x:Name="QueueDueText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <TextBlock x:Name="QueueFutureText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <TextBlock x:Name="QueueNewText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <TextBlock x:Name="QueueSuspendedText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <TextBlock x:Name="QueueLimitedText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <TextBlock x:Name="QueueTotalText"
                                       Margin="8,0"
                                       Foreground="{DynamicResource InkBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="CramMasteredText"
                                       Margin="8,0"
                                       Foreground="{DynamicResource InkBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="CramRemainingText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="CramCurrentProgressText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="CramAttemptsText"
                                       Margin="8,0"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       Visibility="Collapsed" />
                        </WrapPanel>
                    </Border>

                    <Border x:Name="CardContext"
                            Grid.Row="2"
                            Height="660"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22"
                                              Direction="270"
                                              Opacity="0.12"
                                              ShadowDepth="6"
                                              Color="{DynamicResource ShadowColor}" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="CardHeaderRow" Height="76" />
                                <RowDefinition Height="*" />
                                <RowDefinition x:Name="CardFooterRow" Height="124" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="CardSideLabel"
                                       Text="FRONT"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />

                            <Grid x:Name="ReviewCardContentHost"
                                  Grid.Row="1"
                                  Margin="84,6,84,0">
                                <TextBlock x:Name="ReviewCardText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="1180"
                                           Foreground="{DynamicResource InkBrush}"
                                           FontSize="34"
                                           FontWeight="SemiBold"
                                           LineHeight="43"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="ReviewCardMultimodalHost"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="1180"
                                            Visibility="Collapsed">
                                    <RichTextBox x:Name="ReviewCardRichText"
                                                 IsReadOnly="True"
                                                 IsDocumentEnabled="False"
                                                 Focusable="False"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 Background="Transparent"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 MinWidth="120"
                                                 MaxWidth="1180" />
                                    <Border x:Name="ReviewCardImageContainer"
                                            Margin="0,22,0,0"
                                            Padding="10"
                                            Background="{DynamicResource PanelAltBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Visibility="Collapsed"
                                            MaxWidth="860"
                                            MaxHeight="320">
                                        <Grid x:Name="ReviewCardImageHost"
                                              SizeChanged="ReviewCardImageHost_SizeChanged">
                                            <Image x:Name="ReviewCardImage"
                                                   Stretch="Uniform" />
                                            <Canvas x:Name="ReviewCardMaskCanvas"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    BorderBrush="{DynamicResource LineSoftBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <StackPanel x:Name="RevealPromptPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <WrapPanel x:Name="RevealPromptMessage"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,14"
                                                   MaxWidth="420">
                                            <Border Width="30"
                                                    Height="30"
                                                    CornerRadius="15"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="?"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="Think before revealing the answer"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource MutedBrush}"
                                                      FontSize="14"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap" />
                                        </WrapPanel>
                                        <Button x:Name="RevealAnswerButton"
                                                Width="320"
                                                MinWidth="180"
                                                MaxWidth="320"
                                                Height="50"
                                                Command="{Binding RevealAnswerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource PrimaryButtonStyle}">
                                            <TextBlock Text="Reveal (Space)"
                                                        Foreground="{DynamicResource VibrantButtonForegroundBrush}"
                                                       HorizontalAlignment="Center"
                                                        />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel x:Name="AnswerStatePanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <TextBlock Text="Answer revealed"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Choose a recall rating below"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="14"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel x:Name="WaitingStatePanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="WaitingStateTitleText"
                                                   Text="No cards are due right now"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="WaitingStateDetailText"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="14"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="CompletionSummaryText"
                                                   Margin="0,12,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="13"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="ShortcutStrip"
                            Grid.Row="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="18,0"
                            Height="40"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource PanelBrush}">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Key"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock Text="Use keyboard shortcuts"
                                       Margin="8,0,18,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" />
                            <Border Style="{StaticResource ShortcutKeyStyle}">
                                <TextBlock Text="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="11" />
                            </Border>
                            <TextBlock Text="Again"
                                       Margin="7,0,14,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <Border Style="{StaticResource ShortcutKeyStyle}">
                                <TextBlock Text="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource OrangeBrush}"
                                           FontSize="11" />
                            </Border>
                            <TextBlock Text="Hard"
                                       Margin="7,0,14,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <Border Style="{StaticResource ShortcutKeyStyle}">
                                <TextBlock Text="3"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource BlueBrush}"
                                           FontSize="11" />
                            </Border>
                            <TextBlock Text="Good"
                                       Margin="7,0,14,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <Border Style="{StaticResource ShortcutKeyStyle}">
                                <TextBlock Text="4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource GreenBrush}"
                                           FontSize="11" />
                            </Border>
                            <TextBlock Text="Easy"
                                       Margin="7,0,0,0"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                        </StackPanel>
                    </Border>

                    <UniformGrid x:Name="RatingsPanel"
                                 Grid.Row="6"
                                 Columns="4"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center">
                        <Button Margin="6"
                                Command="{Binding RateAgainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Background="{DynamicResource ReviewAgainSurfaceBrush}"
                                BorderBrush="{DynamicResource ReviewAgainLineBrush}"
                                Style="{StaticResource ReviewRatingButtonStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Border Width="32"
                                            Height="28"
                                            CornerRadius="6"
                                            BorderBrush="{DynamicResource ReviewAgainLineBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource PanelBrush}">
                                        <TextBlock Text="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource RedBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="Again (1)"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource RedBrush}"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="Incorrect"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button Margin="6"
                                Command="{Binding RateHardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Background="{DynamicResource ReviewHardSurfaceBrush}"
                                BorderBrush="{DynamicResource ReviewHardLineBrush}"
                                Style="{StaticResource ReviewRatingButtonStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Border Width="32"
                                            Height="28"
                                            CornerRadius="6"
                                            BorderBrush="{DynamicResource ReviewHardLineBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource PanelBrush}">
                                        <TextBlock Text="2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OrangeBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="Hard (2)"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource OrangeBrush}"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="Difficult"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button Margin="6"
                                Command="{Binding RateGoodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Background="{DynamicResource ReviewGoodSurfaceBrush}"
                                BorderBrush="{DynamicResource ReviewGoodLineBrush}"
                                Style="{StaticResource ReviewRatingButtonStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Border Width="32"
                                            Height="28"
                                            CornerRadius="6"
                                            BorderBrush="{DynamicResource ReviewGoodLineBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource PanelBrush}">
                                        <TextBlock Text="3"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BlueBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="Good (3)"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BlueBrush}"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="Correct"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button Margin="6"
                                Command="{Binding RateEasyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Background="{DynamicResource ReviewEasySurfaceBrush}"
                                BorderBrush="{DynamicResource ReviewEasyLineBrush}"
                                Style="{StaticResource ReviewRatingButtonStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Border Width="32"
                                            Height="28"
                                            CornerRadius="6"
                                            BorderBrush="{DynamicResource ReviewEasyLineBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource PanelBrush}">
                                        <TextBlock Text="4"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource GreenBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="Easy (4)"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GreenBrush}"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="Very easy"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="13" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="CramCompletionOverlay"
              Grid.RowSpan="2"
              Background="#990F172A"
              Visibility="Collapsed">
            <Border Width="520"
                    MaxWidth="620"
                    MaxHeight="680"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36"
                                      Direction="270"
                                      Opacity="0.22"
                                      ShadowDepth="10"
                                      Color="{DynamicResource ShadowColor}" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Cram session complete"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock Text="Every valid selected card reached the configured mastery target."
                               Grid.Row="1"
                               Margin="0,8,0,18"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2"
                                  MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="CramCompletionSummaryText"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="14"
                                   LineHeight="24"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <Button Grid.Row="3"
                            Width="140"
                            Height="40"
                            Margin="0,22,0,0"
                            HorizontalAlignment="Center"
                            Click="ExitReview_Click"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <TextBlock Text="Close"
                                    Foreground="{DynamicResource VibrantButtonForegroundBrush}"
                                   HorizontalAlignment="Center"
                                    />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
