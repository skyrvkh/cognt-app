<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="AppSansFontFamily">Inter</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Source Serif 4</FontFamily>
    <FontFamily x:Key="AppReadingFontFamily">Source Serif 4</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Recursive</FontFamily>

    <sys:Double x:Key="FontSizeMicro">10</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">14</sys:Double>
    <sys:Double x:Key="FontSizePanelTitle">17</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">28</sys:Double>
    <sys:Double x:Key="FontSizeHero">34</sys:Double>

    <sys:Double x:Key="LineHeightTight">17</sys:Double>
    <sys:Double x:Key="LineHeightBody">20</sys:Double>
    <sys:Double x:Key="LineHeightLarge">23</sys:Double>
    <sys:Double x:Key="LineHeightTitle">30</sys:Double>
    <sys:Double x:Key="LineHeightHero">42</sys:Double>

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="{DynamicResource AppSansFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="FontFamily" Value="{DynamicResource AppSansFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource AppSansFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                         Value="True">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <PriorityBinding>
                            <Binding Path="Foreground"
                                     RelativeSource="{RelativeSource AncestorType={x:Type ButtonBase}}" />
                            <Binding Path="Foreground"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Control}}" />
                        </PriorityBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                         Value="False">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <PriorityBinding>
                            <Binding Path="Foreground"
                                     RelativeSource="{RelativeSource AncestorType={x:Type ButtonBase}}" />
                            <Binding Path="Foreground"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Control}}" />
                        </PriorityBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type AccessText}">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                         Value="True">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <PriorityBinding>
                            <Binding Path="Foreground"
                                     RelativeSource="{RelativeSource AncestorType={x:Type ButtonBase}}" />
                            <Binding Path="Foreground"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Control}}" />
                        </PriorityBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                         Value="False">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <PriorityBinding>
                            <Binding Path="Foreground"
                                     RelativeSource="{RelativeSource AncestorType={x:Type ButtonBase}}" />
                            <Binding Path="Foreground"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Control}}" />
                        </PriorityBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonTemplateTextForegroundStyle" TargetType="TextBlock">
        <Setter Property="Foreground">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground"
                             RelativeSource="{RelativeSource AncestorType={x:Type ButtonBase}}" />
                    <Binding Path="Foreground"
                             RelativeSource="{RelativeSource AncestorType={x:Type Control}}" />
                </PriorityBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonTemplateAccessTextForegroundStyle" TargetType="AccessText">
        <Setter Property="Foreground">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground"
                             RelativeSource="{RelativeSource AncestorType={x:Type ButtonBase}}" />
                    <Binding Path="Foreground"
                             RelativeSource="{RelativeSource AncestorType={x:Type Control}}" />
                </PriorityBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VibrantButtonTemplateTextForegroundStyle" TargetType="TextBlock">
        <Setter Property="Foreground">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground"
                             RelativeSource="{RelativeSource AncestorType={x:Type ButtonBase}}" />
                </PriorityBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VibrantButtonTemplateAccessTextForegroundStyle" TargetType="AccessText">
        <Setter Property="Foreground">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground"
                             RelativeSource="{RelativeSource AncestorType={x:Type ButtonBase}}" />
                </PriorityBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTitle}" />
    </Style>

    <Style x:Key="AppPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppDisplayTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizePageTitle}" />
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightHero}" />
    </Style>

    <Style x:Key="AppTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppDisplayTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTitle}" />
    </Style>

    <Style x:Key="AppBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppSansFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}" />
    </Style>

    <Style x:Key="AppReadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppBodyTextStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource AppReadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}" />
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightLarge}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppSansFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}" />
    </Style>

    <Style x:Key="AppMonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}" />
    </Style>
</ResourceDictionary>
