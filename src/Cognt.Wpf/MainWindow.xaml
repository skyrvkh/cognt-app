<Window x:Class="CogntApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CogntApp"
        xmlns:views="clr-namespace:CogntApp.Views"
        xmlns:viewModels="clr-namespace:CogntApp.ViewModels"
        mc:Ignorable="d"
        Title="Cognt App" Height="860" Width="1320" MinHeight="720" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFF"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#78809A" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#586078" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                    <Setter Property="Foreground" Value="#3156D4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimarySidebarButtonStyle"
               BasedOn="{StaticResource SidebarButtonStyle}"
               TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8DEEC" />
            <Setter Property="Foreground" Value="#3156D4" />
        </Style>

        <Style x:Key="NoteTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#586078" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8DEEC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                    <Setter Property="BorderBrush" Value="#CBD6FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F7F9FC"
          ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="300" />
            <ColumnDefinition x:Name="SidebarSplitterColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="2"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MobileHeaderRow" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="MobileHeader"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#F7F9FC"
                    BorderBrush="#E1E6F0"
                    BorderThickness="0,0,0,1"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource SidebarIconButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16"
                                  Height="16"
                                  Data="M3,5 L21,5 M3,12 L21,12 M3,19 L15,19"
                                  Stroke="#1F2433"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                            <TextBlock Text="Menu"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2433" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="28"
                                Height="28"
                                Background="#EEF2FF"
                                CornerRadius="8">
                            <TextBlock Text="*"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#4C6FFF" />
                        </Border>
                        <TextBlock Text="Cognt"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2433" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MainContentSplitRoot"
                  Grid.Row="1"
                  ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PrimaryContentColumn"
                                      Width="*"
                                      MinWidth="0" />
                    <ColumnDefinition x:Name="RightViewerSplitterColumn"
                                      Width="0" />
                    <ColumnDefinition x:Name="RightViewerColumn"
                                      Width="0"
                                      MinWidth="0" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      ClipToBounds="True">
                    <ContentControl x:Name="EditorViewHost" />

                    <ContentControl x:Name="OverlayHost"
                                    Panel.ZIndex="10" />
                </Grid>

                <GridSplitter x:Name="RightViewerSplitter"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#E1E6F0"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              Visibility="Collapsed" />

                <Border x:Name="RightViewerPane"
                        Grid.Column="2"
                        Background="#FFFFFF"
                        BorderBrush="#E1E6F0"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Background="#F7F9FC"
                              Margin="0"
                              VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="RightViewerTitleText"
                                       Grid.Column="0"
                                       Margin="14,0,8,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2433" />
                        </Grid>

                        <ContentControl x:Name="RightViewerContentHost"
                                        Grid.Row="1" />

                        <Border x:Name="RightViewerDropOverlay"
                                Grid.RowSpan="2"
                                Background="#CCEEF2FF"
                                BorderBrush="#7C8FB8"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                Panel.ZIndex="2">
                            <TextBlock Text="Drop PDF to open"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#24324F" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel x:Name="RightViewerHangingButtons"
                            Grid.Column="0"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,18,18,0"
                            Panel.ZIndex="11">
                    <Button Content="Cards"
                            Width="72"
                            Height="30" />
                </StackPanel>
            </Grid>
        </Grid>

        <Button x:Name="SidebarBackdrop"
                Grid.ColumnSpan="3"
                Visibility="Collapsed"
                Opacity="0"
                IsHitTestVisible="False"
                Background="#66141B2D"
                BorderThickness="0"
                Panel.ZIndex="15" />

        <Border x:Name="SidebarHost"
                Grid.Column="0"
                Width="300"
                HorizontalAlignment="Left"
                Background="#FBFCFF"
                BorderBrush="#E1E6F0"
                BorderThickness="0,0,1,0"
                Padding="12,14"
                Panel.ZIndex="20">
            <Border.Effect>
                <DropShadowEffect x:Name="SidebarShadowEffect"
                                  BlurRadius="28"
                                  ShadowDepth="0"
                                  Color="#22000000"
                                  Opacity="0.45" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarSheetTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="SidebarHeader"
                      Grid.Row="0"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="28"
                            Height="28"
                            Background="#EEF2FF"
                            CornerRadius="8">
                        <TextBlock Text="*"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#4C6FFF" />
                    </Border>
                    <TextBlock x:Name="SidebarBrandText"
                               Grid.Column="1"
                               Text="Cognt"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2433" />
                    <Button x:Name="SidebarToggleButton"
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Click="SidebarToggleButton_Click">
                        <Path x:Name="SidebarToggleIcon"
                              Width="14"
                              Height="14"
                              Data="M11.5,4 L5.5,10 L11.5,16"
                              Stroke="#586078"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform" />
                    </Button>
                </Grid>

                <StackPanel x:Name="SidebarTopNavigationSection"
                            Grid.Row="1">
                    <TextBlock Text="COLLECTION"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="8,0,0,8" />

                    <TextBox x:Name="NotesDirectoryTextBox"
                             Height="32"
                             Margin="0,0,0,8"
                             Padding="10,4"
                             Background="#FFFFFF"
                             BorderBrush="#D8DEEC"
                             Foreground="#586078"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Text="{Binding CollectionPath, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Load Collection"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,10"
                            Command="{Binding LoadCollectionCommand}" />
                </StackPanel>

                <ScrollViewer x:Name="SidebarScrollContent"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Content="Dashboard"
                                Style="{StaticResource PrimarySidebarButtonStyle}"
                                Margin="0,0,0,8"
                                Command="{Binding ShowDashboardCommand}" />
                        <Button Content="All Documents"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowAllNotesCommand}" />
                        <Button Content="Flashcards"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowDecksCommand}" />
                        <Button Content="Cards from note"
                                Style="{StaticResource SidebarButtonStyle}" />
                        <Button Content="Browser"
                                Style="{StaticResource SidebarButtonStyle}" />

                        <Border Height="1"
                                Background="#E1E6F0"
                                Margin="8,14,8,12" />

                        <TreeView x:Name="NotesTree"
                                  BorderThickness="0"
                                  Margin="0"
                                  Background="Transparent"
                                  FontSize="13"
                                  Foreground="#586078"
                                  AllowDrop="True"
                                  ItemsSource="{Binding NoteRoots}"
                                  PreviewKeyDown="NotesTree_PreviewKeyDown"
                                  PreviewMouseLeftButtonDown="NotesTree_PreviewMouseLeftButtonDown"
                                  PreviewMouseDoubleClick="NotesTree_PreviewMouseDoubleClick"
                                  PreviewMouseRightButtonDown="NotesTree_PreviewMouseRightButtonDown"
                                  PreviewMouseMove="NotesTree_PreviewMouseMove"
                                  DragOver="NotesTree_DragOver"
                                  Drop="NotesTree_Drop"
                                  SelectedItemChanged="NotesTree_SelectedItemChanged">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New Folder"
                                              Click="NewFolderTreeItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Delete"
                                              Click="DeleteTreeItem_Click" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type viewModels:NoteTreeNodeViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal"
                                                MinHeight="24">
                                        <TextBlock Text="{Binding Prefix}"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#586078" />
                                        <Grid MinWidth="96">
                                            <TextBlock Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding EditingTitle, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="110"
                                                     Height="24"
                                                     Padding="4,1"
                                                     BorderBrush="#CBD6FF"
                                                     Background="#FFFFFF"
                                                     Foreground="#1F2433"
                                                     VerticalContentAlignment="Center"
                                                     IsVisibleChanged="TreeRenameTextBox_IsVisibleChanged"
                                                     LostKeyboardFocus="TreeRenameTextBox_LostKeyboardFocus"
                                                     PreviewKeyDown="TreeRenameTextBox_PreviewKeyDown">
                                                <TextBox.Style>
                                                    <Style TargetType="{x:Type TextBox}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}"
                                       BasedOn="{StaticResource NoteTreeViewItemStyle}">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="AllowDrop"
                                            Value="True" />
                                    <EventSetter Event="Expanded"
                                                 Handler="NotesTreeItem_Expanded" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="SidebarFooterSection"
                            Grid.Row="3"
                            Margin="0,14,0,0">
                    <Button Content="+ Create Document"
                            Style="{StaticResource PrimarySidebarButtonStyle}"
                            Command="{Binding AddNoteCommand}" />
                    <Button Content="Import Documents"
                            Style="{StaticResource PrimarySidebarButtonStyle}"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter x:Name="SidebarSplitter"
                      Grid.Column="1"
                      Width="6"
                      Visibility="Collapsed" />

        <Button x:Name="FloatingNavigationButton"
                Grid.Column="2"
                Visibility="Collapsed" />

        <Popup x:Name="CollectionSelectorPopup" />
    </Grid>
</Window>
