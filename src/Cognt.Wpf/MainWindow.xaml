<Window x:Class="CogntApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CogntApp"
        xmlns:views="clr-namespace:CogntApp.Views"
        xmlns:viewModels="clr-namespace:CogntApp.ViewModels"
        xmlns:xcad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:xcadLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Cognt App" Height="860" Width="1320" MinHeight="720" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{DynamicResource PageBrush}"
        FontFamily="{StaticResource AppSansFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <sys:Double x:Key="EditorBreadcrumbFontSize">11</sys:Double>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimarySidebarButtonStyle"
               BasedOn="{StaticResource SidebarButtonStyle}"
               TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
        </Style>

        <Style x:Key="NoteTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <Style x:Key="NavigationTreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ExpanderBorder"
                                Width="10"
                                Height="24"
                                Background="Transparent"
                                CornerRadius="4">
                            <Path x:Name="ExpanderGlyph"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M3,8 L6.5,12 L3,16"
                                  Stroke="{DynamicResource DimBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpanderGlyph" Property="Data" Value="M1.5,10 L5,14 L8.5,10" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationTreeViewItemStyle"
               TargetType="TreeViewItem"
               BasedOn="{StaticResource NoteTreeViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Margin="0,0,0,0"
                                          VerticalAlignment="Top"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Style="{StaticResource NavigationTreeExpanderStyle}" />

                            <Border x:Name="ItemBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="{TemplateBinding Margin}"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  ContentSource="Header"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavigationPathStyle" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="NoteTreeNodePathStyle" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource FolderStrokeBrush}" />
            <Setter Property="Fill" Value="{DynamicResource FolderFillBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Data" Value="M2.5,6.8 L8,6.8 L9.8,8.7 L21.5,8.7 L21.5,18.5 L2.5,18.5 Z" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Prefix}" Value="[N]">
                    <Setter Property="Stroke" Value="{DynamicResource AccentStrongBrush}" />
                    <Setter Property="Fill" Value="{DynamicResource NoteFillBrush}" />
                    <Setter Property="Data" Value="M6,3.5 L14,3.5 L18,7.5 L18,20.5 L6,20.5 Z M14,3.5 L14,8 L18,8 M8.8,12 L15.2,12 M8.8,15 L15.2,15" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Prefix}" Value="[PDF]">
                    <Setter Property="Stroke" Value="{DynamicResource PdfStrokeBrush}" />
                    <Setter Property="Fill" Value="{DynamicResource PdfFillBrush}" />
                    <Setter Property="Data" Value="M6,3.5 L14,3.5 L18,7.5 L18,20.5 L6,20.5 Z M14,3.5 L14,8 L18,8 M8.5,12.2 L15.5,12.2 M8.5,15.2 L14,15.2 M8.5,18.2 L12.8,18.2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarCollectionSelectorButtonStyle"
               BasedOn="{StaticResource SidebarButtonStyle}"
               TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SidebarSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center" />
                            <TextBlock Margin="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DimBrush}"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationTreeItemTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CollectionPopoverButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CollectionSwitcherRowButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CollectionSwitcherPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CollectionSwitcherDangerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorBreadcrumbButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource EditorBreadcrumbFontSize}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorBreadcrumbTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource EditorBreadcrumbFontSize}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource PageBrush}"
          ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn"
                              Width="264"
                              MinWidth="240"
                              MaxWidth="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarHost"
                Grid.Column="0"
                MinWidth="240"
                MaxWidth="320"
                Background="{DynamicResource SidebarSurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0"
                Padding="10,12"
                Panel.ZIndex="20">
            <Border.Effect>
                <DropShadowEffect x:Name="SidebarShadowEffect"
                                  BlurRadius="28"
                                  ShadowDepth="0"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="0.45" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="SidebarHeader"
                      Grid.Row="0"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/icon.png"
                               Width="34"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="SidebarBrandText"
                               Grid.Column="1"
                               Text="Cognt"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppDisplayFontFamily}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel x:Name="SidebarTopNavigationSection"
                            Grid.Row="1">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource PrimarySidebarButtonStyle}"
                                    AutomationProperties.Name="Dashboard"
                                    Command="{Binding ShowDashboardCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,12 L12,5 L20,12 M6.5,10.5 L6.5,19 L17.5,19 L17.5,10.5"
                                          Style="{StaticResource SidebarNavigationPathStyle}" />
                                    <TextBlock Text="Dashboard"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Width="34"
                                    Height="34"
                                    ToolTip="Flashcards"
                                    AutomationProperties.Name="Flashcards"
                                    Style="{StaticResource SidebarIconButtonStyle}"
                                    Command="{Binding ShowDecksCommand}">
                                <Path Data="M5,8.5 L17.8,4.5 L20.5,13 L7.6,17 Z M4,11 L16.8,11 L16.8,20 L4,20 Z M7,14 L13.5,14"
                                      Width="17"
                                      Height="17"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource AccentStrongBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Button>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Border x:Name="SidebarSearchBox"
                                    MinHeight="34"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Path Width="16"
                                          Height="16"
                                          Margin="12,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource DimBrush}"
                                          StrokeThickness="1.8"
                                          Data="M10.5,10.5 L15,15 M12,6.5 A5.5,5.5 0 1 1 1,6.5 A5.5,5.5 0 1 1 12,6.5 Z" />
                                    <TextBox x:Name="SidebarSearchTextBox"
                                             Margin="36,0,8,0"
                                             Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Search notes"
                                             ToolTip="Search notes"
                                             AutomationProperties.Name="Search notes"
                                             Style="{StaticResource SidebarSearchTextBoxStyle}"
                                             GotKeyboardFocus="SidebarSearchTextBox_GotKeyboardFocus"
                                             PreviewKeyDown="SidebarSearchTextBox_PreviewKeyDown" />
                                </Grid>
                            </Border>

                            <Popup PlacementTarget="{Binding ElementName=SidebarSearchBox}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsGlobalSearchPopupOpen, Mode=TwoWay}">
                                <Border Width="{Binding ActualWidth, ElementName=SidebarSearchBox}"
                                        MaxHeight="310"
                                        Margin="0,4,0,0"
                                        Padding="6"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="6"
                                                          Direction="270"
                                                          Opacity="0.16"
                                                          Color="{DynamicResource ShadowColor}" />
                                    </Border.Effect>
                                    <Grid>
                                        <Border Padding="8"
                                                Background="{DynamicResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGlobalSearchLoading}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Searching..."
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </Border>

                                        <Border Padding="8"
                                                Background="{DynamicResource DangerSurfaceBrush}"
                                                BorderBrush="{DynamicResource DangerLineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasGlobalSearchError}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding GlobalSearchErrorMessage}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource DangerBrush}" />
                                                <Button Grid.Column="1"
                                                        Content="Retry"
                                                        Margin="6,0,0,0"
                                                        Padding="6,2"
                                                        Command="{Binding RetryGlobalSearchCommand}" />
                                            </Grid>
                                        </Border>

                                        <Border Padding="8"
                                                Background="{DynamicResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShouldShowGlobalSearchState}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding GlobalSearchStateMessage}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </Border>

                                        <ScrollViewer MaxHeight="280"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ScrollViewer.Style>
                                                <Style TargetType="{x:Type ScrollViewer}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShouldShowGlobalSearchResults}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <ItemsControl ItemsSource="{Binding GlobalSearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource CollectionPopoverButtonStyle}"
                                                                Command="{Binding DataContext.OpenGlobalSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource InkBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Title}" />
                                                                <TextBlock Text="{Binding Snippet}"
                                                                           Margin="0,3,0,0"
                                                                           TextWrapping="Wrap"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           MaxHeight="48" />
                                                                <TextBlock Text="{Binding CollectionName}"
                                                                           Margin="0,3,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource DimBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding CollectionName}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource LineBrush}"
                                Margin="6,10,6,10" />
                </StackPanel>

                <ScrollViewer x:Name="SidebarScrollContent"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                                <TreeView x:Name="NotesTree"
                                          BorderThickness="0"
                                          Margin="0"
                                          Background="Transparent"
                                          FontSize="13"
                                          Foreground="{DynamicResource MutedBrush}"
                                          AllowDrop="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ItemsSource="{Binding NoteRoots}"
                                          PreviewKeyDown="NotesTree_PreviewKeyDown"
                                      PreviewMouseLeftButtonDown="NotesTree_PreviewMouseLeftButtonDown"
                                      PreviewMouseDoubleClick="NotesTree_PreviewMouseDoubleClick"
                                      PreviewMouseRightButtonDown="NotesTree_PreviewMouseRightButtonDown"
                                      PreviewMouseMove="NotesTree_PreviewMouseMove"
                                      DragOver="NotesTree_DragOver"
                                      Drop="NotesTree_Drop"
                                      SelectedItemChanged="NotesTree_SelectedItemChanged">
                                <TreeView.ContextMenu>
                                    <ContextMenu Opened="NotesTreeContextMenu_Opened">
                                        <MenuItem Header="New Folder"
                                                  Click="NewFolderTreeItem_Click" />
                                        <MenuItem x:Name="DuplicateTreeMenuItem"
                                                  Header="Duplicate"
                                                  Click="DuplicateTreeItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Delete"
                                                  Click="DeleteTreeItem_Click" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type viewModels:NoteTreeNodeViewModel}"
                                                              ItemsSource="{Binding Children}">
                                        <Grid MinHeight="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Style="{StaticResource NoteTreeNodePathStyle}" />
                                            <Grid Grid.Column="1"
                                                  MinWidth="0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           ToolTip="{Binding Title}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}"
                                                               BasedOn="{StaticResource NavigationTreeItemTextStyle}">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRenaming}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding EditingTitle, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="110"
                                                        Height="24"
                                                        Padding="4,1"
                                                         FontSize="13"
                                                         BorderBrush="{DynamicResource AccentBrush}"
                                                         Background="{DynamicResource PanelBrush}"
                                                         Foreground="{DynamicResource InkBrush}"
                                                         VerticalContentAlignment="Center"
                                                         IsVisibleChanged="TreeRenameTextBox_IsVisibleChanged"
                                                         LostKeyboardFocus="TreeRenameTextBox_LostKeyboardFocus"
                                                         PreviewKeyDown="TreeRenameTextBox_PreviewKeyDown">
                                                    <TextBox.Style>
                                                        <Style TargetType="{x:Type TextBox}">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRenaming}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}"
                                           BasedOn="{StaticResource NavigationTreeViewItemStyle}">
                                        <Setter Property="IsExpanded"
                                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="AllowDrop"
                                                Value="True" />
                                        <EventSetter Event="Expanded"
                                                    Handler="NotesTreeItem_Expanded" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                            <Border Padding="10"
                                    Background="{DynamicResource PanelAltBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShouldShowNoNotesState}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="No documents"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="Create a document to start this collection."
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource DimBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="SidebarFooterSection"
                      Grid.Row="3"
                      Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource PrimarySidebarButtonStyle}"
                                AutomationProperties.Name="New note"
                                Command="{Binding AddNoteCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6,3.5 L14,3.5 L18,7.5 L18,20.5 L6,20.5 Z M14,3.5 L14,8 L18,8 M9,13 L15,13 M12,10 L12,16"
                                      Style="{StaticResource SidebarNavigationPathStyle}" />
                                <TextBlock Text="New note"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource PrimarySidebarButtonStyle}"
                                AutomationProperties.Name="Import"
                                Click="ImportButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,4 L12,15 M7.5,10.5 L12,15 L16.5,10.5 M5,18.5 L19,18.5"
                                      Style="{StaticResource SidebarNavigationPathStyle}" />
                                <TextBlock Text="Import"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="CollectionSelectorButton"
                                Style="{StaticResource SidebarCollectionSelectorButtonStyle}"
                                AutomationProperties.Name="Current collection"
                                ToolTip="Select collection"
                                Click="CollectionSelectorButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path Data="M2.5,6.8 L8,6.8 L9.8,8.7 L21.5,8.7 L21.5,18.5 L2.5,18.5 Z"
                                      Width="16"
                                      Height="16"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource AccentStrongBrush}"
                                      Fill="{DynamicResource NoteFillBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentCollectionName}"
                                           Margin="8,0,6,0"
                                           VerticalAlignment="Center"
                                           FontSize="{Binding GlobalTextFontSize}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentCollectionName}" />
                                <Path Grid.Column="2"
                                      Data="M5,8 L10,13 L15,8"
                                      Width="12"
                                      Height="12"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Grid>
                        </Button>

                        <Popup x:Name="CollectionSelectorPopup"
                               PlacementTarget="{Binding ElementName=CollectionSelectorButton}"
                               Placement="Top"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <Border Width="{Binding ActualWidth, ElementName=SidebarFooterSection}"
                                    MaxHeight="430"
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="26"
                                                      ShadowDepth="0"
                                                      Color="{DynamicResource ShadowColor}"
                                                      Opacity="0.34" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="38"
                                                Height="38"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <Path Data="M2.5,6.8 L8,6.8 L9.8,8.7 L21.5,8.7 L21.5,18.5 L2.5,18.5 Z"
                                                  Width="19"
                                                  Height="19"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource AccentStrongBrush}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Collections"
                                                       FontFamily="{StaticResource AppDisplayFontFamily}"
                                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}" />
                                            <TextBlock Text="Switch workspace or create a new one."
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Margin="0,12,0,10"
                                            Padding="11"
                                            Background="{DynamicResource PanelAltBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30"
                                                    Height="30"
                                                    Background="{DynamicResource NoteFillBrush}"
                                                    BorderBrush="{DynamicResource AccentSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <Path Data="M2.5,6.8 L8,6.8 L9.8,8.7 L21.5,8.7 L21.5,18.5 L2.5,18.5 Z"
                                                      Width="15"
                                                      Height="15"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Stroke="{DynamicResource AccentStrongBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="9,0,0,0">
                                               <TextBlock Text="Active collection"
                                                           FontSize="{StaticResource FontSizeMicro}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DimBrush}" />
                                                <TextBlock Text="{Binding CurrentCollectionName}"
                                                           Margin="0,3,0,0"
                                                           FontSize="{Binding GlobalTextFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding CurrentCollectionName}" />
                                                <TextBlock Text="{Binding CurrentCollectionSummary}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding OpenCollectionPath}"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DimBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding OpenCollectionPath}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2"
                                          Margin="0,0,0,5">
                                        <TextBlock Text="Available"
                                                   HorizontalAlignment="Left"
                                                   FontSize="11"
                                                   FontFamily="{StaticResource AppSansFontFamily}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DimBrush}" />
                                        <TextBlock Text="Click to open"
                                                   HorizontalAlignment="Right"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource DimBrush}" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="3"
                                                  MaxHeight="190"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ScrollViewer.Style>
                                            <Style TargetType="{x:Type ScrollViewer}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAvailableCollections}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ScrollViewer.Style>
                                        <ItemsControl ItemsSource="{Binding AvailableCollections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource CollectionSwitcherRowButtonStyle}"
                                                            AutomationProperties.Name="{Binding Name}"
                                                            Click="CollectionOptionButton_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Width="34"
                                                                    Height="34"
                                                                    VerticalAlignment="Top"
                                                                    Background="{DynamicResource NoteFillBrush}"
                                                                    BorderBrush="{DynamicResource AccentSoftBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10">
                                                                <Path Data="M2.5,6.8 L8,6.8 L9.8,8.7 L21.5,8.7 L21.5,18.5 L2.5,18.5 Z"
                                                                      Width="17"
                                                                      Height="17"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Stretch="Uniform"
                                                                      Stroke="{DynamicResource AccentStrongBrush}"
                                                                      StrokeThickness="1.5"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1"
                                                                        Margin="10,0,8,0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="{Binding DataContext.GlobalTextFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource InkBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Name}" />
                                                                <TextBlock Text="{Binding CountsSummary}"
                                                                           Margin="0,3,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Path}"
                                                                           Margin="0,2,0,0"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource DimBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Path}" />
                                                            </StackPanel>

                                                            <Grid Grid.Column="2"
                                                                  Width="18"
                                                                  Height="18"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,3,0,0">
                                                                <Ellipse Fill="{DynamicResource AccentBrush}">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="{x:Type Ellipse}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <Path Data="M5,9.5 L8,12.5 L13.5,6.5"
                                                                      Stretch="Uniform"
                                                                      Stroke="{DynamicResource OnAccentBrush}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round">
                                                                    <Path.Style>
                                                                        <Style TargetType="{x:Type Path}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border Grid.Row="3"
                                            Padding="12"
                                            Background="{DynamicResource PanelAltBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShouldShowNoCollectionsState}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="No collections yet"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}" />
                                            <TextBlock Text="Create a collection to start organizing notes, PDFs, and cards."
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="4"
                                          Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <Button Style="{StaticResource CollectionSwitcherPrimaryButtonStyle}"
                                                    AutomationProperties.Name="Add collection"
                                                    Click="AddCollectionButton_Click">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Path Data="M12,5 L12,19 M5,12 L19,12"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                    <TextBlock Text="New collection"
                                                               Margin="7,0,0,0"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource CollectionPopoverButtonStyle}"
                                                    AutomationProperties.Name="Open existing collection"
                                                    Margin="0,6,0,0"
                                                    Foreground="{DynamicResource AccentStrongBrush}"
                                                    Click="OpenExistingCollectionButton_Click">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Path Data="M4,7 L9,7 L10.5,9 L20,9 L20,18 L4,18 Z"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                    <TextBlock Text="Open existing"
                                                               Margin="7,0,0,0"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource CollectionSwitcherDangerButtonStyle}"
                                                VerticalAlignment="Top"
                                                ToolTip="Remove current collection"
                                                AutomationProperties.Name="Remove current collection"
                                                Click="RemoveCollectionButton_Click">
                                            <Path Data="M5,5 L13,13 M13,5 L5,13"
                                                  Width="12"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Popup>

                        <Button Grid.Column="2"
                                Width="38"
                                Height="38"
                                ToolTip="Settings"
                                AutomationProperties.Name="Settings"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                Command="{Binding ShowSettingsCommand}">
                            <Grid Width="16" Height="16">
                                <Ellipse Width="6"
                                         Height="6"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Stroke="{DynamicResource AccentStrongBrush}"
                                         StrokeThickness="1.8" />
                                <Path Data="M8,1 L8,3 M8,13 L8,15 M1,8 L3,8 M13,8 L15,8 M3.1,3.1 L4.5,4.5 M11.5,11.5 L12.9,12.9 M12.9,3.1 L11.5,4.5 M4.5,11.5 L3.1,12.9"
                                      Stroke="{DynamicResource AccentStrongBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="MainContentSplitRoot"
              Grid.Column="1"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,6"
                    Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EditorBreadcrumbItems.Count, Mode=OneWay}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding EditorBreadcrumbItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <Button AutomationProperties.Name="{Binding Title}"
                                                    ToolTip="{Binding Title}"
                                                    Click="EditorBreadcrumbButton_Click"
                                                    PreviewKeyDown="EditorBreadcrumbButton_PreviewKeyDown"
                                                    PreviewMouseDoubleClick="EditorBreadcrumbButton_PreviewMouseDoubleClick">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}"
                                                           BasedOn="{StaticResource EditorBreadcrumbButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontSize="{Binding DataContext.GlobalTextFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Button>

                                            <TextBox Text="{Binding EditingTitle, UpdateSourceTrigger=PropertyChanged}"
                                                     IsVisibleChanged="EditorBreadcrumbTextBox_IsVisibleChanged"
                                                     LostKeyboardFocus="EditorBreadcrumbTextBox_LostKeyboardFocus"
                                                     PreviewKeyDown="EditorBreadcrumbTextBox_PreviewKeyDown">
                                                <TextBox.Style>
                                                    <Style TargetType="{x:Type TextBox}"
                                                           BasedOn="{StaticResource EditorBreadcrumbTextBoxStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>

                                        <TextBlock Text="{Binding Separator}"
                                                   Margin="5,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DimBrush}"
                                                   FontSize="{Binding DataContext.GlobalTextFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  AllowDrop="True"
                  DragOver="EditorViewHost_DragOver"
                  Drop="EditorViewHost_Drop">
                <xcad:DockingManager x:Name="WorkspaceDockingManager"
                                     ActiveContentChanged="WorkspaceDockingManager_ActiveContentChanged">
                    <xcad:DockingManager.DocumentHeaderTemplate>
                        <DataTemplate>
                            <Border x:Name="DocumentDockTab"
                                    Padding="2,0"
                                    Background="Transparent"
                                    Cursor="SizeAll"
                                    ToolTip="{Binding Title}"
                                    PreviewMouseLeftButtonDown="NoteDocumentHeader_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="NoteDocumentHeader_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="NoteDocumentHeader_PreviewMouseLeftButtonUp">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Rename"
                                                  Click="RenameNoteTabMenuItem_Click" />
                                        <MenuItem Header="Open in New Window"
                                                  Click="OpenNoteInNewWindowMenuItem_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <TextBlock x:Name="DocumentDockTabTitle"
                                               Text="{Binding Title}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="DocumentDockTabRenameTextBox"
                                             Text="{Binding Title, Mode=OneWay}"
                                             MinWidth="120"
                                             MaxWidth="260"
                                             Visibility="Collapsed"
                                             Style="{StaticResource EditorBreadcrumbTextBoxStyle}"
                                             LostKeyboardFocus="NoteDocumentTabRenameTextBox_LostKeyboardFocus"
                                             PreviewKeyDown="NoteDocumentTabRenameTextBox_PreviewKeyDown" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </xcad:DockingManager.DocumentHeaderTemplate>
                    <xcad:DockingManager.Layout>
                        <xcadLayout:LayoutRoot>
                            <xcadLayout:LayoutPanel Orientation="Horizontal">
                                <xcadLayout:LayoutDocumentPaneGroup>
                                    <xcadLayout:LayoutDocumentPane x:Name="WorkspaceDocumentPane" />
                                </xcadLayout:LayoutDocumentPaneGroup>
                                <xcadLayout:LayoutAnchorablePaneGroup x:Name="RightToolPaneGroup"
                                                                      DockWidth="420"
                                                                      DockMinWidth="320"
                                                                      FloatingWidth="420"
                                                                      Orientation="Vertical">
                                    <xcadLayout:LayoutAnchorablePane DockHeight="0.32*">
                                        <xcadLayout:LayoutAnchorable x:Name="InspectorAnchorable"
                                                               Title="Outline"
                                                               CanClose="False"
                                                               CanHide="False"
                                                               AutoHideWidth="420"
                                                               FloatingWidth="420">
                                            <ContentControl x:Name="InspectorToolHost" />
                                        </xcadLayout:LayoutAnchorable>
                                    </xcadLayout:LayoutAnchorablePane>
                                    <xcadLayout:LayoutAnchorablePane DockHeight="0.32*">
                                        <xcadLayout:LayoutAnchorable x:Name="GraphAnchorable"
                                                               Title="Graph"
                                                               CanClose="False"
                                                               CanHide="False"
                                                               AutoHideWidth="420"
                                                               FloatingWidth="420">
                                            <ContentControl x:Name="GraphToolHost" />
                                        </xcadLayout:LayoutAnchorable>
                                    </xcadLayout:LayoutAnchorablePane>
                                    <xcadLayout:LayoutAnchorablePane DockHeight="0.36*">
                                        <xcadLayout:LayoutAnchorable x:Name="CardsAnchorable"
                                                               Title="Cards from note"
                                                               CanClose="False"
                                                               CanHide="False"
                                                               AutoHideWidth="420"
                                                               FloatingWidth="420">
                                            <ContentControl x:Name="CardsToolHost" />
                                        </xcadLayout:LayoutAnchorable>
                                        <xcadLayout:LayoutAnchorable x:Name="PdfAnchorable"
                                                               Title="PDF Viewer"
                                                               CanClose="False"
                                                               CanHide="False"
                                                               AutoHideWidth="420"
                                                               FloatingWidth="420">
                                            <ContentControl x:Name="PdfToolHost" />
                                        </xcadLayout:LayoutAnchorable>
                                        <xcadLayout:LayoutAnchorable x:Name="BrowserAnchorable"
                                                               Title="Browser"
                                                               CanClose="False"
                                                               CanHide="False"
                                                               AutoHideWidth="420"
                                                               FloatingWidth="420">
                                            <ContentControl x:Name="BrowserToolHost" />
                                        </xcadLayout:LayoutAnchorable>
                                    </xcadLayout:LayoutAnchorablePane>
                                </xcadLayout:LayoutAnchorablePaneGroup>
                            </xcadLayout:LayoutPanel>
                        </xcadLayout:LayoutRoot>
                    </xcad:DockingManager.Layout>
                </xcad:DockingManager>

                <ContentControl x:Name="OverlayHost"
                                Panel.ZIndex="10" />

            </Grid>
        </Grid>

    </Grid>
</Window>
