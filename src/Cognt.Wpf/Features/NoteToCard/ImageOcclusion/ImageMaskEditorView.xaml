<Window x:Class="CogntApp.Features.NoteToCard.ImageOcclusion.ImageMaskEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CogntApp.Features.NoteToCard.ImageOcclusion"
        Title="Image Occlusion"
        Width="1120"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="ImageMask.CurrentTarget.Fill" Color="#AAE07070" />
        <SolidColorBrush x:Key="ImageMask.CurrentTarget.Stroke" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ImageMask.SiblingTarget.Fill" Color="#88707070" />
        <SolidColorBrush x:Key="ImageMask.SiblingTarget.Stroke" Color="#FFD0D5DD" />
        <SolidColorBrush x:Key="ImageMask.HiddenTarget.Fill" Color="#88707070" />
        <SolidColorBrush x:Key="ImageMask.HiddenTarget.Stroke" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ImageMask.ResolvedTarget.Fill" Color="#66315FAD" />
        <SolidColorBrush x:Key="ImageMask.ResolvedTarget.Stroke" Color="#FF9CC2FF" />
        <SolidColorBrush x:Key="ImageMask.Draft.Fill" Color="#665867FF" />
        <SolidColorBrush x:Key="ImageMask.Draft.Stroke" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ImageMask.Selected.Fill" Color="#885867FF" />
        <SolidColorBrush x:Key="ImageMask.Selected.Stroke" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ImageMask.Invalid.Fill" Color="#55FF4444" />
        <SolidColorBrush x:Key="ImageMask.Invalid.Stroke" Color="#FFFF4444" />
        <SolidColorBrush x:Key="ImageMask.Disabled.Fill" Color="#335B6472" />
        <SolidColorBrush x:Key="ImageMask.Disabled.Stroke" Color="#FF667085" />
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="18,16,18,0"
                Padding="14,12"
                Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Image Occlusion"
                               Style="{StaticResource PanelTitleStyle}" />
                    <TextBlock Text="{Binding ImageRelPath}"
                               Margin="0,3,0,0"
                               Style="{StaticResource SmallMutedTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="Select"
                            MinWidth="76"
                            Margin="0,0,8,0"
                            Command="{Binding SelectToolCommand}"
                            CommandParameter="Select"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Content="Rectangle"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Command="{Binding SelectToolCommand}"
                            CommandParameter="DrawRectangle"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Content="Ellipse"
                            MinWidth="82"
                            Command="{Binding SelectToolCommand}"
                            CommandParameter="DrawEllipse"
                            Style="{StaticResource OutlineButtonStyle}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentTool, StringFormat=Tool: {0}}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource SmallMutedTextStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="18,12,18,12">
            <Border Background="#0F172A"
                    BorderBrush="#202B3D"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding ImageSource}"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <local:ImageMaskOverlayCanvas Editor="{Binding}"
                                                  SurfaceMode="Edit" />

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Width="280"
                            MaxHeight="220"
                            Margin="16"
                            Padding="12"
                            Background="#F9FFFFFF"
                            BorderBrush="#D9E1EE"
                            BorderThickness="1"
                            CornerRadius="8">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding Masks.Count, StringFormat={}{0} masks}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <ListBox ItemsSource="{Binding Masks}"
                                     SelectedValue="{Binding SelectedMaskId, Mode=TwoWay}"
                                     SelectedValuePath="Id"
                                     Margin="0,8,0,0"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label, TargetNullValue=(unlabeled)}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TargetId, TargetNullValue=unlinked}"
                                                           Style="{StaticResource SmallMutedTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Shape}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource SmallMutedTextStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="360"
                            MaxHeight="520"
                            Margin="16"
                            Padding="14"
                            Background="#FAFFFFFF"
                            BorderBrush="#D9E1EE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Selected mask"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" />

                                <TextBlock Text="Target"
                                           Margin="0,12,0,0"
                                           Style="{StaticResource SmallMutedTextStyle}" />
                                <ComboBox ItemsSource="{Binding TargetOptions}"
                                          SelectedItem="{Binding SelectedTargetOption, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayLabel"
                                          Margin="0,4,0,10"
                                          Style="{StaticResource FilterComboBoxStyle}" />

                                <TextBlock Text="Mask label"
                                           Style="{StaticResource SmallMutedTextStyle}" />
                                <TextBox Text="{Binding SelectedMaskLabelText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,10"
                                         Style="{StaticResource InputTextBoxStyle}" />

                                <TextBlock Text="Answer"
                                           Style="{StaticResource SmallMutedTextStyle}" />
                                <TextBox Text="{Binding SelectedMaskAnswerText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,10"
                                         Style="{StaticResource InputTextBoxStyle}" />

                                <TextBlock Text="Hint"
                                           Style="{StaticResource SmallMutedTextStyle}" />
                                <TextBox Text="{Binding SelectedMaskHintText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,12"
                                         Style="{StaticResource InputTextBoxStyle}" />

                                <Button Content="Link target"
                                        Command="{Binding LinkSelectedMaskCommand}"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="Create target"
                                        Command="{Binding CreateTargetFromMaskCommand}"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource OutlineButtonStyle}" />
                                <UniformGrid Columns="3">
                                    <Button Content="Unlink"
                                            Command="{Binding UnlinkSelectedMaskCommand}"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource OutlineButtonStyle}" />
                                    <Button Content="Disable"
                                            Command="{Binding ToggleSelectedMaskDisabledCommand}"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource OutlineButtonStyle}" />
                                    <Button Content="Delete"
                                            Command="{Binding DeleteSelectedMaskCommand}"
                                            Style="{StaticResource OutlineButtonStyle}" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="18,0,18,16"
                Padding="14,12"
                Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Undo"
                            Command="{Binding UndoCommand}"
                            Margin="0,0,8,0"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Content="Redo"
                            Command="{Binding RedoCommand}"
                            Style="{StaticResource OutlineButtonStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Content="Apply"
                            Margin="0,0,8,0"
                            Click="ApplyButton_Click"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Content="Save"
                            Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
