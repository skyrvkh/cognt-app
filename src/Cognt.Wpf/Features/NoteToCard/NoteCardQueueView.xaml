<UserControl x:Class="CogntApp.Features.NoteToCard.NoteCardQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="TinyIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F7F9FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DCE3F0"
                BorderThickness="0,0,0,1"
                Padding="14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Cards from note"
                                   Style="{StaticResource PanelTitleStyle}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource SmallMutedTextStyle}">
                            <Run Text="{Binding NoteCardCandidates.Count, Mode=OneWay}" />
                            <Run Text=" candidates" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button ToolTip="Create card context from selected blocks"
                                Command="{Binding CreateCardContextFromSelectionCommand}"
                                Style="{StaticResource ToolButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14"
                                      Height="14"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center">
                                    <Rectangle Width="11"
                                               Height="12"
                                               Margin="2,1,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Fill="#EEF2FF"
                                               Stroke="#3156D4"
                                               StrokeThickness="1.3" />
                                    <Path Data="M4,5 L10,5 M4,8 L11,8 M4,11 L9,11"
                                          Stretch="Uniform"
                                          Stroke="#3156D4"
                                          StrokeThickness="1.3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                                <TextBlock Text="Context"
                                           FontSize="12"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0"
                                ToolTip="Create cloze deletion"
                                Click="CreateClozeButton_Click"
                                Style="{StaticResource ToolButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14"
                                      Height="14"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      Data="M3,3.5 C1.8,5.5 1.8,12.5 3,14.5 M11,3.5 C12.2,5.5 12.2,12.5 11,14.5 M5,9 L9,9"
                                      Stretch="Uniform"
                                      Stroke="#3156D4"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="Cloze"
                                           FontSize="12"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0"
                                ToolTip="Create image occlusion"
                                Click="OpenImageOcclusionButton_Click"
                                Style="{StaticResource ToolButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14"
                                      Height="14"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center">
                                    <Rectangle Width="12"
                                               Height="9"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Fill="#EEF2FF"
                                               Stroke="#3156D4"
                                               StrokeThickness="1.3" />
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="7,1,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Fill="#FEE2E2"
                                             Stroke="#DC2626"
                                             StrokeThickness="1.3" />
                                </Grid>
                                <TextBlock Text="Image"
                                           FontSize="12"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Deck"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   FontWeight="SemiBold" />
                        <ComboBox Margin="0,6,0,0"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  ItemsSource="{Binding NoteToCardDeckNames}"
                                  SelectedItem="{Binding NoteToCardDeckName, Mode=TwoWay}"
                                  Text="{Binding NoteToCardDeckName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FilterComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tags"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   FontWeight="SemiBold" />
                        <Border Margin="0,6,0,0"
                                MinHeight="36"
                                BorderBrush="#D8DEEC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="#FFFFFF">
                            <WrapPanel Margin="7,5"
                                       VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding NoteToCardTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,4"
                                                    Padding="7,3"
                                                    Background="#EEF2FF"
                                                    CornerRadius="6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               Foreground="#3156D4" />
                                                    <Button Margin="5,0,0,0"
                                                            ToolTip="Remove tag"
                                                            Command="{Binding DataContext.RemoveNoteToCardTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource TinyIconButtonStyle}">
                                                        <TextBlock Text="x"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox MinWidth="92"
                                         Margin="0,0,0,4"
                                         Padding="3,1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{StaticResource InkBrush}"
                                         Text="{Binding NoteToCardPendingTagText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding AddNoteToCardTagCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Width="26"
                                        Height="24"
                                        Margin="3,0,0,4"
                                        Padding="0"
                                        ToolTip="Add tag"
                                        Command="{Binding AddNoteToCardTagCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                    <TextBlock Text="+"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </Button>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Presentation"
                               Style="{StaticResource SmallMutedTextStyle}"
                               FontWeight="SemiBold" />
                    <ComboBox Margin="0,6,0,0"
                              ItemsSource="{Binding NoteToCardPresentationPresets}"
                              SelectedItem="{Binding SelectedNoteToCardPresentationPreset, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding CanEditNoteToCardPresentation}"
                              Style="{StaticResource FilterComboBoxStyle}" />
                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding IsCustomNoteToCardPresentationPreset, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Text front behavior"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding NoteToCardTextFrontModes}"
                                      SelectedItem="{Binding SelectedNoteToCardTextFrontMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource FilterComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Image front behavior"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding NoteToCardImageFrontModes}"
                                      SelectedItem="{Binding SelectedNoteToCardImageFrontMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource FilterComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="3">
                            <TextBlock Text="Back behavior"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding NoteToCardBackRevealModes}"
                                      SelectedItem="{Binding SelectedNoteToCardBackRevealMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource FilterComboBoxStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Content="Preview selected"
                            Command="{Binding PreviewSelectedCardCandidateCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding HasSelectedCardCandidate}" />
                    <Button Grid.Column="2"
                            Content="Generate selected"
                            Command="{Binding GenerateSelectedNoteCardCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding HasSelectedCardCandidate}" />
                </Grid>

                <UniformGrid Margin="0,8,0,0"
                             Columns="3">
                    <Button Content="Add selection"
                            Margin="0,0,6,0"
                            Command="{Binding AddSelectedTextToSelectedCardSlotCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding HasSelectedCardCandidate}" />
                    <Button Content="Disable"
                            Margin="3,0,3,0"
                            Command="{Binding DisableSelectedCardCandidateCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CanDisableSelectedCardCandidate}" />
                    <Button Content="Generate ready"
                            Margin="6,0,0,0"
                            Command="{Binding GenerateReadyNoteCardsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="14">
                <Border Padding="14"
                        Background="#FFFFFF"
                        BorderBrush="#DCE3F0"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="No card candidates yet. Create clozes or image masks in this note."
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoteCardCandidates}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <ListBox ItemsSource="{Binding NoteCardCandidates}"
                         SelectedItem="{Binding SelectedCardCandidate, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoteCardCandidates}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    Background="#FFFFFF"
                                    BorderBrush="#DCE3F0"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="7,3"
                                                Background="#EEF2FF"
                                                CornerRadius="6">
                                            <TextBlock Text="{Binding DisplayClozeIndex, StringFormat=c{0}}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3156D4" />
                                        </Border>
                                        <TextBlock Text="{Binding AnswerPreview}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Padding="7,3"
                                            Background="#F2F5FA"
                                            CornerRadius="6">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding ValidationMessage}"
                                               Margin="0,9,0,0"
                                               Foreground="{StaticResource RedBrush}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <UniformGrid Grid.Row="2"
                                                 Grid.ColumnSpan="2"
                                                 Columns="2"
                                                 Margin="0,10,0,0">
                                        <Border Margin="0,0,5,0"
                                                Padding="8,6"
                                                Background="#F7F9FC"
                                                CornerRadius="6">
                                            <TextBlock Style="{StaticResource SmallMutedTextStyle}">
                                                <Run Text="Text anchors " />
                                                <Run Text="{Binding TextAnchors.Count, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                        <Border Margin="5,0,0,0"
                                                Padding="8,6"
                                                Background="#F7F9FC"
                                                CornerRadius="6">
                                            <TextBlock Style="{StaticResource SmallMutedTextStyle}">
                                                <Run Text="Image masks " />
                                                <Run Text="{Binding ImageAnchors.Count, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
