<UserControl x:Class="CogntApp.Features.NoteToCard.NoteCardQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="TinyIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DeckSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderBrush" Value="#D8DEEC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DeckSuggestionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F7F9FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DCE3F0"
                BorderThickness="0,0,0,1"
                Padding="12">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button ToolTip="Create cloze deletion"
                                Click="CreateClozeButton_Click"
                                Style="{StaticResource ToolButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14"
                                      Height="14"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      Data="M3,3.5 C1.8,5.5 1.8,12.5 3,14.5 M11,3.5 C12.2,5.5 12.2,12.5 11,14.5 M5,9 L9,9"
                                      Stretch="Uniform"
                                      Stroke="#3156D4"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="Cloze"
                                           FontSize="12"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0"
                                ToolTip="Create image occlusion"
                                Click="OpenImageOcclusionButton_Click"
                                Style="{StaticResource ToolButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14"
                                      Height="14"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center">
                                    <Rectangle Width="12"
                                               Height="9"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Fill="#EEF2FF"
                                               Stroke="#3156D4"
                                               StrokeThickness="1.3" />
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="7,1,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Fill="#FEE2E2"
                                             Stroke="#DC2626"
                                             StrokeThickness="1.3" />
                                </Grid>
                                <TextBlock Text="Image"
                                           FontSize="12"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Deck"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding NoteToCardDeckName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search decks or type a new deck name"
                                 Style="{StaticResource DeckSearchTextBoxStyle}" />
                        <Border Margin="0,4,0,0"
                                Padding="4"
                                Background="#FFFFFF"
                                BorderBrush="#D8DEEC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding HasFilteredNoteToCardDeckNames, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding FilteredNoteToCardDeckNames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.SelectNoteToCardDeckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DeckSuggestionButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Tags"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   FontWeight="SemiBold" />
                        <Border Margin="0,6,0,0"
                                MinHeight="36"
                                BorderBrush="#D8DEEC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="#FFFFFF">
                            <WrapPanel Margin="7,5"
                                       VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding NoteToCardTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,4"
                                                    Padding="7,3"
                                                    Background="#EEF2FF"
                                                    CornerRadius="6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               Foreground="#3156D4" />
                                                    <Button Margin="5,0,0,0"
                                                            ToolTip="Remove tag"
                                                            Command="{Binding DataContext.RemoveNoteToCardTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource TinyIconButtonStyle}">
                                                        <TextBlock Text="x"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox MinWidth="140"
                                         Margin="0,0,0,4"
                                         Padding="3,1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{StaticResource InkBrush}"
                                         Text="{Binding NoteToCardPendingTagText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding AddNoteToCardTagCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Presentation"
                               Style="{StaticResource SmallMutedTextStyle}"
                               FontWeight="SemiBold" />
                    <ComboBox Margin="0,6,0,0"
                              ItemsSource="{Binding NoteToCardPresentationPresets}"
                              SelectedItem="{Binding SelectedNoteToCardPresentationPreset, Mode=TwoWay}"
                              Style="{StaticResource FilterComboBoxStyle}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ComboBoxItem}">
                                <Setter Property="IsEnabled"
                                        Value="{Binding IsEnabled}" />
                                <Setter Property="ToolTip"
                                        Value="{Binding DisabledReason}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource InkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}"
                                                             Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource MutedBrush}" />
                                                    <Setter Property="Opacity"
                                                            Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding IsCustomNoteToCardPresentationPreset, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Text front behavior"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding NoteToCardTextFrontModes}"
                                      SelectedItem="{Binding SelectedNoteToCardTextFrontMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource FilterComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Image front behavior"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding NoteToCardImageFrontModes}"
                                      SelectedItem="{Binding SelectedNoteToCardImageFrontMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource FilterComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="3">
                            <TextBlock Text="Back behavior"
                                       Style="{StaticResource SmallMutedTextStyle}" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding NoteToCardBackRevealModes}"
                                      SelectedItem="{Binding SelectedNoteToCardBackRevealMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource FilterComboBoxStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Content="Preview selected"
                            Command="{Binding PreviewSelectedCardCandidateCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding HasSelectedCardCandidate}" />
                    <Button Grid.Column="2"
                            Content="Generate selected"
                            Command="{Binding GenerateSelectedNoteCardCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding HasSelectedCardCandidate}" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Button Content="Generate ready"
                            Command="{Binding GenerateReadyNoteCardsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="14">
                <Border Padding="14"
                        Background="#FFFFFF"
                        BorderBrush="#DCE3F0"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="No ready card candidates. Create clozes or image masks in this note."
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisibleNoteCardCandidates}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <ListBox ItemsSource="{Binding VisibleNoteCardCandidates}"
                         SelectedItem="{Binding SelectedCardCandidate, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         PreviewMouseLeftButtonDown="CardCandidatesListBox_PreviewMouseLeftButtonDown">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleNoteCardCandidates}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    Background="#FFFFFF"
                                    BorderBrush="#DCE3F0"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="7,3"
                                                Background="#EEF2FF"
                                                CornerRadius="6">
                                            <TextBlock Text="{Binding DisplayClozeIndex, StringFormat=c{0}}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3156D4" />
                                        </Border>
                                        <TextBlock Text="{Binding AnswerPreview}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Padding="7,3"
                                            Background="#F2F5FA"
                                            CornerRadius="6">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding ValidationMessage}"
                                               Margin="0,9,0,0"
                                               Foreground="{StaticResource RedBrush}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <UniformGrid Grid.Row="2"
                                                 Grid.ColumnSpan="2"
                                                 Columns="2"
                                                 Margin="0,10,0,0">
                                        <Border Margin="0,0,5,0"
                                                Padding="8,6"
                                                Background="#F7F9FC"
                                                CornerRadius="6">
                                            <TextBlock Style="{StaticResource SmallMutedTextStyle}">
                                                <Run Text="Text anchors " />
                                                <Run Text="{Binding TextAnchors.Count, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                        <Border Margin="5,0,0,0"
                                                Padding="8,6"
                                                Background="#F7F9FC"
                                                CornerRadius="6">
                                            <TextBlock Style="{StaticResource SmallMutedTextStyle}">
                                                <Run Text="Image masks " />
                                                <Run Text="{Binding ImageAnchors.Count, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
