<Window x:Class="CogntApp.Features.NoteToCard.CardCandidatePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:imageOcclusion="clr-namespace:CogntApp.Features.NoteToCard.ImageOcclusion"
        Title="Card Candidate Preview"
        Width="760"
        Height="680"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Card Candidate Preview"
                       Style="{StaticResource PanelTitleStyle}" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="8,4"
                        Background="#EEF2FF"
                        CornerRadius="999">
                    <TextBlock Text="{Binding DisplayLabel}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#3156D4" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding AnswerPreview}"
                           Margin="10,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Status}"
                           Style="{StaticResource MutedTextStyle}" />
            </Grid>
            <TextBlock Text="{Binding PresentationLabel}"
                       Margin="0,8,0,0"
                       Style="{StaticResource SmallMutedTextStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding ValidationMessage}"
                           Margin="0,0,0,12"
                           Foreground="{StaticResource RedBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="FRONT PREVIEW"
                           Style="{StaticResource SmallMutedTextStyle}"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding FrontTextPreview}"
                         Margin="0,8,0,0"
                         MinHeight="110"
                         MaxHeight="180"
                         Padding="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock Text="BACK / REVEAL PREVIEW"
                           Margin="0,18,0,8"
                           Style="{StaticResource SmallMutedTextStyle}"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding BackTextPreview}"
                         MinHeight="110"
                         MaxHeight="180"
                         Padding="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock Text="IMAGE OCCLUSION PREVIEW"
                           Margin="0,18,0,8"
                           Style="{StaticResource SmallMutedTextStyle}"
                           FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding ImagePreviews}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    BorderBrush="#D9E1EE"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="#FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="{Binding ImageRelPath}"
                                               Margin="12,10,12,8"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <imageOcclusion:ImageMaskPreviewControl Editor="{Binding Editor}"
                                                                            Height="260" />
                                    <TextBlock Text="{Binding MissingMediaMessage}"
                                               Margin="12,8,12,12"
                                               Foreground="{StaticResource RedBrush}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="ANCHORS"
                           Margin="0,10,0,8"
                           Style="{StaticResource SmallMutedTextStyle}"
                           FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource MutedTextStyle}">
                    <Run Text="Text anchors: " />
                    <Run Text="{Binding TextAnchorCount}" />
                    <Run Text="  Image anchors: " />
                    <Run Text="{Binding ImageAnchorCount}" />
                </TextBlock>

                <TextBlock Text="METADATA"
                           Margin="0,18,0,8"
                           Style="{StaticResource SmallMutedTextStyle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Metadata}"
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="CONTEXT SNAPSHOT"
                           Margin="0,18,0,8"
                           Style="{StaticResource SmallMutedTextStyle}"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding ContextSnapshotPreview}"
                         MinHeight="90"
                         MaxHeight="160"
                         Padding="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource InputTextBoxStyle}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Close"
                    Width="96"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
