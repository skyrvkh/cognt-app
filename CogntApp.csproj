<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CogntApp</RootNamespace>
    <ApplicationIcon>src\Cognt.Wpf\Assets\icon.ico</ApplicationIcon>
    <EditorWebDirectory>$(MSBuildProjectDirectory)\src\Cognt.Wpf\EditorHost\EditorWeb</EditorWebDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <Page Remove="src\**\*.xaml" />
    <ApplicationDefinition Remove="src\**\*.xaml" />
    <Resource Remove="src\**\*" />
    <Content Remove="src\**\*" />
    <None Remove="src\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\Cognt.Wpf\ViewModels\CountDisplayFormatter.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\AllNotesViewModel.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\AllNotesViewModel.Catalog.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\AllNotesViewModel.Filters.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\AllNotesViewModel.TreeCatalog.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\IAllNotesCatalogSource.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\NoteTreeNodeViewModel.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\NumericTextFormatter.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\ObservableObject.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\RecentNoteViewModel.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\RelayCommand.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\Navigation\NavigationModels.cs" />
    <Compile Include="src\Cognt.Wpf\ViewModels\Navigation\UserMessageRequestedEventArgs.cs" />
    <Compile Include="src\Cognt.Wpf\EditorHost\Services\BlockSuiteHostBridge.cs" />
    <Compile Include="src\Cognt.Wpf\EditorHost\Services\BlockSuiteHostBridge.Events.cs" />
    <Compile Include="src\Cognt.Wpf\EditorHost\Services\IBlockSuiteHostClient.cs" />
    <Compile Include="src\Cognt.Wpf\EditorHost\Components\BlockSuiteHost.razor.cs" />
    <Compile Include="src\Cognt.Wpf\EditorHost\Components\BlockSuiteHost.BridgeCallbacks.cs" />
    <Compile Include="src\Cognt.Wpf\EditorHost\Views\EditorView.xaml.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Dialogs\IShellDialogService.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Dialogs\WindowShellDialogService.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Dialogs\WindowShellDialogService.CollectionCreationPrompt.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Dialogs\WindowShellDialogService.NamePrompt.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Editor\EditorRequestController.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Editor\EditorShellOperationGuard.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Navigation\NavigationShellOperationGuard.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Navigation\NoteTreeCommandController.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Navigation\NoteTreeInteractionController.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Navigation\NoteTreeInteractionController.DragDrop.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Overlay\OverlayHostController.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Collections\FileSystemKnowledgeCollectionPathResolver.cs" />
    <Compile Include="src\Cognt.Wpf\Shell\Collections\IKnowledgeCollectionPathResolver.cs" />
  </ItemGroup>

  <ItemGroup>
    <EditorWebSource Include="$(EditorWebDirectory)\package.json" />
    <EditorWebSource Include="$(EditorWebDirectory)\tsconfig.json" />
    <EditorWebSource Include="$(EditorWebDirectory)\vite.config.js" />
    <EditorWebSource Include="$(EditorWebDirectory)\src\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="src\Cognt.Wpf\EditorHost\Views\EditorView.xaml" />
    <Content Include="src\Cognt.Wpf\EditorHost\Components\BlockSuiteHost.razor" />
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.70" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Cognt.Composition\Cognt.Composition.csproj" />
    <ProjectReference Include="src\Cognt.Wpf\EditorHost\Cognt.Wpf.EditorHost.csproj" />
    <ProjectReference Include="src\Modules\PersonalKnowledgeManagement\Cognt.Modules.PersonalKnowledgeManagement.Application\Cognt.Modules.PersonalKnowledgeManagement.Application.csproj" />
    <ProjectReference Include="src\Modules\PersonalKnowledgeManagement\Cognt.Modules.PersonalKnowledgeManagement.Domain\Cognt.Modules.PersonalKnowledgeManagement.Domain.csproj" />
    <ProjectReference Include="src\Modules\PersonalKnowledgeManagement\Cognt.Modules.PersonalKnowledgeManagement.Infrastructure\Cognt.Modules.PersonalKnowledgeManagement.Infrastructure.csproj" />
    <ProjectReference Include="src\Modules\ProgressTrackingAndAnalytics\Cognt.Modules.ProgressTrackingAndAnalytics.Application\Cognt.Modules.ProgressTrackingAndAnalytics.Application.csproj" />
    <ProjectReference Include="src\Modules\SpacedRepetitionSystem\Cognt.Modules.SpacedRepetitionSystem.Domain\Cognt.Modules.SpacedRepetitionSystem.Domain.csproj" />
    <ProjectReference Include="src\Modules\SpacedRepetitionSystem\Cognt.Modules.SpacedRepetitionSystem.Infrastructure\Cognt.Modules.SpacedRepetitionSystem.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="BuildEditorWeb"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="RestoreEditorWeb"
          Inputs="@(EditorWebSource)"
          Outputs="$(EditorWebDirectory)\dist\assets\blazor-blocksuite.js"
          Condition="Exists('$(EditorWebDirectory)\package.json')">
    <Exec WorkingDirectory="$(EditorWebDirectory)" Command="npm run build" />
  </Target>

  <Target Name="RestoreEditorWeb"
          Condition="Exists('$(EditorWebDirectory)\package.json') and !Exists('$(EditorWebDirectory)\node_modules')">
    <Exec WorkingDirectory="$(EditorWebDirectory)" Command="npm install" />
  </Target>

  <Target Name="CopyEditorWebOutput"
          AfterTargets="Build"
          DependsOnTargets="BuildEditorWeb"
          Condition="Exists('$(EditorWebDirectory)\dist\assets\blazor-blocksuite.js')">
    <ItemGroup>
      <EditorWebOutput Include="$(EditorWebDirectory)\dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)EditorWeb"
               Condition="Exists('$(TargetDir)EditorWeb')" />
    <RemoveDir Directories="$(TargetDir)wwwroot\editorweb"
               Condition="Exists('$(TargetDir)wwwroot\editorweb')" />
    <Copy SourceFiles="@(EditorWebOutput)"
          DestinationFiles="@(EditorWebOutput->'$(TargetDir)wwwroot\editorweb\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
