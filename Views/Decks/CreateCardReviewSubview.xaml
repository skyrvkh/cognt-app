<UserControl x:Class="CogntApp.Views.Decks.CreateCardReviewSubview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1292"
             HorizontalAlignment="Stretch"
             Loaded="CreateCardReviewSubview_Loaded"
             Unloaded="CreateCardReviewSubview_Unloaded"
             SizeChanged="CreateCardReviewSubview_SizeChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <Grid x:Name="LayoutRoot"
          MaxWidth="1260"
          HorizontalAlignment="Stretch"
          Margin="18,20,18,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="HeaderActionsSpacerRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding BackToCardsCommand}"
                        Style="{StaticResource HeaderTabButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14"
                              Height="14"
                              Margin="0,0,8,0"
                              Stroke="{StaticResource InkBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 9 2 L 3 7 L 9 12 M 3 7 L 14 7" />
                        <TextBlock Text="Back to Cards"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="13" />
                    </StackPanel>
                </Button>
                <TextBlock Text="/"
                           Margin="12,0"
                           Style="{StaticResource MutedTextStyle}" />
                <TextBlock Text="Add Cloze Note"
                           Foreground="{StaticResource InkBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <WrapPanel x:Name="ActionButtonsPanel"
                       Grid.Column="1"
                       HorizontalAlignment="Right"
                       ItemHeight="36">
                <Button Content="Discard"
                        Width="86"
                        Style="{StaticResource OutlineButtonStyle}" />
                <Button Content="Save"
                        Width="92"
                        Margin="12,0,0,0"
                        Style="{StaticResource OutlineButtonStyle}" />
                <Button Width="150"
                        Margin="12,0,0,0"
                        Style="{StaticResource OutlineButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Add Another" />
                        <Path Width="8"
                              Height="5"
                              Margin="10,2,0,0"
                              Fill="{StaticResource MutedBrush}"
                              Data="M 0 0 L 4 5 L 8 0 Z" />
                    </StackPanel>
                </Button>
                <Button Content="Preview"
                        Width="96"
                        Margin="12,0,0,0"
                        Style="{StaticResource OutlineButtonStyle}" />
                <Button Content="Create Cards"
                        Width="130"
                        Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </WrapPanel>
        </Grid>

        <Border x:Name="EditorPanel"
                Grid.Row="2"
                Padding="18"
                MinHeight="742"
                Style="{StaticResource PanelStyle}">
            <StackPanel>
                <Grid x:Name="DetailsGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="DetailsWrapSpacerRow" Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="NoteTypeField">
                        <TextBlock Text="Note Type" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox Margin="0,8,0,0"
                                  SelectedIndex="0"
                                  Style="{StaticResource FilterComboBoxStyle}">
                            <ComboBoxItem Content="Cloze" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="DeckField" Grid.Column="2">
                        <TextBlock Text="Deck" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox Margin="0,8,0,0"
                                  SelectedIndex="0"
                                  Style="{StaticResource FilterComboBoxStyle}">
                            <ComboBoxItem Content="Biology 101" />
                            <ComboBoxItem Content="Chemistry Review" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="TagsField" Grid.Column="4">
                        <TextBlock Text="Tags" Style="{StaticResource MutedTextStyle}" />
                        <Border Margin="0,8,0,0"
                                Height="36"
                                CornerRadius="6"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                Background="#FFFFFF">
                            <WrapPanel Margin="8,0"
                                       VerticalAlignment="Center">
                                <Border Padding="8,3"
                                        CornerRadius="6"
                                        Background="#EEF2FF"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="biology"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" />
                                </Border>
                                <Border Padding="8,3"
                                        CornerRadius="6"
                                        Background="#EEF2FF"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="cell-organelles"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" />
                                </Border>
                                <Border Padding="8,3"
                                        CornerRadius="6"
                                        Background="#EEF2FF"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="exam-review"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" />
                                </Border>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,20,0,8">
                    <TextBlock Text="Text"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="Use cloze syntax like {{c1::mitochondria}}"
                               HorizontalAlignment="Right"
                               Style="{StaticResource SmallMutedTextStyle}" />
                </Grid>

                <Border BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="430" />
                        </Grid.RowDefinitions>

                        <Border BorderBrush="{StaticResource LineSoftBrush}"
                                BorderThickness="0,0,0,1"
                                Background="#FAFCFF">
                            <WrapPanel Margin="8,0"
                                       VerticalAlignment="Center">
                                <Button Width="34" Height="30" Style="{StaticResource IconButtonStyle}" Padding="0">
                                    <Path Width="14" Height="14" Stroke="{StaticResource InkBrush}" StrokeThickness="1.7" Data="M 5 4 L 2 7 L 5 10 M 2 7 H 9 C 12 7 13 9 13 11" />
                                </Button>
                                <Button Width="34" Height="30" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" Padding="0">
                                    <Path Width="14" Height="14" Stroke="{StaticResource InkBrush}" StrokeThickness="1.7" Data="M 9 4 L 12 7 L 9 10 M 12 7 H 5 C 2 7 1 9 1 11" />
                                </Button>
                                <Button Content="B" Width="34" Height="30" Margin="10,0,0,0" Style="{StaticResource IconButtonStyle}" FontWeight="SemiBold" />
                                <Button Content="I" Width="34" Height="30" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" FontStyle="Italic" />
                                <Button Content="U" Width="34" Height="30" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" />
                                <Button Content="C1" Width="42" Height="30" Margin="10,0,0,0" Style="{StaticResource OutlineButtonStyle}" Padding="0" />
                                <Button Content="C2" Width="42" Height="30" Margin="6,0,0,0" Style="{StaticResource OutlineButtonStyle}" Padding="0" />
                                <Button Content="Cloze" Width="70" Height="30" Margin="10,0,0,0" Style="{StaticResource OutlineButtonStyle}" Padding="0" />
                                <Button Content="Hint" Width="58" Height="30" Margin="6,0,0,0" Style="{StaticResource OutlineButtonStyle}" Padding="0" />
                            </WrapPanel>
                        </Border>

                        <ContentControl x:Name="CardTextEditorHost"
                                        Grid.Row="1"
                                        Focusable="True"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />
                    </Grid>
                </Border>

                <Grid Margin="0,10,0,0">
                    <CheckBox Content="Show cloze numbers"
                              IsChecked="True"
                              Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="Formatting help"
                               HorizontalAlignment="Right"
                               Style="{StaticResource SmallMutedTextStyle}" />
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Extra (optional)" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Margin="0,8,0,0"
                                 Text="Mitochondria generate most of the cell's ATP through cellular respiration, converting nutrients into usable energy."
                                 MinHeight="76"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Source (optional)" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Margin="0,8,0,0"
                                 Text="Campbell Biology, 12th Ed. - Chapter 7: Cell Respiration"
                                 MinHeight="76"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Margin="0,20,0,14"
                        Background="{StaticResource LineSoftBrush}" />
                <Grid>
                    <TextBlock Text="Advanced Options"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="v"
                               HorizontalAlignment="Right"
                               Style="{StaticResource MutedTextStyle}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
