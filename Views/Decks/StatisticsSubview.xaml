<UserControl x:Class="CogntApp.Views.Decks.StatisticsSubview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1292"
             HorizontalAlignment="Stretch"
             Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, FallbackValue=1292}"
             MaxWidth="1292"
             Loaded="StatisticsSubview_Loaded"
             SizeChanged="StatisticsSubview_SizeChanged">
    <Grid x:Name="StatisticsLayoutRoot"
          Margin="16,16,16,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Statistics"
                       VerticalAlignment="Center"
                       Style="{StaticResource PanelTitleStyle}"
                       FontSize="22" />

            <ComboBox Grid.Column="1"
                      Width="190"
                      SelectedIndex="0"
                      Style="{StaticResource FilterComboBoxStyle}">
                <ComboBoxItem Content="Previous 14 days" />
                <ComboBoxItem Content="Previous 30 days" />
                <ComboBoxItem Content="Custom range" />
            </ComboBox>
        </Grid>

        <UniformGrid x:Name="StatisticsSummaryGrid"
                     Grid.Row="1"
                     Columns="5"
                     Margin="-6,18,-6,8">
            <Border Margin="6" Padding="16" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Time Studied" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="18h 42m" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="22" />
                    <TextBlock Text="+ 2h 34m vs previous 14 days" Margin="0,8,0,0" Foreground="{StaticResource GreenBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="6" Padding="16" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Cards Reviewed" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="1,284" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="22" />
                    <TextBlock Text="+ 356 vs previous 14 days" Margin="0,8,0,0" Foreground="{StaticResource GreenBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="6" Padding="16" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Study Streak" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="12 days" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="22" />
                    <TextBlock Text="Best: 18 days" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="6" Padding="16" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Average Recall" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="82%" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="22" />
                    <TextBlock Text="+ 6% vs previous 14 days" Margin="0,8,0,0" Foreground="{StaticResource GreenBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="6" Padding="16" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="Due Tomorrow" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="74" Margin="0,8,0,0" Style="{StaticResource PanelTitleStyle}" FontSize="22" />
                    <TextBlock Text="Across 6 decks" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid x:Name="TopStatisticsGrid" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TopStatisticsGapRow" Height="0" />
                <RowDefinition x:Name="TopStatisticsSecondaryRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TopStatisticsPrimaryColumn" Width="1.55*" />
                <ColumnDefinition x:Name="TopStatisticsGapColumn" Width="14" />
                <ColumnDefinition x:Name="TopStatisticsSecondaryColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Cards Reviewed &amp; Time Studied"
                               Margin="16,16,16,0"
                               Style="{StaticResource PanelTitleStyle}"
                               TextWrapping="Wrap" />

                    <lvc:CartesianChart x:Name="DailyStatisticsChart"
                                        Grid.Row="1"
                                        Height="360"
                                        Margin="12,12,12,12"
                                        AnimationsSpeed="0:0:0.25"
                                        LegendPosition="Top"
                                        Series="{Binding DailyStatisticsSeries}"
                                        TooltipPosition="Top"
                                        XAxes="{Binding DailyStatisticsXAxes}"
                                        YAxes="{Binding DailyStatisticsYAxes}" />
                </Grid>
            </Border>

            <StackPanel x:Name="TopStatisticsSidePanel"
                        Grid.Row="0"
                        Grid.Column="2">
                <Border Padding="16" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Recall Distribution"
                                       Margin="0,0,12,0"
                                       Style="{StaticResource PanelTitleStyle}"
                                       TextWrapping="Wrap" />
                            <ComboBox Grid.Column="1"
                                      Width="118"
                                      Margin="12,0,0,0"
                                      SelectedIndex="0"
                                      Style="{StaticResource FilterComboBoxStyle}">
                                <ComboBoxItem Content="Previous 14 Days" />
                                <ComboBoxItem Content="All Time" />
                            </ComboBox>
                        </Grid>

                        <lvc:PieChart x:Name="RecallDistributionChart"
                                      Height="220"
                                      Margin="0,10,0,0"
                                      AnimationsSpeed="0:0:0.25"
                                      LegendPosition="Bottom"
                                      Series="{Binding RecallDistributionSeries}"
                                      TooltipPosition="Hidden" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="16" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Study Heatmap - Previous 26 Weeks"
                                   Style="{StaticResource PanelTitleStyle}"
                                   TextWrapping="Wrap" />
                        <lvc:CartesianChart x:Name="StudyHeatmapChart"
                                            Height="220"
                                            Margin="0,10,0,0"
                                            AnimationsSpeed="0:0:0.25"
                                            LegendPosition="Hidden"
                                            Series="{Binding StudyStreakSeries}"
                                            TooltipPosition="Top"
                                            XAxes="{Binding StudyStreakXAxes}"
                                            YAxes="{Binding StudyStreakYAxes}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid x:Name="BottomStatisticsGrid"
              Grid.Row="3"
              Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="BottomStatisticsGapRow" Height="0" />
                <RowDefinition x:Name="BottomStatisticsSecondaryRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BottomStatisticsPrimaryColumn" Width="1.55*" />
                <ColumnDefinition x:Name="BottomStatisticsGapColumn" Width="14" />
                <ColumnDefinition x:Name="BottomStatisticsSecondaryColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Deck Performance"
                               Margin="16,16,16,0"
                               Style="{StaticResource PanelTitleStyle}" />

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,12,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <DataGrid MinWidth="740"
                                  ItemsSource="{Binding DeckPerformanceRows}"
                                  Style="{StaticResource FlashcardsDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Deck}" Header="Deck" Width="220" ElementStyle="{StaticResource GridTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding CardsReviewed}" Header="Cards Reviewed" Width="130" ElementStyle="{StaticResource GridCenterTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding RetentionLabel}" Header="Retention" Width="110" ElementStyle="{StaticResource GridCenterTextBlockStyle}" />
                                <DataGridTextColumn Binding="{Binding Due}" Header="Due" Width="70" ElementStyle="{StaticResource GridCenterTextBlockStyle}" />
                                <DataGridTemplateColumn Header="Progress" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar Width="92" Height="5" BorderThickness="0" Maximum="100" Value="{Binding Progress}" Foreground="{StaticResource AccentBrush}" Background="#D8DEEA" />
                                                <TextBlock Text="{Binding ProgressLabel}" Margin="10,0,0,0" Style="{StaticResource TableTextStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="WeeklyOutcomePanel"
                    Grid.Row="0"
                    Grid.Column="2"
                    Padding="16"
                    Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Review Outcomes by Week"
                                   Margin="0,0,12,0"
                                   Style="{StaticResource PanelTitleStyle}"
                                   TextWrapping="Wrap" />
                        <ComboBox Grid.Column="1"
                                  Width="118"
                                  Margin="12,0,0,0"
                                  SelectedIndex="0"
                                  Style="{StaticResource FilterComboBoxStyle}">
                            <ComboBoxItem Content="This 30 Days" />
                            <ComboBoxItem Content="All Time" />
                        </ComboBox>
                    </Grid>

                    <lvc:CartesianChart x:Name="WeeklyOutcomeChart"
                                        Height="245"
                                        Margin="0,10,0,0"
                                        AnimationsSpeed="0:0:0.25"
                                        LegendPosition="Top"
                                        Series="{Binding WeeklyOutcomeSeries}"
                                        TooltipPosition="Top"
                                        XAxes="{Binding WeeklyOutcomeXAxes}"
                                        YAxes="{Binding WeeklyOutcomeYAxes}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
