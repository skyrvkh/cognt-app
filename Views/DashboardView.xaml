<UserControl x:Class="CogntApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1120"
             Background="#F8FAFF">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#15192C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#707895" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE3F0" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="MetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE2EF" />
            <Setter Property="Foreground" Value="#5967FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1080"
              Margin="32,52,32,40"
              HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="Good morning, Neil"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Let's keep building your knowledge today."
                               Margin="0,10,0,0"
                               FontSize="14"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <TextBlock Text="Study Overview"
                           Margin="0,38,0,12"
                           Style="{StaticResource PanelTitleStyle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel MinHeight="108">
                            <TextBlock Text="Today's Reviews" FontSize="12" Foreground="#26304D" />
                            <TextBlock Text="86 cards" Margin="0,14,0,0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Due today" Style="{StaticResource MetaTextStyle}" Margin="0,10,0,0" />
                            <TextBlock Text="+12 from yesterday" Foreground="#5967FF" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel MinHeight="108">
                            <TextBlock Text="Study Streak" FontSize="12" Foreground="#26304D" />
                            <TextBlock Text="23 days" Margin="0,14,0,0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Best: 47 days" Style="{StaticResource MetaTextStyle}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel MinHeight="108">
                            <TextBlock Text="Learning Progress" FontSize="12" Foreground="#26304D" />
                            <TextBlock Text="68%" Margin="0,14,0,0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="+14% vs last week" Margin="0,10,0,0" Foreground="#5967FF" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                        <StackPanel MinHeight="108">
                            <TextBlock Text="Total Knowledge" FontSize="12" Foreground="#26304D" />
                            <TextBlock Text="1,248 items" Margin="0,14,0,0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Across 14 collections" Style="{StaticResource MetaTextStyle}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,22,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Study Activity" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="Reviews per day across your current streak"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="23 days" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="current streak" Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid x:Name="StudyHeatmapGrid"
                                     Columns="52"
                                     Rows="7" />

                        <Grid Margin="32,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Less" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                                <Border Width="12" Height="12" Margin="8,0,0,0" Background="#EEF2FF" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,0,0" Background="#DDE5FF" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,0,0" Background="#AEBEFF" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,0,0" Background="#7E92FF" CornerRadius="3" />
                                <Border Width="12" Height="12" Margin="4,0,8,0" Background="#5967FF" CornerRadius="3" />
                                <TextBlock Text="More" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="1,036 reviews in 52 weeks" Style="{StaticResource MetaTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,22,0,0"
                        Padding="16"
                        Background="#F3F4FF"
                        BorderBrush="#DDE0FF"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Continue Learning" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="Pick up where you left off" Margin="0,7,0,0" Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Review Now" Width="110" Style="{StaticResource SmallButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recent Notes" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,18" />
                            <TextBlock Text="Pilipinas" FontSize="13" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Kultura ng Pilipinas" Margin="0,14,0,0" FontSize="13" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Kasaysayan ng Pilipinas" Margin="0,14,0,0" FontSize="13" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Heyograpiya ng Pilipinas" Margin="0,14,0,0" FontSize="13" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Ekonomiya ng Pilipinas" Margin="0,14,0,0" FontSize="13" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Pinned Collections" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,18" />
                            <Border Padding="18" Background="#FAFBFF" BorderBrush="#E4E8F2" BorderThickness="1" CornerRadius="6">
                                <TextBlock Text="Empty" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,22,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Daily Note    May 18, 2024"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="Open" Width="72" Style="{StaticResource SmallButtonStyle}" />
                        </Grid>
                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Background="#FAFBFF"
                                BorderBrush="#E4E8F2"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBlock Text="The beautiful thing about learning is that nobody can take it away from you. - B. B. King"
                                       FontStyle="Italic"
                                       Foreground="#606986"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
