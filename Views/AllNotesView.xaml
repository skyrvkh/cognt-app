<UserControl x:Class="CogntApp.Views.AllNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CogntApp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1120"
             Background="#F8FAFF">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#15192C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#707895" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE3F0" />

        <Style x:Key="FieldStyle" TargetType="Control">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE2EF" />
            <Setter Property="Foreground" Value="#3156D4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,44,32,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="All Documents"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding PageSubtitle}"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Import"
                    Margin="0,0,8,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding ImportDocumentsCommand}" />
            <Button Grid.Column="2"
                    Content="New"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding CreateNoteCommand}" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,28,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Style="{StaticResource FieldStyle}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
            <ComboBox Grid.Column="1"
                      Margin="10,0,0,0"
                      Style="{StaticResource FieldStyle}"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding TagOptions}"
                      SelectedItem="{Binding SelectedTagOption}" />
            <ComboBox Grid.Column="2"
                      Margin="10,0,0,0"
                      Style="{StaticResource FieldStyle}"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding SelectedTypeOption}" />
            <ComboBox Grid.Column="3"
                      Margin="10,0,0,0"
                      Style="{StaticResource FieldStyle}"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption}" />
            <Button Grid.Column="4"
                    Content="Clear"
                    Margin="10,0,0,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding ClearFiltersCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    Background="#FFFFFF"
                    Padding="10">
                <TreeView ItemsSource="{Binding VisibleTreeNodes}"
                          BorderThickness="0"
                          Background="Transparent">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type viewModels:AllNotesTreeItemViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Prefix}"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="4,3" />
                            <EventSetter Event="MouseDoubleClick" Handler="TreeItem_MouseDoubleClick" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    Background="#FFFFFF">
                <DataGrid ItemsSource="{Binding VisibleNotes}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          MouseDoubleClick="NotesGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="140" />
                        <DataGridTextColumn Header="Location" Binding="{Binding LocationLabel}" Width="2*" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAtLabel}" Width="170" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldShowEmptyState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding EmptyStateTitle}"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding EmptyStateMessage}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding ResultsSummary}"
                   Margin="0,14,0,0"
                   FontSize="12"
                   Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
