<UserControl x:Class="CogntApp.Views.DecksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:deckViewModels="clr-namespace:CogntApp.ViewModels.Decks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1220"
             Background="#F7F9FC"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.DataContext>
        <deckViewModels:DecksViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#F8FAFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE4EF" />
        <SolidColorBrush x:Key="LineSoftBrush" Color="#ECF0F6" />
        <SolidColorBrush x:Key="InkBrush" Color="#142033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="DimBrush" Color="#98A2B3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5867FF" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#4254E8" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#D97706" />
        <SolidColorBrush x:Key="RedBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="GreenBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#9333EA" />

        <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6675FF" Offset="0" />
            <GradientStop Color="#4254E8" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#59657A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SmallMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E1EE" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#B8C3D6" />
                    <Setter Property="Background" Value="#F1F5FB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
            <Setter Property="BorderBrush" Value="#6675FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="DeckRowStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style x:Key="SelectedDeckRowStyle" TargetType="Border" BasedOn="{StaticResource DeckRowStyle}">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="BorderBrush" Value="#5867FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TableTextStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="GridCenterTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FlashcardsDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="ColumnWidth" Value="SizeToCells" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineSoftBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="MinColumnWidth" Value="34" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="48" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Foreground" Value="#59657A" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding RowBackground}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EEF2FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                Background="#FFFFFF">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="{StaticResource PrimaryGradientBrush}">
                        <TextBlock Text="F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FFFFFF"
                                   FontSize="16"
                                   FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Flashcards"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Grid Margin="0,0,28,0">
                        <TextBlock Text="Decks" Foreground="{StaticResource InkBrush}" FontSize="14" FontWeight="SemiBold" />
                        <Border Height="3"
                                Width="46"
                                CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-24" />
                    </Grid>
                    <TextBlock Text="Cards" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,0,28,0" />
                    <TextBlock Text="Statistics" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="260"
                            Height="36"
                            CornerRadius="6"
                            BorderBrush="#D9E1EE"
                            BorderThickness="1"
                            Background="#FFFFFF">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Stroke="{StaticResource DimBrush}" StrokeThickness="1.5" />
                            <Border Grid.Column="0"
                                    Width="6"
                                    Height="1.5"
                                    Background="{StaticResource DimBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Margin="10,12,0,0">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Search decks..."
                                       Margin="14,0,0,0"
                                       Style="{StaticResource MutedTextStyle}" />
                            <Border Grid.Column="2"
                                    Padding="6,2"
                                    CornerRadius="4"
                                    BorderBrush="#D9E1EE"
                                    BorderThickness="1"
                                    Background="#F8FAFF">
                                <TextBlock Text="#K"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource IconButtonStyle}" Margin="14,0,0,0">
                        <TextBlock Text="!"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Practice" />
                            <Border Margin="10,0,0,0"
                                    Padding="7,2"
                                    CornerRadius="8"
                                    Background="#4F5EEA">
                                <TextBlock Text="23"
                                           Foreground="#FFFFFF"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="1260"
                  Margin="16,16,16,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="940" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PanelStyle}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Study Overview"
                                   Style="{StaticResource PanelTitleStyle}"
                                   FontSize="15" />

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Time Studied" Style="{StaticResource MutedTextStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="4" Foreground="{StaticResource InkBrush}" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text=" hrs " Foreground="{StaticResource InkBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0" />
                                    <TextBlock Text="25" Foreground="{StaticResource InkBrush}" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text=" mins" Foreground="{StaticResource InkBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,3" />
                                </StackPanel>
                                <TextBlock Text="+ 1h 15m vs last 7 days"
                                           Foreground="{StaticResource GreenBrush}"
                                           FontSize="12"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Study Streak" Style="{StaticResource MutedTextStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="12" Foreground="{StaticResource InkBrush}" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text=" days" Foreground="{StaticResource InkBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                </StackPanel>
                                <TextBlock Text="+ Best: 18 days"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource LineBrush}"
                                Margin="0,28,0,22" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Recall Distribution"
                                       Style="{StaticResource PanelTitleStyle}"
                                       FontSize="15" />
                            <Border Grid.Column="1"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="8"
                                    BorderBrush="{StaticResource DimBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="i"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource DimBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Based on 632 reviews"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="152" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Canvas Width="142" Height="142">
                                <Ellipse Width="142"
                                         Height="142"
                                         Stroke="#E3E8F2"
                                         StrokeThickness="30" />
                                <Path Stroke="#2563EB"
                                      StrokeThickness="30"
                                      StrokeStartLineCap="Flat"
                                      StrokeEndLineCap="Flat"
                                      Data="M 71,15 A 56,56 0 1 1 25,103" />
                                <Path Stroke="#16A34A"
                                      StrokeThickness="30"
                                      StrokeStartLineCap="Flat"
                                      StrokeEndLineCap="Flat"
                                      Data="M 25,103 A 56,56 0 0 1 71,15" />
                                <Path Stroke="#D97706"
                                      StrokeThickness="30"
                                      StrokeStartLineCap="Flat"
                                      StrokeEndLineCap="Flat"
                                      Data="M 122,43 A 56,56 0 0 1 118,103" />
                                <Path Stroke="#DC2626"
                                      StrokeThickness="30"
                                      StrokeStartLineCap="Flat"
                                      StrokeEndLineCap="Flat"
                                      Data="M 72,15 A 56,56 0 0 1 122,43" />
                                <Ellipse Canvas.Left="42"
                                         Canvas.Top="42"
                                         Width="58"
                                         Height="58"
                                         Fill="#FFFFFF" />
                                <TextBlock Canvas.Left="58"
                                           Canvas.Top="53"
                                           Text="632"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Canvas.Left="57"
                                           Canvas.Top="75"
                                           Text="Total"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" />
                            </Canvas>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource RedBrush}" />
                                    <TextBlock Grid.Column="1" Text="Again" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="12%" Style="{StaticResource TableTextStyle}" FontSize="12" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource OrangeBrush}" />
                                    <TextBlock Grid.Column="1" Text="Hard" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="21%" Style="{StaticResource TableTextStyle}" FontSize="12" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource BlueBrush}" />
                                    <TextBlock Grid.Column="1" Text="Good" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="46%" Style="{StaticResource TableTextStyle}" FontSize="12" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource GreenBrush}" />
                                    <TextBlock Grid.Column="1" Text="Easy" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="21%" Style="{StaticResource TableTextStyle}" FontSize="12" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="View full statistics  ->"
                                   Margin="0,22,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="13" />

                        <Border Height="1"
                                Background="{StaticResource LineBrush}"
                                Margin="0,28,0,22" />

                        <TextBlock Text="Today"
                                   Style="{StaticResource PanelTitleStyle}"
                                   FontSize="15" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cards Due" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Grid.Column="1" Text="23" Style="{StaticResource TableTextStyle}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="New Cards" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Grid.Column="1" Text="14" Style="{StaticResource TableTextStyle}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Est. Time" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Grid.Column="1" Text="35 mins" Style="{StaticResource TableTextStyle}" FontWeight="SemiBold" />
                        </Grid>

                        <Button Margin="0,24,0,0"
                                Height="44"
                                Style="{StaticResource OutlineButtonStyle}">
                            <TextBlock Text="Study Calendar"
                                       Foreground="{StaticResource InkBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="42" />
                            </Grid.RowDefinitions>

                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Your Decks" Style="{StaticResource PanelTitleStyle}" />
                                    <Border Margin="10,0,0,0"
                                            Padding="7,2"
                                            CornerRadius="6"
                                            Background="#EEF2FF">
                                        <TextBlock Text="6"
                                                   Foreground="#344054"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Filter" Width="82" Style="{StaticResource OutlineButtonStyle}" />
                                <Button Grid.Column="2" Content="Sort: Alphabetical" Width="150" Margin="12,0,0,0" Style="{StaticResource OutlineButtonStyle}" />
                                <Button Grid.Column="3" Content="..." Width="42" Margin="12,0,0,0" Style="{StaticResource IconButtonStyle}" />
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding DeckRows}"
                                      Style="{StaticResource FlashcardsDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="38">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          IsHitTestVisible="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Deck" Width="230">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource GridTextBlockStyle}"
                                                               FontWeight="SemiBold"
                                                               MaxWidth="126" />
                                                    <Border Margin="10,0,0,0"
                                                            Padding="7,3"
                                                            CornerRadius="4"
                                                            BorderBrush="{Binding BadgeBorder}"
                                                            BorderThickness="1"
                                                            Background="{Binding BadgeBackground}">
                                                        <TextBlock Text="{Binding Category}"
                                                                   Foreground="{Binding BadgeForeground}"
                                                                   Style="{StaticResource BadgeTextStyle}" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="New" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NewCards}"
                                                           Foreground="{StaticResource BlueBrush}"
                                                           Style="{StaticResource GridCenterTextBlockStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Learning" Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LearningCards}"
                                                           Foreground="{StaticResource OrangeBrush}"
                                                           Style="{StaticResource GridCenterTextBlockStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Due" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DueCards}"
                                                           Foreground="{StaticResource RedBrush}"
                                                           Style="{StaticResource GridCenterTextBlockStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding TotalCards}"
                                                        Header="Total Cards"
                                                        Width="86"
                                                        ElementStyle="{StaticResource GridCenterTextBlockStyle}" />
                                    <DataGridTemplateColumn Header="Progress" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource TableTextStyle}" Width="42" />
                                                    <ProgressBar Width="92"
                                                                 Height="5"
                                                                 BorderThickness="0"
                                                                 Background="#D8DEEA"
                                                                 Foreground="{StaticResource AccentBrush}"
                                                                 Maximum="100"
                                                                 Value="{Binding Progress}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Practice" Width="112">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Practice"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        Style="{StaticResource OutlineButtonStyle}"
                                                        Width="92"
                                                        Height="32" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="..." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2"
                                       Text="Showing 1 to 6 of 6 decks"
                                       Margin="16,0"
                                       Style="{StaticResource MutedTextStyle}" />
                        </Grid>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="50" />
                            </Grid.RowDefinitions>

                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Cards in Biology 101" Style="{StaticResource PanelTitleStyle}" />
                                    <Border Margin="10,0,0,0"
                                            Padding="7,2"
                                            CornerRadius="6"
                                            Background="#EEF2FF">
                                        <TextBlock Text="152"
                                                   Foreground="#344054"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="220"
                                        Height="36"
                                        CornerRadius="6"
                                        BorderBrush="#D9E1EE"
                                        BorderThickness="1"
                                        Background="#FFFFFF"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="Search cards..."
                                               Margin="18,0,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                </Border>
                                <Button Grid.Column="2" Content="Filter" Width="92" Style="{StaticResource OutlineButtonStyle}" />
                                <Button Grid.Column="3" Content="+ Add Cards" Width="118" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding CardRows}"
                                      Style="{StaticResource FlashcardsDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="38">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          IsHitTestVisible="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding Question}"
                                                        Header="Front (Question)"
                                                        Width="430"
                                                        ElementStyle="{StaticResource GridTextBlockStyle}" />
                                    <DataGridTemplateColumn Header="Status" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Padding="8,3"
                                                        CornerRadius="4"
                                                        BorderBrush="{Binding StatusBorder}"
                                                        BorderThickness="1"
                                                        Background="{Binding StatusBackground}">
                                                    <TextBlock Text="{Binding Status}"
                                                               Foreground="{Binding StatusForeground}"
                                                               FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding LastReviewed}"
                                                        Header="Last Reviewed"
                                                        Width="150"
                                                        ElementStyle="{StaticResource GridTextBlockStyle}" />
                                    <DataGridTemplateColumn Header="Actions" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="View" Width="42" Height="30" Style="{StaticResource OutlineButtonStyle}" Padding="0" />
                                                    <Button Content="Edit" Width="42" Height="30" Style="{StaticResource OutlineButtonStyle}" Padding="0" Margin="8,0,0,0" />
                                                    <Button Content="..." Width="42" Height="30" Style="{StaticResource OutlineButtonStyle}" Padding="0" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="2" Margin="16,0">
                                <TextBlock Text="Showing 1 to 5 of 152 cards"
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="&lt;" Width="38" Height="34" Style="{StaticResource IconButtonStyle}" />
                                    <Button Content="1" Width="38" Height="34" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="2" Width="38" Height="34" Margin="8,0,0,0" Style="{StaticResource OutlineButtonStyle}" />
                                    <Button Content="3" Width="38" Height="34" Margin="8,0,0,0" Style="{StaticResource OutlineButtonStyle}" />
                                    <TextBlock Text="..." Margin="14,0" Style="{StaticResource TableTextStyle}" />
                                    <Button Content="31" Width="44" Height="34" Style="{StaticResource OutlineButtonStyle}" />
                                    <Button Content="&gt;" Width="38" Height="34" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
