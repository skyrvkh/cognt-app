<UserControl x:Class="CogntApp.Views.DecksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:deckViewModels="clr-namespace:CogntApp.ViewModels.Decks"
             xmlns:subviews="clr-namespace:CogntApp.Views.Decks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1220"
             Background="#F7F9FC"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.DataContext>
        <deckViewModels:DecksViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                Background="#FFFFFF">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="{StaticResource PrimaryGradientBrush}">
                        <TextBlock Text="F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FFFFFF"
                                   FontSize="16"
                                   FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Flashcards"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Grid Margin="0,0,28,0">
                        <TextBlock Text="Decks" Foreground="{StaticResource InkBrush}" FontSize="14" FontWeight="SemiBold" />
                        <Border Height="3"
                                Width="46"
                                CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-24" />
                    </Grid>
                    <TextBlock Text="Cards" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,0,28,0" />
                    <TextBlock Text="Statistics" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="260"
                            Height="36"
                            CornerRadius="6"
                            BorderBrush="#D9E1EE"
                            BorderThickness="1"
                            Background="#FFFFFF">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Stroke="{StaticResource DimBrush}" StrokeThickness="1.5" />
                            <Border Grid.Column="0"
                                    Width="6"
                                    Height="1.5"
                                    Background="{StaticResource DimBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Margin="10,12,0,0">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Search decks..."
                                       Margin="14,0,0,0"
                                       Style="{StaticResource MutedTextStyle}" />
                            <Border Grid.Column="2"
                                    Padding="6,2"
                                    CornerRadius="4"
                                    BorderBrush="#D9E1EE"
                                    BorderThickness="1"
                                    Background="#F8FAFF">
                                <TextBlock Text="#K"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource IconButtonStyle}" Margin="14,0,0,0">
                        <TextBlock Text="!"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Practice" />
                            <Border Margin="10,0,0,0"
                                    Padding="7,2"
                                    CornerRadius="8"
                                    Background="#4F5EEA">
                                <TextBlock Text="23"
                                           Foreground="#FFFFFF"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <subviews:DecksSubview DataContext="{Binding Decks}" />
        </ScrollViewer>
    </Grid>
</UserControl>
