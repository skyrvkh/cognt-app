<UserControl x:Class="CogntApp.Views.DecksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:deckViewModels="clr-namespace:CogntApp.ViewModels.Decks"
             xmlns:subviews="clr-namespace:CogntApp.Views.Decks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1220"
             Background="#F7F9FC"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type deckViewModels:DecksSubviewViewModel}">
            <subviews:DecksSubview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type deckViewModels:CardsSubviewViewModel}">
            <subviews:CardsSubview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type deckViewModels:StatisticsSubviewViewModel}">
            <subviews:StatisticsSubview />
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataContext>
        <deckViewModels:DecksViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                Background="#FFFFFF">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Flashcards"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Grid Margin="0,0,28,0">
                        <Button x:Name="DecksTabButton"
                                Content="Decks"
                                Command="{Binding ShowDecksCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDecksSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border x:Name="DecksTabUnderline"
                                Height="3"
                                Width="46"
                                CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-24">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDecksSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,28,0">
                        <Button x:Name="CardsTabButton"
                                Content="Cards"
                                Command="{Binding ShowCardsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCardsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border x:Name="CardsTabUnderline"
                                Height="3"
                                Width="42"
                                CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-24">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCardsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                    <Grid>
                        <Button x:Name="StatisticsTabButton"
                                Content="Statistics"
                                Command="{Binding ShowStatisticsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatisticsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border x:Name="StatisticsTabUnderline"
                                Height="3"
                                Width="64"
                                CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-24">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatisticsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Practice" />
                            <Border Margin="10,0,0,0"
                                    Padding="7,2"
                                    CornerRadius="8"
                                    Background="#4F5EEA">
                                <TextBlock Text="23"
                                           Foreground="#FFFFFF"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="FlashcardsBodyScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="{Binding ViewportWidth, ElementName=FlashcardsBodyScrollViewer}">
                <ContentControl Content="{Binding CurrentSubview}"
                                HorizontalAlignment="Center" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
