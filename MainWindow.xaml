<Window x:Class="CogntApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CogntApp"
        xmlns:views="clr-namespace:CogntApp.Views"
        xmlns:viewModels="clr-namespace:CogntApp.ViewModels"
        mc:Ignorable="d"
        Title="Cognt App" Height="860" Width="1320" MinHeight="720" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFF">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#78809A" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#586078" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                    <Setter Property="Foreground" Value="#3156D4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimarySidebarButtonStyle"
               BasedOn="{StaticResource SidebarButtonStyle}"
               TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8DEEC" />
            <Setter Property="Foreground" Value="#3156D4" />
        </Style>

        <Style x:Key="NoteTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#586078" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </Window.Resources>

    <Grid Background="#F7F9FC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FBFCFF"
                BorderBrush="#E1E6F0"
                BorderThickness="0,0,1,0"
                Padding="12,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="28"
                            Height="28"
                            Background="#EEF2FF"
                            CornerRadius="8">
                        <TextBlock Text="*"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#4C6FFF" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Cognt"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2433" />
                    <TextBlock Grid.Column="2"
                               Text="&lt;&lt;"
                               VerticalAlignment="Center"
                               Foreground="#8A91A8"
                               FontSize="12" />
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="DIRECTORY"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="8,0,0,8" />

                    <TextBox x:Name="NotesDirectoryTextBox"
                             Height="32"
                             Margin="0,0,0,8"
                             Padding="10,4"
                             Background="#FFFFFF"
                             BorderBrush="#D8DEEC"
                             Foreground="#586078"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Text="{Binding NotesDirectory, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Load Directory"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,10"
                            Command="{Binding LoadDirectoryCommand}" />
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Content="Dashboard"
                                Style="{StaticResource PrimarySidebarButtonStyle}"
                                Margin="0,0,0,8"
                                Command="{Binding ShowDashboardCommand}" />
                        <Button Content="All Documents"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding LoadDirectoryCommand}" />
                        <Button Content="Flashcards"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowDecksCommand}" />

                        <TextBlock Text="RECENT"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="8,18,0,8" />
                        <ItemsControl ItemsSource="{Binding RecentNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:RecentNoteViewModel}">
                                    <Button Content="{Binding DisplayName}"
                                            Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding NotePath}"
                                            Style="{StaticResource SidebarButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1"
                                Background="#E1E6F0"
                                Margin="8,14,8,12" />

                        <TreeView x:Name="NotesTree"
                                  BorderThickness="0"
                                  Margin="0"
                                  Background="Transparent"
                                  FontSize="13"
                                  Foreground="#586078"
                                  ItemsSource="{Binding NoteRoots}"
                                  PreviewKeyDown="NotesTree_PreviewKeyDown"
                                  PreviewMouseRightButtonDown="NotesTree_PreviewMouseRightButtonDown"
                                  PreviewMouseMove="NotesTree_PreviewMouseMove"
                                  DragOver="NotesTree_DragOver"
                                  Drop="NotesTree_Drop"
                                  SelectedItemChanged="NotesTree_SelectedItemChanged">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename"
                                              Click="RenameTreeItem_Click" />
                                    <MenuItem Header="Delete"
                                              Click="DeleteTreeItem_Click" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type viewModels:NoteTreeNodeViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Header}" />
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}"
                                       BasedOn="{StaticResource NoteTreeViewItemStyle}">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="AllowDrop"
                                            Value="{Binding IsMarkdownFile}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3"
                            Margin="0,14,0,0">
                    <Button Content="+ Create Document"
                            Style="{StaticResource PrimarySidebarButtonStyle}"
                            Command="{Binding AddNoteCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              ClipToBounds="True">
            <views:EditorView x:Name="EditorViewControl" />

            <ContentControl x:Name="OverlayHost"
                            Panel.ZIndex="10" />
        </Grid>
    </Grid>
</Window>
