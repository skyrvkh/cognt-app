<Window x:Class="CogntApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CogntApp"
        mc:Ignorable="d"
        Title="Cognt App" Height="560" Width="960" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F7F9FC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D7DEE8"
                BorderThickness="0,0,1,0"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,18">
                    <TextBlock Text="Notes Directory"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="NotesDirectoryTextBox"
                             Height="32"
                             Margin="0,0,0,8"
                             Padding="8,4"
                             VerticalContentAlignment="Center" />
                    <Button Content="Load Directory"
                            Height="36"
                            Margin="0,0,0,14"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"
                            Click="LoadDirectoryButton_Click" />
                    <Button Content="Review"
                            Height="36"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"
                            Click="ReviewButton_Click" />
                    <Button Content="Decks"
                            Height="36"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"
                            Click="DecksButton_Click" />
                </StackPanel>

                <TreeView Grid.Row="1"
                          BorderThickness="0"
                          Background="Transparent"
                          FontSize="14"
                          Foreground="#1F2937"
                          SelectedItemChanged="NotesTree_SelectedItemChanged">
                    <TreeViewItem x:Name="NotesRoot"
                                  Header="Notes"
                                  IsExpanded="True" />
                </TreeView>

                <StackPanel Grid.Row="2"
                            Margin="0,18,0,0">
                    <Button Content="Save Note"
                            Height="36"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"
                            Click="SaveNoteButton_Click" />
                    <Button Content="Add Note"
                            Height="36"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"
                            Click="AddNoteButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="ViewHost"
                        Grid.Column="1" />
    </Grid>
</Window>
