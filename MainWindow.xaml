<Window x:Class="CogntApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CogntApp"
        mc:Ignorable="d"
        Title="Cognt App" Height="450" Width="800" MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F7F9FC">
        <Border Width="420"
                Padding="32"
                Background="White"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Cognt App"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
